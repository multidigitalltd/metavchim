# ===== API =====
NODE_ENV=development
API_PORT=3001
# Origin המדויק של אפליקציית הווב — CORS נעול לרשימה זו בלבד
WEB_ORIGIN=http://localhost:3000

# ===== Web =====
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===== Database (PostgreSQL 16) =====
# האפליקציה מתחברת עם תפקיד מוגבל (RLS חל עליו); מיגרציות עם תפקיד הבעלים.
DATABASE_URL=postgresql://metavchim_app:metavchim_app_dev@localhost:5432/metavchim?schema=public
DIRECT_DATABASE_URL=postgresql://metavchim:metavchim@localhost:5432/metavchim?schema=public

# ===== Redis (Cache + BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== הצפנה (ערכי פיתוח בלבד — בפרודקשן מ-Secret Manager!) =====
# יצירת מפתח: openssl rand -base64 32
DATA_ENCRYPTION_KEY=3H0jc1x4qU5cZ8DhGCr9m2K7vTfWpLnQyBsE6uAdXjM=
PHONE_HASH_KEY=dev-only-phone-hash-key-change-in-production
COOKIE_SECURE=false

# ===== Object Storage (S3-compatible; MinIO מקומית) =====
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=metavchim
S3_ACCESS_KEY=metavchim
S3_SECRET_KEY=metavchim-secret

# ===== WhatsApp Cloud API (אופציונלי — ה-Webhook סגור עד שמוגדר) =====
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# סודות אמיתיים לעולם לא נכנסים לקובץ הזה — רק ל-Secret Manager / ‎.env מקומי שלא בגיט
