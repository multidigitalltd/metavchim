# ===== API =====
NODE_ENV=development
API_PORT=3001
# Origin המדויק של אפליקציית הווב — CORS נעול לרשימה זו בלבד
WEB_ORIGIN=http://localhost:3000

# ===== Database (PostgreSQL 16) =====
DATABASE_URL=postgresql://metavchim:metavchim@localhost:5432/metavchim?schema=public

# ===== Redis (Cache + BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== Object Storage (S3-compatible; MinIO מקומית) =====
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=metavchim
S3_ACCESS_KEY=metavchim
S3_SECRET_KEY=metavchim-secret

# סודות אמיתיים לעולם לא נכנסים לקובץ הזה — רק ל-Secret Manager / ‎.env מקומי שלא בגיט
