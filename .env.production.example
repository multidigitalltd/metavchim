# ============================================================
# תבנית סביבת הפרודקשן — העתיקו ל-.env.production על השרת ומלאו.
# הקובץ משמש גם את compose (אינטרפולציה) וגם את הקונטיינרים (env_file).
# סודות: openssl rand -base64 32   (או rand -hex 24 לסודות טקסטואליים)
# ============================================================

NODE_ENV=production

# יכולות רשות שאינן עולות כברירת מחדל. ריק = רק הליבה.
# הערכים האפשריים: stt (תמלול מקומי), diarize (זיהוי דוברים),
# offsite (גיבוי חיצוני). מפרידים בפסיק — למשל: stt,diarize,offsite
#
# שער ה-HTTPS (Caddy) אינו פרופיל: הוא רץ תמיד. המערכת היא ענן
# בהתקנה אחת, ואין תרחיש של שרת Web אחר שכבר תופס 80/443.
COMPOSE_PROFILES=

# הדומיין של המערכת (בלי https://)
DOMAIN=app.metavchim.co.il

# ===== API =====
API_PORT=3001
WEB_ORIGIN=https://app.metavchim.co.il
COOKIE_SECURE=true
# Caddy הוא שכבת ה-Proxy היחידה לפני ה-API
TRUST_PROXY_HOPS=1

# ===== Database =====
# סיסמת הבעלים (מיגרציות) — compose יוצר איתה את הקלאסטר בעלייה הראשונה
DB_OWNER_PASSWORD=
# סיסמת תפקיד האפליקציה (RLS) — נוצר אוטומטית בעליית ה-DB הראשונה
APP_DB_PASSWORD=
# בכתובות למטה מדביקים את אותן סיסמאות במפורש (compose לא מרחיב ערכים מקוננים)
DATABASE_URL=postgresql://metavchim_app:APP_DB_PASSWORD_HERE@postgres:5432/metavchim?schema=public
DIRECT_DATABASE_URL=postgresql://metavchim:DB_OWNER_PASSWORD_HERE@postgres:5432/metavchim?schema=public

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== הצפנה =====
DATA_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# ===== איזו תמונה נפרסת =====
# ברירת המחדל היא המאגר שלנו ו-latest. קיבוע ל-SHA כשרוצים לפרוס
# גרסה מסוימת — ולוודא שה-compose והמיגרציות מאותה גרסה בדיוק.
IMAGE_PREFIX=ghcr.io/multidigitalltd/metavchim
IMAGE_TAG=latest

# ===== Object Storage (MinIO פנימי) =====
S3_ENDPOINT=http://minio:9000
S3_BUCKET=metavchim
S3_ACCESS_KEY=metavchim
S3_SECRET_KEY=

# ===== עדכון בלחיצת כפתור =====
# הסוד המשותף בין ה-API לסוכן העדכון — לפחות 24 תווים
UPDATE_SECRET=

# ===== גיבויים =====
# תיקיית הגיבויים במארח (pg_dump יומי + ארכיון תמונות שבועי).
# מסך /platform מציג את מצב הגיבויים ומאפשר מחיקה ושחזור בלחיצה.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# BACKUP_MEDIA_KEEP_DAYS=30
# כל כמה ימים נסרק כל אחסון המדיה מחדש (בין לבין — רק מה שהשתנה)
# BACKUP_MEDIA_FULL_DAYS=7
# מרווח ביטחון על הדיסק לפני ארכיון המדיה, במגה-בייט. מתחתיו
# הארכיון מדולג עם שגיאה ביומן — דיסק מלא מפיל את המערכת כולה.
# BACKUP_MIN_FREE_MB=2048

# ===== עותק גיבוי מחוץ לשרת (מומלץ מאוד!) =====
# סנכרון אוטומטי של הגיבויים לאחסון ענן תואם-S3 כל 6 שעות.
# בלעדיו הגיבוי יושב על אותה מכונה כמו המערכת — ותקלת דיסק אחת
# מוחקת את שניהם.
#
# הפעלה: 1) הוסיפו offsite ל-COMPOSE_PROFILES
#         2) מלאו את הפרטים מספק האחסון — ראו docs/10-deployment.md
#
# Cloudflare R2 (ברירת המחדל; ה-endpoint כולל את מזהה החשבון):
# OFFSITE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# OFFSITE_S3_BUCKET=metavchim-backups
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=
#
# ספק אחר (Backblaze B2 / AWS S3 / Wasabi) — דורסים גם את אלה:
# OFFSITE_S3_PROVIDER=Other
# OFFSITE_S3_REGION=eu-central-003

# ===== אימייל (Postmark) =====
# נדרש לאיפוס סיסמה ולאימות כניסה בקוד. הטוקן: Postmark ⟵ Servers ⟵
# השרת שלכם ⟵ API Tokens. כתובת השולח חייבת להיות Sender Signature
# מאומתת (או דומיין מאומת) ב-Postmark.
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=no-reply@metavchim.co.il
# טוקן ה-Account (Postmark ⟵ Account ⟵ API Tokens) — מפעיל למשרדים
# חיבור דומיין משלהם לשליחה. נפרד מטוקן השרת; אופציונלי.
# POSTMARK_ACCOUNT_TOKEN=

# ===== תמלול מקומי בשרת (פרטיות מלאה) =====
# שירות faster-whisper שרץ לצד המערכת: ההקלטות מתומללות על השרת
# שלכם, נמחקות מיד, ולא נשלחות לשום ספק חיצוני.
# הפעלה: 1) הוסיפו stt ל-COMPOSE_PROFILES
#         2) צרו סוד: openssl rand -hex 24
#         3) docker compose ... up -d --build stt   (משיכת המודל ~1.5GB)
# דורש ~2GB RAM פנויים. ראו docs/10-deployment.md §תמלול מקומי.
# STT_URL=http://stt:9000
# STT_SECRET=
# STT_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
# STT_THREADS=2
# STT_MEMORY_LIMIT=3g

# ===== נתיב הריפו על השרת =====
# הסוכן שמאחורי כפתור "עדכן גרסה" מריץ docker compose מול ה-Docker של
# המארח, ולכן נתיבים יחסיים נפתרים מול המארח ולא מול הקונטיינר.
# הערך חייב להיות הנתיב המוחלט שבו הריפו יושב בפועל.
REPO_DIR=/srv/metavchim

# ===== זיהוי דוברים בשיחות טלפון =====
# מוסיף לתמלול של שיחה מוקלטת תווית "מי אמר מה" (דובר 1 / דובר 2).
# תוספת לתמלול, לא תחליף — דורש שפרופיל stt כבר פעיל.
# חל רק על הקלטות שיחה; הכתבה לשדה לא נוגעת בשירות הזה.
# הפעלה: 1) הוסיפו diarize ל-COMPOSE_PROFILES (לצד stt)
#         2) צרו טוקן קריאה ב-huggingface.co/settings/tokens
#         3) אשרו את התנאים של שני המודלים (חינם, דורש חשבון):
#            huggingface.co/pyannote/speaker-diarization-3.1
#            huggingface.co/pyannote/segmentation-3.0
#         4) docker compose ... up -d --build diarize
# דורש ~3GB RAM פנויים נוספים. ראו docs/10-deployment.md §זיהוי דוברים.
# DIARIZE_URL=http://diarize:9001
# HF_TOKEN=
# DIARIZE_MAX_SPEAKERS=4
# DIARIZE_THREADS=2
# DIARIZE_MEMORY_LIMIT=4g

# ===== אימות דו-שלבי בקוד אימייל =====
# קוד חד-פעמי בכל כניסה. נכנס לתוקף רק אם Postmark מוגדר למעלה
# (הגנת נעילה — דגל דלוק בלי ספק אימייל מדולג אוטומטית).
# LOGIN_OTP_ENABLED=false

# ===== התחברות עם Google (אופציונלי) =====
# עדיף להגדיר מהמסך /platform ⟵ "חיבורי המערכת" (נשמר מוצפן).
# כאן רק כ-Fallback לסביבות שמנוהלות מהשרת.
# Google Cloud Console ⟵ APIs & Services ⟵ Credentials ⟵ OAuth client ID
# (Web application). כתובת החזרה לרישום:
#   https://<DOMAIN>/api/v1/auth/google/callback
# חשוב: הכניסה פותחת חשבונות קיימים בלבד — אין הרשמה עצמית.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ===== סליקה — קארדקום (אופציונלי) =====
# עדיף להגדיר מהמסך /platform ⟵ "חיבורי המערכת" (נשמר מוצפן).
# מאזור הניהול של קארדקום ⟵ הגדרות ⟵ משתמשי API.
# כתובת ה-Webhook לרישום שם:
#   https://<DOMAIN>/api/v1/webhooks/cardcom
# שלושתם יחד או אף אחד: בלעדיהם הסליקה כבויה ומסך המנוי מציג
# "התשלום המקוון טרם הופעל" במקום כפתור רכישה שנופל.
# פרטי כרטיס האשראי מוקלדים בדף של קארדקום ואינם עוברים במערכת.
# CARDCOM_TERMINAL_NUMBER=
# CARDCOM_API_NAME=
# CARDCOM_API_PASSWORD=

# ===== ניהול הפלטפורמה =====
# אימיילים (מופרדים בפסיק) שמורשים להקים משרדי תיווך חדשים מהמסך
# /platform — בדרך כלל רק אתם, בעלי הפלטפורמה. ריק = המסך כבוי.
# PLATFORM_ADMIN_EMAILS=you@example.com

# ===== WhatsApp Cloud API (אופציונלי) =====
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# ===== תמונות =====
# ברירת המחדל מושכת מ-GHCR של הריפו; אין צורך לשנות בדרך כלל
# IMAGE_PREFIX=ghcr.io/multidigitalltd/metavchim
# IMAGE_TAG=latest
