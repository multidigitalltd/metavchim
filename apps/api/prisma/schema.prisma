// מודל הנתונים — docs/03-data-model.md
//
// עקרונות:
// - tenant_id בכל טבלה עסקית; תמיד העמודה הראשונה באינדקסים מורכבים.
// - מזהים: ULID, נוצרים בשכבת האפליקציה (אין default ב-DB).
// - PII (טלפון/אימייל/שם לקוח קצה) מוצפן ברמת האפליקציה; phone_hash לחיפוש.
// - RLS מופעל על כל הטבלאות — ראו prisma/sql/enable_rls.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // הרצה שוטפת: תפקיד האפליקציה המוגבל (RLS חל עליו)
  url       = env("DATABASE_URL")
  // מיגרציות: תפקיד הבעלים — הפרדת הרשאות (docs/04 §2)
  directUrl = env("DIRECT_DATABASE_URL")
}

model Tenant {
  id        String   @id @db.Char(26)
  name      String   @db.VarChar(120)
  plan      String   @default("basic") @db.VarChar(20)
  status    String   @default("trial") @db.VarChar(20)
  /// סוף תקופת הניסיון. null = אין תפוגה — משרד שהוקם ידנית או ששילם.
  /// עמודה ולא שדה ב-settings: היא נבדקת בכל אימות Session.
  trialEndsAt DateTime? @map("trial_ends_at")
  /// עד מתי שולם. null = אין תפוגה (משרד שהוקם ידנית).
  ///
  /// יושבת כאן ולא רק ב-subscriptions **בכוונה**: זהו שער ההרשאה,
  /// והוא נבדק בכל אימות Session יחד עם trial_ends_at. תפוגה שנשענת
  /// על סורק שירוץ אי-פעם הייתה נותנת גישה חינם לכל מי ששילם פעם
  /// אחת, בדיוק כפי שקרה קודם עם הניסיון (ביקורת Codex).
  paidUntil   DateTime? @map("paid_until")
  /// self | manual — מאיזה ערוץ המשרד הגיע. לדוח ולתמיכה, לא להרשאות.
  signupSource String  @default("manual") @map("signup_source") @db.VarChar(20)
  /// הקופון שמומש בהרשמה — לתמיכה ולדוח.
  couponCode   String? @map("coupon_code") @db.VarChar(40)
  /// ההנחה שעוד לא נוצלה, כפי שהובטחה ברגע המימוש. נמחקת בתשלום
  /// הראשון שמצליח. העתק ולא קריאה מהקופון: עריכה או כיבוי שלו
  /// אינם אמורים לשנות למפרע את מה שכבר הובטח.
  couponPercentOff Int? @map("coupon_percent_off")
  /// המסלול שהקופון הוגבל אליו ברגע המימוש — ההנחה חלה רק עליו.
  couponPlanCode String? @map("coupon_plan_code") @db.VarChar(20)
  /// מודולים שהפלטפורמה חסמה למשרד הזה (מפתחות מ-CAPABILITY_MODULES).
  ///
  /// שכבה שלישית מעל התפקיד ומעל חריגי המשתמש, ובכיוון אחד: חוסמת
  /// ולעולם לא מעניקה. מוחלת בפענוח ה-Session **אחרי** חריגי המנהל,
  /// כדי שבעל המשרד לא יוכל להסיר אותה ממסך ההרשאות שלו.
  blockedModules String[] @default([]) @map("blocked_modules")
  /// עד מתי פתוח חלון גישת התמיכה שהמשרד העניק. null = סגור.
  /// נפתח רק בלחיצת בעל המשרד, לעולם לא מהפלטפורמה.
  supportAccessUntil DateTime? @map("support_access_until")
  supportAccessGrantedBy String? @map("support_access_granted_by") @db.Char(26)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  properties Property[]

  @@index([trialEndsAt])
  @@index([paidUntil])
  @@map("tenants")
}

// הערת RLS: users ו-sessions הן תשתית אימות — החיפוש בהן קורה לפני שקיים
// הקשר דייר (בזמן Login), ולכן הן מחוץ לפוליסת ה-RLS. הן לא מכילות PII של
// לקוחות קצה; הסינון לפי דייר נאכף בשכבת האפליקציה.
model User {
  id           String    @id @db.Char(26)
  tenantId     String    @map("tenant_id") @db.Char(26)
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  role         String    @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  totpSecret   String?   @map("totp_secret") @db.VarChar(255)
  // סיסמה זמנית שחובה להחליף בכניסה ראשונה (ביקורת Codex, PR #5)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  /** חותמת שינוי הסיסמה האחרון — Sessions ישנים ממנה נפסלים (docs/04) */
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  lastLoginAt  DateTime? @map("last_login_at")
  // מסך "מה חדש": העדכון האחרון שנצפה — הבאנר מוצג רק על חדשות מזה והלאה
  lastSeenAnnouncement String? @map("last_seen_announcement") @db.VarChar(60)
  /// העדפות אישיות (נגישות ותצוגה) — נוסעות עם המשתמש בין מכשירים
  preferences  Json     @default("{}")
  /// קו ה-SIP האישי לסופטפון בדפדפן. של האדם ולא של המשרד: שיחה
  /// נכנסת צריכה לצלצל אצל מי שהיא מיועדת לו.
  sipUsername  String?  @map("sip_username") @db.VarChar(80)
  sipPasswordEncrypted String? @map("sip_password_encrypted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  sessions Session[]
  capabilityOverrides UserCapability[]

  @@index([tenantId, isActive])
  @@map("users")
}

/// חריג הרשאה למשתמש בודד — מעל מה שהתפקיד נותן (docs/04 §3).
/// הפירוט וההנמקה: packages/shared/src/logic/capability-overrides.ts
model UserCapability {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  userId     String    @map("user_id") @db.Char(26)
  capability String    @db.VarChar(40)
  /// "grant" = הוספה מעבר לתפקיד, "deny" = חסימה
  effect     String    @db.VarChar(10)
  /// null = לצמיתות. התפוגה נאכפת בקריאה, לא בעבודת ניקוי.
  expiresAt  DateTime? @map("expires_at")
  reason     String?   @db.VarChar(200)
  createdBy  String?   @map("created_by") @db.Char(26)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([tenantId, userId])
  @@map("user_capabilities")
}

/// חיבור של המשרד לשירות חיצוני (מרכזייה וכו').
/// ההנמקה והחלטות הזיהוי: packages/shared/src/logic/telephony.ts
model Integration {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  /// telephony
  kind      String   @db.VarChar(30)
  provider  String   @db.VarChar(30)
  /// active | disabled
  status    String   @default("active") @db.VarChar(20)
  /// הגדרות שאינן סוד — מוצגות במסך
  config    Json     @default("{}")
  /// אישורי הספק, מוצפנים; לעולם לא מוחזרים ללקוח
  secretsEncrypted String? @map("secrets_encrypted")
  /// מזהה המשרד בכתובת ה-Webhook הציבורית
  webhookKey String  @unique @map("webhook_key") @db.VarChar(64)
  lastEventAt DateTime? @map("last_event_at")
  /// שמות השדות באירוע האחרון — **בלי הערכים**.
  ///
  /// מספיק כדי למפות ספק שמשתמש בשמות אחרים, ואינו מכניס מספרי
  /// טלפון של לקוחות לעמודה שנקראת בטקסט גלוי.
  lastEventKeys String? @map("last_event_keys") @db.VarChar(400)
  /// האם ידענו לפרש את האירוע האחרון. `false` = הגיע ולא הובן,
  /// וזה מצב שונה לגמרי מ"לא הגיע כלום".
  lastEventOk Boolean? @map("last_event_ok")
  /// no_call_id | no_phone | invalid_phone — **למה** לא נקלט.
  /// מספר חסוי הוא מצב נורמלי ולא תקלת מיפוי, וההבחנה היא ההבדל
  /// בין הודעה שמכוונת נכון להודעה ששולחת לחפש בעיה שאינה קיימת.
  lastEventIssue String? @map("last_event_issue") @db.VarChar(40)
  createdBy String?  @map("created_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@map("integrations")
}

model Session {
  id        String   @id @db.Char(26)
  userId    String   @map("user_id") @db.Char(26)
  // בעוגייה נשמר טוקן אקראי; כאן רק ה-SHA-256 שלו — גניבת DB לא מספיקה לחטיפת Session.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  /** חותמת שינוי-הסיסמה שכנגדה אומת ה-Session; ישנה ⇒ נפסל (docs/04) */
  passwordEpoch DateTime? @map("password_epoch")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  /// לא null = Session של תמיכה: חי רק בתוך חלון ההסכמה של המשרד,
  /// והביטול הורג אותו בבקשה הבאה. הערך הוא מי מהתמיכה נכנס.
  supportAdminEmail String? @map("support_admin_email") @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// אדם אמיתי אחד — קונה/מוכר/ליד מפנים לכאן; אין כפילויות אדם (docs/03 §3).
model Contact {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  // PII מוצפן (AES-GCM בשכבת האפליקציה) — לא נשמר בטקסט גלוי.
  nameEncrypted  String   @map("name_encrypted") @db.Text
  phoneEncrypted String   @map("phone_encrypted") @db.Text
  emailEncrypted String?  @map("email_encrypted") @db.Text
  // HMAC של הטלפון המנורמל — חיפוש ודה-דופליקציה בלי פענוח.
  phoneHash      String   @map("phone_hash") @db.Char(64)
  /** HMAC של השם המנורמל — איתור כפילויות בלי לפענח. NULL עד ההשלמה. */
  nameHash       String?  @map("name_hash") @db.Char(64)
  /// חתימת האימייל (HMAC) — התאמת שולח נכנס מ-Gmail לכרטיס קיים.
  emailHash      String?  @map("email_hash") @db.Char(64)
  optedOutAt     DateTime? @map("opted_out_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  phones       ContactPhone[]
  links        ContactLink[]  @relation("primaryContact")
  linkedFrom   ContactLink[]  @relation("relatedContact")

  @@unique([tenantId, phoneHash])
  @@map("contacts")
}

/**
 * טלפון נוסף לאותו אדם. הטלפון הראשי נשאר על `contacts` — כאן רק
 * המספרים הנוספים, עם אותו HMAC, כך שחיפוש נכנס מוצא את האדם דרך
 * כל אחד ממספריו באותו מנגנון בדיוק.
 */
model ContactPhone {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  contactId      String   @map("contact_id") @db.Char(26)
  phoneEncrypted String   @map("phone_encrypted") @db.Text
  phoneHash      String   @map("phone_hash") @db.Char(64)
  /** mobile | home | work | other */
  label          String   @default("mobile") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneHash])
  @@index([tenantId, contactId])
  @@map("contact_phones")
}

/**
 * אדם נוסף על אותו כרטיס — בן/בת זוג, מיופה כוח, בן שמטפל בהורים.
 * הכרטיס ממשיך להצביע על איש קשר ראשי אחד; אלה תלויים בו.
 */
model ContactLink {
  id               String   @id @db.Char(26)
  tenantId         String   @map("tenant_id") @db.Char(26)
  contactId        String   @map("contact_id") @db.Char(26)
  relatedContactId String   @map("related_contact_id") @db.Char(26)
  /** spouse | partner | parent | child | attorney | other */
  role             String   @default("other") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  contact Contact @relation("primaryContact", fields: [contactId], references: [id], onDelete: Cascade)
  related Contact @relation("relatedContact", fields: [relatedContactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, relatedContactId])
  @@index([tenantId, relatedContactId])
  @@map("contact_links")
}

model Property {
  id                   String    @id @db.Char(26)
  tenantId             String    @map("tenant_id") @db.Char(26)
  status               String    @default("draft") @db.VarChar(20)
  city                 String?   @db.VarChar(80)
  neighborhood         String?   @db.VarChar(80)
  street               String?   @db.VarChar(120)
  houseNumber          String?   @map("house_number") @db.VarChar(10)
  propertyType         String?   @map("property_type") @db.VarChar(30)
  dealType             String?   @map("deal_type") @db.VarChar(10)
  rooms                Decimal?  @db.Decimal(4, 1)
  areaSqm              Int?      @map("area_sqm")
  floor                Int?
  totalFloors          Int?      @map("total_floors")
  hasElevator          Boolean?  @map("has_elevator")
  hasParking           Boolean?  @map("has_parking")
  hasBalcony           Boolean?  @map("has_balcony")
  hasSafeRoom          Boolean?  @map("has_safe_room")
  hasStorage           Boolean?  @map("has_storage")
  condition            String?   @db.VarChar(20)
  priceAgorot          BigInt?   @map("price_agorot")
  priceFlexible        Boolean?  @map("price_flexible")
  entryDate            DateTime? @map("entry_date") @db.Date
  exclusive            Boolean?
  exclusiveUntil       DateTime? @map("exclusive_until") @db.Date
  ownerContactId       String?   @map("owner_contact_id") @db.Char(26)
  /// מיקום הנכס — **תמיד WGS84**, גם כשהמקור עבד ברשת ישראל.
  ///
  /// פורמט אחד בכל המערכת, המרה בקצה: החלפת ספק פענוח אינה אמורה
  /// לגרור המרת מסד. `null` = הנכס עוד לא מוקם, וההתאמה נופלת
  /// להשוואת עיר כמו קודם.
  latitude             Float?
  longitude            Float?
  /// pin = הסוכן סימן ידנית · geocode = נגזר מהכתובת.
  /// ההבחנה חשובה ליום שבו נרצה לרענן מיקומים אוטומטיים בלי לדרוס
  /// סימון שאדם עשה במתכוון.
  locationSource       String?   @map("location_source") @db.VarChar(10)
  marketingTitle       String?   @map("marketing_title") @db.VarChar(160)
  marketingDescription String?   @map("marketing_description")
  internalNotes        String?   @map("internal_notes")
  attributes           Json      @default("{}")
  readinessScore       Int       @default(0) @map("readiness_score")
  // דף הנחיתה הציבורי של הנכס — הטוקן הוא ההרשאה (פוליסת RLS ייעודית)
  landingToken         String?   @unique @map("landing_token") @db.Char(43)
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  media  PropertyMedia[]

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, city, status])
  @@map("properties")
}

model PropertyMedia {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  propertyId String   @map("property_id") @db.Char(26)
  kind       String   @db.VarChar(20) // image | document | floorplan
  s3Key      String   @map("s3_key") @db.VarChar(512)
  altText    String?  @map("alt_text") @db.VarChar(300)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId, propertyId, sortOrder])
  @@map("property_media")
}

model Buyer {
  id                 String    @id @db.Char(26)
  tenantId           String    @map("tenant_id") @db.Char(26)
  contactId          String    @map("contact_id") @db.Char(26)
  // הסוכן שמטפל בקונה — הבסיס לאכיפת buyers.view_own (ביקורת Codex, PR #1)
  ownerUserId        String?   @map("owner_user_id") @db.Char(26)
  // דרישות מובנות (BuyerRequirements בסכמת Zod) — עמודות חמות + JSONB.
  cities             String[]
  dealType           String    @map("deal_type") @db.VarChar(10)
  budgetMinAgorot    BigInt?   @map("budget_min_agorot")
  budgetMaxAgorot    BigInt    @map("budget_max_agorot")
  roomsMin           Decimal?  @map("rooms_min") @db.Decimal(4, 1)
  roomsMax           Decimal?  @map("rooms_max") @db.Decimal(4, 1)
  requirements       Json      @default("{}")
  financing          String    @default("unknown") @db.VarChar(20)
  maturity           String    @default("interested") @db.VarChar(20)
  maturityOverridden Boolean   @default(false) @map("maturity_overridden")
  source             String    @db.VarChar(60)
  aiNotes            String?   @map("ai_notes")
  agentNotes         String?   @map("agent_notes")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, maturity, updatedAt])
  @@index([tenantId, dealType, budgetMaxAgorot])
  @@index([tenantId, ownerUserId])
  @@map("buyers")
}

// ציר הזמן של ליד: הערות, שיחות, הודעות, שינויי סטטוס (docs/03 §3).
// אינטראקציה על ליד או על קונה — בדיוק אחד מהם מוגדר (CHECK במיגרציה).
model Interaction {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  leadId    String?  @map("lead_id") @db.Char(26)
  buyerId   String?  @map("buyer_id") @db.Char(26)
  kind      String   @db.VarChar(20) // note | call | whatsapp | status_change | system
  direction String?  @db.VarChar(10) // in | out
  content   String
  createdBy String?  @map("created_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, buyerId, createdAt])
  @@map("interactions")
}

// קליטת נכס בקול: התמלול, השדות שחולצו והחוסרים — נשמר לשחזור ותיקון.
model VoiceIntake {
  id              String   @id @db.Char(26)
  tenantId        String   @map("tenant_id") @db.Char(26)
  transcript      String
  extractedFields Json     @default("{}") @map("extracted_fields")
  missingFields   String[] @map("missing_fields")
  propertyId      String?  @map("property_id") @db.Char(26)
  createdBy       String?  @map("created_by") @db.Char(26)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("voice_intakes")
}

model Lead {
  id                  String    @id @db.Char(26)
  tenantId            String    @map("tenant_id") @db.Char(26)
  contactId           String    @map("contact_id") @db.Char(26)
  source              String    @db.VarChar(20)
  intent              String    @default("unknown") @db.VarChar(20)
  status              String    @default("new") @db.VarChar(20)
  assignedToUserId    String?   @map("assigned_to_user_id") @db.Char(26)
  requiresHuman       Boolean   @default(false) @map("requires_human")
  requiresHumanReason String?   @map("requires_human_reason") @db.VarChar(500)
  propertyId          String?   @map("property_id") @db.Char(26)
  summary             String?
  firstResponseAt     DateTime? @map("first_response_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, assignedToUserId, status, createdAt])
  @@index([tenantId, status, requiresHuman])
  @@map("leads")
}

/// חיבור Gmail — אימיילים נכנסים הופכים ללידים או מצטרפים לכרטיס
/// קיים. מבנה זהה ל-GoogleCalendarLink: חיבור אישי (userId ייחודי),
/// refresh token מוצפן, ושגיאת הסבב האחרון מוצגת למשתמש.
model GmailLink {
  id                    String    @id @db.Char(26)
  tenantId              String    @map("tenant_id") @db.Char(26)
  userId                String    @unique @map("user_id") @db.Char(26)
  googleEmail           String    @map("google_email") @db.VarChar(254)
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  /// סמן ההתקדמות: internalDate (מילישניות) של ההודעה האחרונה שעובדה.
  lastInternalMs        BigInt    @default(0) @map("last_internal_ms")
  lastSyncAt            DateTime? @map("last_sync_at")
  lastError             String?   @map("last_error") @db.VarChar(300)
  /// אימיילים שדולגו כי לא זוהה בהם שולח מוכר או טלפון — שקיפות במסך.
  skippedCount          Int       @default(0) @map("skipped_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("gmail_links")
}

/// דחיית הצעת מיזוג כרטיסים: "אלה לא אותו אדם". נשמרת לפי חתימת
/// השם של הקבוצה (name_hash) יחד עם גודל הקבוצה בזמן הדחייה —
/// כרטיס נוסף שנוצר אחר-כך עם אותו שם מגדיל את הקבוצה ומחזיר את
/// ההצעה, כי זו כבר שאלה חדשה.
model DuplicateDismissal {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  nameHash     String   @map("name_hash") @db.Char(64)
  contactCount Int      @map("contact_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, nameHash])
  @@map("duplicate_dismissals")
}

/// מפתחות קליטת לידים מהאתר — כמה לכל משרד, עם שם מקור לכל מפתח
/// ("אתר", "פייסבוק"...). מחוץ ל-RLS בכוונה: הנתיב הציבורי
/// ‎/public/leads/:key מזהה את המשרד *לפי* המפתח, לפני שיש הקשר
/// דייר — אותו דגם כמו subscriptions מול ה-webhook של קארדקום.
model LeadWebhook {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  key         String   @unique @db.VarChar(64)
  /// נכנס כ-source של הליד — ולכן מוגבל לאורך העמודה שם (20)
  sourceLabel String   @map("source_label") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("lead_webhooks")
}

model Match {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  propertyId  String   @map("property_id") @db.Char(26)
  buyerId     String   @map("buyer_id") @db.Char(26)
  score       Int
  breakdown   Json
  explanation String   @db.VarChar(1000)
  status      String   @default("suggested") @db.VarChar(20)
  computedAt  DateTime @map("computed_at")

  @@unique([tenantId, propertyId, buyerId])
  @@index([tenantId, propertyId, score(sort: Desc)])
  @@index([tenantId, buyerId, score(sort: Desc)])
  @@map("matches")
}

model Offer {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  // הצעה אחת פר התאמה — מונע כפילויות במרוץ בין בקשות (ביקורת Codex, PR #3)
  matchId       String    @unique @map("match_id") @db.Char(26)
  channel       String    @db.VarChar(20)
  sentText      String?   @map("sent_text") @db.VarChar(2000)
  // Snapshot תצוגת הנכס לקונה — בלי PII; הדף הציבורי קורא רק מכאן.
  presentation  Json      @default("{}")
  // טוקן דף ההצעה הציבורי — אקראי, חד-ערכי, עם תפוגה (docs/06 §6).
  publicToken   String    @unique @map("public_token") @db.Char(43)
  tokenExpires  DateTime  @map("token_expires")
  status        String    @default("pending_approval") @db.VarChar(20)
  openCount     Int       @default(0) @map("open_count")
  sentAt        DateTime? @map("sent_at")
  firstOpenedAt DateTime? @map("first_opened_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status, createdAt])
  @@map("offers")
}

// ביקוש אנונימי משותף ברשת (docs/04 §7): ללא PII, תקציב מעוגל, אזור
// ברמת עיר. הטבלה היחידה עם קריאת רשת חוצת-דיירים (RLS ייעודי).
// origin_buyer_id הוא ULID חסר-משמעות בלי גישה לטבלת buyers (מבודדת RLS).
model SharedDemand {
  id              String   @id @db.Char(26)
  tenantId        String   @map("tenant_id") @db.Char(26)
  originBuyerId   String?  @map("origin_buyer_id") @db.Char(26)
  source          String   @default("network") @db.VarChar(20) // network | kanko
  externalId      String?  @unique @map("external_id") @db.VarChar(120)
  cities          String[]
  /// שכונות מבוקשות — מועתקות מדרישות הקונה בשיתוף; אנונימיות כמו ערים
  neighborhoods   String[] @default([])
  dealType        String   @map("deal_type") @db.VarChar(10)
  // טווח מעוגל כלפי מעלה ל-100 אלף ₪ — אנונימיזציה אמיתית, לא הסתרה
  budgetMaxAgorot BigInt   @map("budget_max_agorot")
  roomsMin        Decimal? @map("rooms_min") @db.Decimal(4, 1)
  roomsMax        Decimal? @map("rooms_max") @db.Decimal(4, 1)
  mustFeatures    String[] @map("must_features")
  notes           String?  @db.VarChar(300)
  status          String   @default("active") @db.VarChar(20) // active | closed
  /// אחוז העמלה שהמשרד **המשתף** לוקח; לצד השני נשאר המשלים.
  /// נקבע ברגע השיתוף ולא בסופו — מו"מ אחרי שהקונה התעניין הוא
  /// המקום שבו שיתופי פעולה נשברים. מינימום 33% לכל צד.
  commissionSplit Int      @default(50) @map("commission_split") @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, dealType, budgetMaxAgorot])
  @@index([tenantId, status])
  @@map("shared_demands")
}

// הצעת נכס לביקוש רשת: גלויה לשתי הסוכנויות בלבד (RLS דו-צדדי).
// חשיפה מדורגת — אזור ומאפיינים בלבד; כתובת מלאה רק אחרי אישור חיבור.
model CoopOffer {
  id            String   @id @db.Char(26)
  demandId      String   @map("demand_id") @db.Char(26)
  fromTenantId  String   @map("from_tenant_id") @db.Char(26)
  toTenantId    String   @map("to_tenant_id") @db.Char(26)
  propertyId    String   @map("property_id") @db.Char(26)
  // Snapshot מדורג של הנכס — בלי כתובת מדויקת ובלי פרטי בעלים
  presentation  Json     @default("{}")
  status        String   @default("sent") @db.VarChar(20) // sent | interested | declined
  creditsCost   Int      @default(1) @map("credits_cost")
  /// אחוז העמלה שהמשרד **המציע** לוקח. נגזר מהביקוש כברירת מחדל,
  /// וניתן להצעה נגדית — החלוקה היא הצעה עד שהצד השני מסכים.
  commissionSplit Int    @default(50) @map("commission_split") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([demandId, propertyId])
  @@index([toTenantId, status, createdAt])
  @@index([fromTenantId, createdAt])
  @@map("coop_offers")
}

// הפניית לקוח בין משרדים: בלוח רק מידע אנונימי (כוונה, מקור, עיר,
// סיבה, הערה); פרטי הקשר הם צילום מוצפן שמועתק למשרד הקולט רק אחרי
// הקליטה. אותו דגם RLS כמו shared_demands — בעלות מלאה למשרד המפנה,
// קריאת רשת להפניות פעילות, וקריאה למשרד שקלט את ההפניה.
model SharedLead {
  id           String  @id @db.Char(26)
  tenantId     String  @map("tenant_id") @db.Char(26)
  originLeadId String  @map("origin_lead_id") @db.Char(26)
  source       String  @db.VarChar(20)
  intent       String  @db.VarChar(20)
  /// ללידים אין עמודת עיר — המשרד המפנה מזין ידנית כדי שהלוח יהיה שמיש
  city         String? @db.VarChar(120)
  note         String? @db.VarChar(300)
  /// למה הלקוח מופנה. חובה בפרסום; הפניות שקדמו לשדה נושאות
  /// unspecified ומוצגות ככאלה, ולא כאילו נבחרה סיבה.
  reason       String  @default("unspecified") @db.VarChar(30)
  /// פירוט חופשי לצד הסיבה — חובה כשהסיבה היא "אחר"
  reasonDetail String? @map("reason_detail") @db.VarChar(200)
  /// צילום איש הקשר במפתח ההצפנה האפליקטיבי (אחיד לכל הדיירים) —
  /// לכן המשרד הקולט מקבל עותק בלי פענוח ביניים. לעולם לא מוחזר בלוח.
  contactNameEncrypted  String @map("contact_name_encrypted") @db.Text
  contactPhoneEncrypted String @map("contact_phone_encrypted") @db.Text
  contactPhoneHash      String @map("contact_phone_hash") @db.Char(64)
  /// התמורה שהמשרד המפנה ביקש. נקבעת ברגע הפרסום ולא ברגע הקליטה —
  /// המשרד הקולט משלם את מה שראה בלוח.
  priceCredits  Int       @map("price_credits")
  /// עמלת הפלטפורמה בקרדיטים, מצולמת אף היא ברגע הפרסום: שינוי
  /// שיעור העמלה לא משנה הפניה שכבר פורסמה. הזיכוי למפנה הוא
  /// priceCredits פחות העמודה הזו (packages/shared/logic/lead-referral.ts).
  /// 0 בהפניות שקדמו לעמלה — היסטורית זה נכון.
  platformFeeCredits Int  @default(0) @map("platform_fee_credits")
  status        String    @default("active") @db.VarChar(20) // active | sold | withdrawn
  buyerTenantId String?   @map("buyer_tenant_id") @db.Char(26)
  soldAt        DateTime? @map("sold_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([buyerTenantId, soldAt])
  @@map("shared_leads")
}

// דירוג הדדי על הפניה שנקלטה. התמורה משולמת על ההפניה ולא על
// התוצאה, ואין החזרים — הדירוג הוא המנגנון שמייקר הפניית זבל.
// שורה אחת לכל צד: המשרד הקולט מדרג את מה שקיבל, והמשרד המפנה
// מדרג את הלקוח שהעביר. רק דירוגי הקולטים נספרים למוניטין.
model LeadReferralRating {
  id             String   @id @db.Char(26)
  sharedLeadId   String   @map("shared_lead_id") @db.Char(26)
  /// שני הצדדים נשמרים על השורה — הם המפתח של ה-RLS: דירוג נראה
  /// לשני הצדדים להפניה בלבד, לעולם לא לרשת.
  sellerTenantId String   @map("seller_tenant_id") @db.Char(26)
  buyerTenantId  String   @map("buyer_tenant_id") @db.Char(26)
  raterTenantId  String   @map("rater_tenant_id") @db.Char(26)
  raterRole      String   @map("rater_role") @db.VarChar(10) // referrer | receiver
  score          Int      @db.SmallInt
  comment        String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([sharedLeadId, raterTenantId])
  @@index([sellerTenantId, createdAt])
  @@map("lead_referral_ratings")
}

// מוניטין ההפניות של משרד — סכום ומונה בלבד.
// טבלה נפרדת ולא צבירה מעל lead_referral_ratings: הלוח מציג את
// הדירוג של כל משרד מפנה לכל הרשת, וטבלת הדירוגים מכילה הערות
// חופשיות שמשרד כתב על משרד. מספרים אפשר לחשוף לרשת; טקסט לא.
model ReferralReputation {
  tenantId    String   @id @map("tenant_id") @db.Char(26)
  /// כמה משרדים קולטים דירגו הפניות של המשרד הזה
  ratingCount Int      @default(0) @map("rating_count")
  ratingSum   Int      @default(0) @map("rating_sum")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("referral_reputation")
}

// ספר קרדיטים Append-Only (docs/03 §3): היתרה נגזרת, לא מאוחסנת.
model CreditLedger {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  kind      String   @db.VarChar(30) // initial_grant | coop_offer | purchase | refund | lead_purchase | lead_sale
  amount    Int // חיובי = זיכוי, שלילי = חיוב
  refId     String?  @map("ref_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

// כל הודעה יוצאת/נכנסת בכל ערוץ — הבסיס ל-Messaging Hub (docs/03 §3).
model Message {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  contactId         String?  @map("contact_id") @db.Char(26)
  offerId           String?  @map("offer_id") @db.Char(26)
  direction         String   @db.VarChar(5) // in | out
  channel           String   @db.VarChar(20) // whatsapp | sms | email
  provider          String   @db.VarChar(30) // walink | cloud_api | ...
  body              String   @db.VarChar(4000)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(120)
  status            String   @default("sent") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, offerId])
  @@map("messages")
}

// פגישה/סיור/שיחה ביומן (docs/01 §3 Calendar). google_event_id — לסנכרון עתידי.
model Appointment {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  kind          String    @db.VarChar(20) // viewing | meeting | call
  title         String?   @db.VarChar(200)
  leadId        String?   @map("lead_id") @db.Char(26)
  propertyId    String?   @map("property_id") @db.Char(26)
  buyerId       String?   @map("buyer_id") @db.Char(26)
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  status        String    @default("scheduled") @db.VarChar(20) // scheduled | completed | cancelled | no_show
  // תוצאת פולו-אפ אחרי סיור: liked | not_fit | negotiating | needs_other (אפיון §13)
  outcome       String?   @db.VarChar(20)
  notes         String?   @db.VarChar(2000)
  googleEventId String?   @map("google_event_id") @db.VarChar(120)
  googleSyncedAt DateTime? @map("google_synced_at")
  /// system = נקבעה כאן | google = נמשכה מהיומן.
  /// בלי ההבחנה הדחיפה החוצה הייתה מחזירה ל-Google אירוע שזה עתה
  /// הגיע ממנו — לולאה שבה כל צד "מעדכן" את השני לנצח.
  syncSource    String    @default("system") @map("sync_source") @db.VarChar(10)
  /// יומן של מי. `createdBy` הוא "מי הקליד" ואינו אותו דבר: פגישה
  /// שמנהל קובע לסוכן צריכה להופיע ביומן של הסוכן.
  ownerUserId   String?   @map("owner_user_id") @db.Char(26)
  /// המועד הקודם, כשהפגישה נדחתה. בלעדיו "נדחתה" אובד ברגע שהשדה
  /// נדרס — והמתווך אינו יודע שהפגישה כבר נדחתה פעמיים, שזה בדיוק
  /// הסימן שהעסקה מתקררת.
  rescheduledFrom DateTime? @map("rescheduled_from")
  rescheduleCount Int      @default(0) @map("reschedule_count") @db.SmallInt
  createdBy     String?   @map("created_by") @db.Char(26)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, googleEventId])
  @@map("appointments")
}

// משימות ותזכורות (docs/01 — מודול 7): רשימת ה"לעשות" האישית של הסוכן,
// עם תזכורת במועד היעד דרך צינור ההתראות הקיים.
model Task {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  /**
   * הסוכן האחראי. הוא רואה ומנהל אותה; מנהל עם `tasks.view_all`
   * רואה גם את של האחרים.
   */
  assignedToUserId String    @map("assigned_to_user_id") @db.Char(26)
  /**
   * מי הטיל. הפך למידע ברגע שאפשר להטיל על אחר — עד כה הוא היה
   * תמיד זהה ל-assignedToUserId, ולכן לא נשמר.
   */
  createdByUserId  String?   @map("created_by_user_id") @db.Char(26)
  /// low | normal | high
  priority         String    @default("normal") @db.VarChar(10)
  title            String    @db.VarChar(200)
  notes            String?   @db.VarChar(2000)
  dueAt            DateTime? @map("due_at")
  /* דחיפה ליומן Google — מקביל לשדות שעל appointments; null
     ב-googleSyncedAt פירושו "ממתין לדחיפה" (ראו CalendarSyncService). */
  googleEventId    String?   @map("google_event_id") @db.VarChar(255)
  googleSyncedAt   DateTime? @map("google_synced_at")
  /* מחיקה שממתינה לניקוי האירוע ב-Google — ראו TasksService.remove */
  deletedAfterSync Boolean   @default(false) @map("deleted_after_sync")
  status           String    @default("open") @db.VarChar(10) // open | done
  // קישור אופציונלי לישות — "להתקשר לקונה X", "להשלים פרטי נכס Y"
  entityType       String?   @map("entity_type") @db.VarChar(20) // lead | buyer | property
  entityId         String?   @map("entity_id") @db.Char(26)
  // מפתח אידמפוטנטיות למשימות מאירועים — מבחין בין מקורות (נכסים) שונים
  sourceKey        String?   @map("source_key") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, assignedToUserId, status, dueAt])
  @@index([tenantId, entityId, sourceKey])
  /// לוח המשרד: "מה פתוח, לפי מועד" בלי סינון לפי סוכן — האינדקס
  /// הראשון מתחיל ב-assignedToUserId ולכן אינו משמש אותו
  @@index([tenantId, status, dueAt])
  @@map("tasks")
}

/// כלל למשימה אוטומטית קבועה — ברמת המשרד.
///
/// הכלל שייך למשרד; המשימות שנוצרות ממנו שייכות לסוכן. `lastRunAt`
/// הוא המופע האחרון שנוצר בפועל, ו-null פירושו שהכלל טרם רץ — המופע
/// הראשון שלו נמדד מרגע היצירה ולא רטרואקטיבית.
model TaskRecurrence {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  title            String    @db.VarChar(200)
  notes            String?   @db.VarChar(2000)
  /// daily | weekly | monthly
  frequency        String    @db.VarChar(10)
  /// 0 (ראשון) עד 6; ריק = פעם בשבוע ביום שבו נוצר הכלל
  weekdays         Int[]     @db.SmallInt
  /// 31 נופל ליום האחרון בחודש קצר ולא מדלג על החודש
  dayOfMonth       Int?      @map("day_of_month") @db.SmallInt
  hour             Int       @default(9) @db.SmallInt
  minute           Int       @default(0) @db.SmallInt
  /// null = לכל סוכן פעיל במשרד, כל אחד מקבל משימה משלו
  assignedToUserId String?   @map("assigned_to_user_id") @db.Char(26)
  isActive         Boolean   @default(true) @map("is_active")
  lastRunAt        DateTime? @map("last_run_at")
  createdBy        String?   @map("created_by") @db.Char(26)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, lastRunAt])
  @@index([tenantId])
  @@map("task_recurrences")
}

// התראה למתווך: נוצרת ע"י ה-Worker מאירועי דומיין (docs/02 §4 Notifications).
model Notification {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  /** נמען ספציפי (התראות אישיות, כמו תזכורת משימה); NULL = כל המשרד. */
  userId     String?   @map("user_id") @db.Char(26)
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String?   @db.VarChar(500)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.Char(26)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /** מתי נדחפה כהתראת דפדפן; NULL = טרם נשלחה (הסורק מחפש בדיוק את אלה). */
  pushedAt   DateTime? @map("pushed_at")

  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}

/**
 * מנוי לפוש בדפדפן — צמד (משתמש, דפדפן). אותו סוכן במחשב ובנייד
 * מייצר שתי שורות בכוונה: הוא רוצה את ההתראה בשניהם.
 */
model PushSubscription {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  userId        String    @map("user_id") @db.Char(26)
  /** המפתח היציב שהדפדפן מנפיק — ייחודי גלובלית. */
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")
  /** כישלונות רצופים; מתאפס בהצלחה. חציית התקרה מוחקת את המנוי. */
  failureCount  Int       @default(0) @map("failure_count")

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// דפוס Outbox — אירוע נכתב באותה טרנזקציה עם השינוי; Worker מפיץ (docs/02 §5).
model OutboxEvent {
  id          String    @id @db.Char(26)
  tenantId    String    @map("tenant_id") @db.Char(26)
  name        String    @db.VarChar(60)
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

// Append-only. הרשאות ה-DB של האפליקציה: INSERT+SELECT בלבד (ראו enable_rls.sql).
model AuditLog {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  userId     String?  @map("user_id") @db.Char(26)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Char(26)
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("audit_log")
}

/// הגדרות פלטפורמה (מפתחות ספקים) — מנוהלות ממסך /platform, מוצפנות.
/// מחוץ ל-RLS: רמת פלטפורמה, לא רמת דייר (כמו users/sessions).
/// הגדרת מסלול מנוי — מה כלול בו, כמה הוא עולה ומה המגבלות.
///
/// טבלה ברמת הפלטפורמה (כמו platform_settings): אין בה נתוני לקוחות,
/// והיא נקראת גם מתוך הקשר דייר כדי לדעת מה מותר למשרד. אין שורה
/// לקוד מסוים ⇒ ברירת המחדל שבקוד (packages/shared — plans.ts), כך
/// שמערכת שעלתה זה עתה עובדת לפני שנגעו במסך.
/// קוד קופון להצטרפות. מחוץ ל-RLS, כמו plans ו-platform_settings.
///
/// הוא נקרא בנתיב ההרשמה **הציבורי**, לפני שקיים דייר שאפשר לסנן
/// לפיו — טבלה תחת FORCE RLS הייתה מחזירה שם אפס שורות בשקט, וכל
/// קוד היה נראה כלא קיים. אין בה מידע על לקוחות קצה.
model Coupon {
  code            String    @id @db.VarChar(40)
  description     String    @default("") @db.VarChar(200)
  /// percent | free_days
  kind            String    @db.VarChar(20)
  percentOff      Int?      @map("percent_off")
  freeDays        Int?      @map("free_days")
  /// null = חל על כל המסלולים
  planCode        String?   @map("plan_code") @db.VarChar(20)
  /// null = בלי הגבלת כמות
  maxRedemptions  Int?      @map("max_redemptions")
  redemptions     Int       @default(0)
  expiresAt       DateTime? @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Char(26)

  @@index([isActive])
  @@map("coupons")
}

model Plan {
  code               String   @id @db.VarChar(20)
  name               String   @db.VarChar(60)
  description        String   @default("") @db.VarChar(500)
  monthlyPriceAgorot Int      @default(0) @map("monthly_price_agorot")
  /// null = נמכר חודשי בלבד
  yearlyPriceAgorot  Int?     @map("yearly_price_agorot")
  /// null = ללא הגבלה — ערך תקין ומכוון, לא "לא הוגדר"
  maxUsers           Int?     @map("max_users")
  maxProperties      Int?     @map("max_properties")
  features           String[] @default([])
  trialDays          Int      @default(14) @map("trial_days")
  isPublic           Boolean  @default(true) @map("is_public")
  sortOrder          Int      @default(0) @map("sort_order")
  /// מסלול שנמחק. **דגל ולא מחיקת שורה**: קטלוג המסלולים ממזג
  /// ברירות מחדל מובנות עם השורות שנשמרו, ולכן מחיקת שורה של מסלול
  /// מובנה הייתה מחזירה אותו לחיים בהגדרות המקוריות שלו. שורה
  /// פרושה מוסתרת מהקטלוג; יצירה מחדש של אותו קוד מחזירה אותה.
  retiredAt          DateTime? @map("retired_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy          String?  @map("updated_by") @db.Char(26)

  @@index([sortOrder])
  @@map("plans")
}

/// מחוץ ל-RLS: רמת פלטפורמה, כמו plans ו-platform_settings.
///
/// ההחלטה הזו אינה נוחות. הוובהוק של קארדקום מגיע לנתיב **ציבורי**,
/// בלי Session ובלי הקשר דייר — טבלה תחת FORCE RLS הייתה מחזירה לו
/// אפס שורות בשקט, התשלום היה נרשם כאילו לא נמצא, והמנוי לא היה
/// מופעל. אין כאן מידע על לקוחות הקצה של המשרד, רק מזהה דייר, סכום
/// ומזהי עסקה; הסינון לפי דייר נאכף בשכבת האפליקציה, כמו ב-users.
model Subscription {
  id                 String    @id @db.Char(26)
  /// דייר אחד, מנוי אחד. מסלול נוסף הוא שינוי של השורה הזו.
  tenantId           String    @unique @map("tenant_id") @db.Char(26)
  planCode           String    @map("plan_code") @db.VarChar(20)
  /// monthly | yearly
  billingCycle       String    @default("monthly") @map("billing_cycle") @db.VarChar(10)
  /// trial | active | past_due | cancelled
  status             String    @default("trial") @db.VarChar(20)
  /// עד מתי שולם. null במצב ניסיון — שם התפוגה היא tenants.trial_ends_at.
  currentPeriodEnd   DateTime? @map("current_period_end")
  /// יום החיוב בחודש (1–31), כפי שנקבע בתשלום הראשון.
  ///
  /// בלעדיו מנוי שנפתח ב-31 בינואר היה נגמר ב-28 בפברואר ומשם ממשיך
  /// ב-28 לתמיד — הקיצור החד-פעמי של חודש קצר הופך לקבוע.
  billingAnchorDay   Int?      @map("billing_anchor_day") @db.SmallInt
  /// טוקן קארדקום לחיוב חוזר, מוצפן באותו מנגנון של platform_settings.
  /// null = אין כרטיס שמור, והחידוש יהיה ידני.
  cardTokenEncrypted String?   @map("card_token_encrypted")
  /// ארבע ספרות — לתצוגה בלבד, כדי שהמשרד יזהה איזה כרטיס שמור.
  cardLast4          String?   @map("card_last4") @db.VarChar(4)
  /// תוקף הכרטיס. שני שדות ולא מחרוזת אחת: החיוב החוזר דורש MMYY
  /// מרופד באפסים, ופיצול מחרוזת בכל חיוב הוא מקום להיווצרות באג.
  cardMonth          Int?      @map("card_month") @db.SmallInt
  cardYear           Int?      @map("card_year") @db.SmallInt
  /// ת"ז של בעל הכרטיס, מוצפנת — קארדקום דורש אותה בחיוב בטוקן.
  cardOwnerIdEncrypted String? @map("card_owner_id_encrypted")
  /// התקופה שעבורה כבר נשלחה תזכורת לפני חיוב.
  ///
  /// לא דגל בוליאני: הסורק רץ כל שעה, ו"נשלח" סתם היה שולח תזכורת
  /// בכל סבב עד החיוב. ההשוואה ל-currentPeriodEnd מאפסת את עצמה
  /// בכל חידוש.
  renewalReminderFor DateTime? @map("renewal_reminder_for")
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// תשלום יחיד. מחוץ ל-RLS מאותה סיבה בדיוק כמו subscriptions.
model Payment {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  planCode      String    @map("plan_code") @db.VarChar(20)
  billingCycle  String    @map("billing_cycle") @db.VarChar(10)
  amountAgorot  Int       @map("amount_agorot")
  /// pending | paid | failed
  status        String    @default("pending") @db.VarChar(20)
  /// מזהה דף התשלום אצל קארדקום. **ייחודי, וזה מה שהופך את הוובהוק
  /// לאידמפוטנטי**: קארדקום שולח הודעה יותר מפעם אחת, ובלי המפתח הזה
  /// אותו תשלום היה מאריך את התקופה פעמיים.
  lowProfileId  String    @unique @map("low_profile_id") @db.VarChar(64)
  transactionId String?   @map("transaction_id") @db.VarChar(40)
  /// מסמך שקארדקום הפיק, אם המסוף מוגדר להפקה. אצלנו הוא אינו מוגדר
  /// כך (החשבוניות מופקות במערכת אחרת), ולכן השדות נשארים ריקים.
  /// הם קיימים ליום שבו יוחלט להפיק חשבוניות שם — הזיכוי עצמו אינו
  /// זקוק להם, הוא עובד מול מזהה העסקה.
  documentType   String?  @map("document_type") @db.VarChar(40)
  documentNumber Int?     @map("document_number")
  /// כמה זוכה בפועל. סכום ולא דגל: זיכוי חלקי (החזר יחסי על חודש
  /// שלא נוצל) הוא המקרה הנפוץ, ו"זוכה כן/לא" לא היה יודע לתארו.
  refundedAgorot Int?     @map("refunded_agorot")
  refundedAt     DateTime? @map("refunded_at")
  refundTransactionId String? @map("refund_transaction_id") @db.VarChar(40)
  refundReason   String?  @map("refund_reason") @db.VarChar(300)
  /// מה קארדקום אמר כשזה נכשל — לתמיכה, לא למשתמש
  failureReason String?   @map("failure_reason") @db.VarChar(300)
  paidAt        DateTime? @map("paid_at")
  createdBy     String?   @map("created_by") @db.Char(26)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@map("payments")
}

/// מחיר ליד לפי מקור. מחוץ ל-RLS: רמת פלטפורמה, כמו plans.
///
/// טבלה ולא קבוע בקוד, כי המחיר שמשלמים לספק שונה בין ספק לספק
/// ומשתנה בזמן — מחיר אחד לכולם היה מחייב שינוי קוד בכל משא ומתן.
/// אין שורה למקור ⇒ ברירת המחדל שבקוד (packages/shared —
/// collaboration-cost.ts), כך שמערכת שעלתה זה עתה עובדת.
model LeadSourcePrice {
  /// המזהה כפי שהוא נשמר על הביקוש (shared_demands.source)
  source      String   @id @db.VarChar(20)
  label       String   @db.VarChar(60)
  creditsCost Int      @default(1) @map("credits_cost")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Char(26)

  @@map("lead_source_prices")
}

model PlatformSetting {
  key            String   @id @db.VarChar(60)
  valueEncrypted String   @map("value_encrypted")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by") @db.Char(26)

  @@map("platform_settings")
}

/// נוסחי ההסכמים של המשרד. אין שורה ⇒ נוסח ברירת המחדל שבקוד
/// (packages/shared — agreement-template.ts), כך שמשרד חדש עובד מיד.
model AgreementTemplate {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  /// brokerage | exclusivity
  kind      String   @db.VarChar(20)
  body      String
  updatedBy String?  @map("updated_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@map("agreement_templates")
}

/// הסכם שנשלח ללקוח לחתימה. rendered_body הוא צילום הנוסח שהלקוח
/// ראה, ו-bodyHash מאפשר להוכיח שהטקסט לא שונה אחרי החתימה.
model Agreement {
  id              String    @id @db.Char(26)
  tenantId        String    @map("tenant_id") @db.Char(26)
  /// brokerage | exclusivity
  kind            String    @db.VarChar(20)
  /// null = הלקוח נמחק מהמערכת וההסכם **החתום** נשמר.
  ///
  /// מסמך חתום אינו נמחק בשום מקרה — הוא ראיה משפטית ובסיס הזכאות
  /// לדמי התיווך. לכן מחיקת לקוח מנתקת את ההסכם מהכרטיס במקום למחוק
  /// אותו; זהות החותם נשארת במסמך עצמו (signerName/signerIdNumber
  /// והנוסח החתום), כי בלעדיה המסמך חסר ערך.
  contactId       String?   @map("contact_id") @db.Char(26)
  propertyId      String?   @map("property_id") @db.Char(26)
  /// pending | viewed | signed | declined | expired
  /// expired נקבע כשקישור שפג מפנה את מקומו להסכם חדש — האינדקס
  /// הייחודי על הסכם פעיל לא יכול לבדוק תאריך בעצמו.
  status          String    @default("pending") @db.VarChar(20)
  renderedBody    String    @map("rendered_body")
  /// גיבוב הנוסח החתום. עד החתימה זהה ל-presentedHash; ברגע החתימה
  /// נכנס מספר הזהות לגוף המסמך והגיבוב מחושב מחדש.
  bodyHash        String    @map("body_hash") @db.Char(64)
  /// הגיבוב שהוצג ללקוח לפני החתימה — מוכיח מה הוצג, לצד מה שנחתם
  presentedHash   String?   @map("presented_hash") @db.Char(64)
  publicToken     String    @unique @map("public_token") @db.VarChar(64)
  tokenExpires    DateTime  @map("token_expires")
  signerName      String?   @map("signer_name") @db.VarChar(120)
  signerIdNumber  String?   @map("signer_id_number") @db.VarChar(20)
  /// חתימת היד כפי שצוירה, כתמונת PNG (data URL).
  ///
  /// תיבת סימון מוכיחה שמישהו לחץ; חתימה מצוירת היא מה שנראה כמו
  /// חתימה למי שקורא את המסמך אחר כך, וזה מה שמבקשים במסמך חתום.
  /// היא **אינה** מחליפה את הגיבוב — ההוכחה שהטקסט לא שונה נשארת
  /// bodyHash/presentedHash.
  signatureImage  String?   @map("signature_image")
  signedAt        DateTime? @map("signed_at")
  signedIp        String?   @map("signed_ip") @db.VarChar(45)
  signedUserAgent String?   @map("signed_user_agent") @db.VarChar(300)
  viewedAt        DateTime? @map("viewed_at")
  declinedAt      DateTime? @map("declined_at")
  /// מתי נשלח ללקוח בפעם האחרונה — לא זהה ל-createdAt: מזכירים שוב
  /// ושוב ללקוח שלא חתם
  sentAt          DateTime? @map("sent_at")
  createdBy       String?   @map("created_by") @db.Char(26)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, contactId, kind])
  @@map("agreements")
}

/// יומן שיחות. כרגע מתועד ידנית; שיחות מספק טלפוניה ייכנסו לאותה
/// טבלה עם source="provider" כשייכנס חיבור כזה.
model Call {
  id              String   @id @db.Char(26)
  tenantId        String   @map("tenant_id") @db.Char(26)
  /// inbound | outbound
  direction       String   @db.VarChar(10)
  /// manual | provider | meeting
  ///
  /// `meeting` = הקלטה של פגישה מהיומן. הטבלה הזו היא בפועל "שיחה
  /// מוקלטת עם סיכום", וצינור התמלול שלה כבר עובד; מסלול מקביל
  /// לפגישות היה משכפל אחסון, תמלול, סיכום וסטטוס.
  source          String   @default("manual") @db.VarChar(20)
  /// מזהה השיחה אצל ספק המרכזייה — מפתח אידמפוטנטיות מול שליחות חוזרות
  providerCallId  String?  @map("provider_call_id") @db.VarChar(80)
  contactId       String?  @map("contact_id") @db.Char(26)
  leadId          String?  @map("lead_id") @db.Char(26)
  /// הפגישה שההקלטה הזו מתעדת, כשהמקור הוא `meeting`.
  appointmentId   String?  @map("appointment_id") @db.Char(26)
  phoneEncrypted  String?  @map("phone_encrypted")
  phoneHash       String?  @map("phone_hash") @db.Char(64)
  occurredAt      DateTime @map("occurred_at")
  durationMinutes Int?     @map("duration_minutes")
  /// answered | missed | no_answer | voicemail
  outcome         String   @default("answered") @db.VarChar(20)
  summary         String?  @db.VarChar(4000)
  /** מפתח ההקלטה ב-S3; ההקלטה עצמה לא יושבת בטבלה שנשלפת בכל רשימה. */
  recordingKey    String?  @map("recording_key") @db.VarChar(300)
  transcript      String?
  transcribedAt   DateTime? @map("transcribed_at")
  /** pending | running | done | failed | unavailable */
  transcriptionStatus String? @map("transcription_status") @db.VarChar(20)
  createdBy       String?  @map("created_by") @db.Char(26)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
  @@index([tenantId, appointmentId])
  @@map("calls")
}

/**
 * חיבור יומן Google של משתמש.
 *
 * למשתמש ולא למשרד: ליומן יש בעלים אחד, וחיבור ברמת המשרד היה מחייב
 * חשבון Google משותף — מה שאף משרד לא עושה.
 */
model GoogleCalendarLink {
  id                     String    @id @db.Char(26)
  tenantId               String    @map("tenant_id") @db.Char(26)
  userId                 String    @unique @map("user_id") @db.Char(26)
  googleEmail            String    @map("google_email") @db.VarChar(254)
  calendarId             String    @default("primary") @map("calendar_id") @db.VarChar(200)
  /// refresh token ארוך-טווח, מוצפן. לעולם אינו מוחזר ללקוח — מי
  /// שמחזיק בו קורא וכותב ביומן הפרטי של הסוכן.
  refreshTokenEncrypted  String    @map("refresh_token_encrypted")
  /// טוקן הסנכרון המצטבר של Google — הבקשה הבאה מקבלת רק מה שהשתנה.
  syncToken              String?   @map("sync_token")
  lastSyncAt             DateTime? @map("last_sync_at")
  /// מה קרה בסבב האחרון. מוצג למשתמש: חיבור שנשבר בשקט הוא חיבור
  /// שסומכים עליו ואינו עובד.
  lastError              String?   @map("last_error") @db.VarChar(300)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("google_calendar_links")
}
