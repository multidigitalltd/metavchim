// מודל הנתונים — docs/03-data-model.md
//
// עקרונות:
// - tenant_id בכל טבלה עסקית; תמיד העמודה הראשונה באינדקסים מורכבים.
// - מזהים: ULID, נוצרים בשכבת האפליקציה (אין default ב-DB).
// - PII (טלפון/אימייל/שם לקוח קצה) מוצפן ברמת האפליקציה; phone_hash לחיפוש.
// - RLS מופעל על כל הטבלאות — ראו prisma/sql/enable_rls.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // הרצה שוטפת: תפקיד האפליקציה המוגבל (RLS חל עליו)
  url       = env("DATABASE_URL")
  // מיגרציות: תפקיד הבעלים — הפרדת הרשאות (docs/04 §2)
  directUrl = env("DIRECT_DATABASE_URL")
}

model Tenant {
  id                         String           @id @db.Char(26)
  name                       String           @db.VarChar(120)
  /// מקומות **נוספים** שנרכשו לסוכן הוואטסאפ, מעבר לאחד שכלול.
  ///
  /// המקום הראשון מגיע מהמסלול: כל מסלול שכולל את הסוכן מזכה
  /// בסוכן אחד. כאן נספר רק מה שנרכש מעבר לו, ולכן `0` הוא המצב
  /// הרגיל ולא „לא הוגדר”. בעל המשרד מחליט **מי** מחזיק במקומות.
  /// ראו `whatsappAgentSeats` ב-shared לחישוב הסכום.
  whatsappAgentSeatsExtra    Int              @default(0) @map("whatsapp_agent_seats_extra")
  plan                       String           @default("basic") @db.VarChar(20)
  status                     String           @default("trial") @db.VarChar(20)
  /// סוף תקופת הניסיון. null = אין תפוגה — משרד שהוקם ידנית או ששילם.
  /// עמודה ולא שדה ב-settings: היא נבדקת בכל אימות Session.
  trialEndsAt                DateTime?        @map("trial_ends_at")
  /// עד מתי שולם. null = אין תפוגה (משרד שהוקם ידנית).
  ///
  /// יושבת כאן ולא רק ב-subscriptions **בכוונה**: זהו שער ההרשאה,
  /// והוא נבדק בכל אימות Session יחד עם trial_ends_at. תפוגה שנשענת
  /// על סורק שירוץ אי-פעם הייתה נותנת גישה חינם לכל מי ששילם פעם
  /// אחת, בדיוק כפי שקרה קודם עם הניסיון (ביקורת Codex).
  paidUntil                  DateTime?        @map("paid_until")
  /// self | manual — מאיזה ערוץ המשרד הגיע. לדוח ולתמיכה, לא להרשאות.
  signupSource               String           @default("manual") @map("signup_source") @db.VarChar(20)
  /// הקופון שמומש בהרשמה — לתמיכה ולדוח.
  couponCode                 String?          @map("coupon_code") @db.VarChar(40)
  /// ההנחה שעוד לא נוצלה, כפי שהובטחה ברגע המימוש. נמחקת בתשלום
  /// הראשון שמצליח. העתק ולא קריאה מהקופון: עריכה או כיבוי שלו
  /// אינם אמורים לשנות למפרע את מה שכבר הובטח.
  couponPercentOff           Int?             @map("coupon_percent_off")
  /// המסלול שהקופון הוגבל אליו ברגע המימוש — ההנחה חלה רק עליו.
  couponPlanCode             String?          @map("coupon_plan_code") @db.VarChar(20)
  /// מודולים שהפלטפורמה חסמה למשרד הזה (מפתחות מ-CAPABILITY_MODULES).
  ///
  /// שכבה שלישית מעל התפקיד ומעל חריגי המשתמש, ובכיוון אחד: חוסמת
  /// ולעולם לא מעניקה. מוחלת בפענוח ה-Session **אחרי** חריגי המנהל,
  /// כדי שבעל המשרד לא יוכל להסיר אותה ממסך ההרשאות שלו.
  automationRules            AutomationRule[]
  blockedModules             String[]         @default([]) @map("blocked_modules")
  /// פיצ'רים שהפלטפורמה פתחה למשרד הזה מעבר למסלול שלו.
  ///
  /// המסלול הוא ברירת מחדל מסחרית ולא גזירה: עסקה מיוחדת, פיילוט על
  /// תכונה אחת, או לקוח ראשון שמקבל תוספת — כולם קורים לפני שיש
  /// מסלול שמתאים להם. בלי זה כל חריג היה מסלול חדש, והקטלוג היה
  /// הופך לרשימת לקוחות.
  featureGrants              String[]         @default([]) @map("feature_grants")
  /// פיצ'רים שהפלטפורמה סגרה למשרד הזה למרות שהם במסלול שלו.
  ///
  /// **גובר על `featureGrants`.** לא סדר מקרי: מי שסוגר תכונה — בגלל
  /// חוב, שימוש לרעה או תקלה — חייב שהסגירה תחזיק גם אם אותה תכונה
  /// הוענקה קודם ונשכחה.
  featureDenials             String[]         @default([]) @map("feature_denials")
  /// מחיר חודשי מוסכם למשרד הזה, באגורות. null = מחיר המסלול.
  ///
  /// חיובי בלבד. "חינם למשרד הזה" אינו מחיר אפס אלא הארכת חלון
  /// החינם — סכום אפס היה נשלח לסולק כחיוב על אפס ונדחה.
  priceOverrideMonthlyAgorot Int?             @map("price_override_monthly_agorot")
  /// מחיר שנתי מוסכם. נפרד מהחודשי — עסקה שנתית היא הנחה ולא כפל ב-12.
  priceOverrideYearlyAgorot  Int?             @map("price_override_yearly_agorot")
  /// עד מתי פתוח חלון גישת התמיכה שהמשרד העניק. null = סגור.
  /// נפתח רק בלחיצת בעל המשרד, לעולם לא מהפלטפורמה.
  supportAccessUntil         DateTime?        @map("support_access_until")
  supportAccessGrantedBy     String?          @map("support_access_granted_by") @db.Char(26)
  /// מרגע שנקבע — המשרד אינו מקבל עוד קבצים. null = מקבל.
  ///
  /// מחיקת משרד אוספת את מפתחות ה-S3 ואז מוחקת את השורות שמכירות
  /// אותם. העלאה שרצה במקביל מסתיימת באחד משני סידורים, ושניהם
  /// משאירים קובץ של לקוח אחרי שהמשרד ביקש להימחק: השורה נמחקת בלי
  /// שהמפתח נאסף, או שהשורה **והקובץ** שורדים את המחיקה (#258).
  ///
  /// לכן הדגל נקבע ונסגר בטרנזקציה משלו **לפני** האיסוף, ו-
  /// `StorageService.put` בודק אותו — נקודה אחת שכל העלאה עוברת בה,
  /// כולל טבלה שמינית שתיכתב בעוד שנה בלי לזכור את הכלל הזה.
  filesLockedAt              DateTime?        @map("files_locked_at")
  settings                   Json             @default("{}")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  users         User[]
  properties    Property[]
  whatsappLinks WhatsAppLink[]

  @@index([trialEndsAt])
  @@index([paidUntil])
  @@map("tenants")
}

// הערת RLS: users ו-sessions הן תשתית אימות — החיפוש בהן קורה לפני שקיים
// הקשר דייר (בזמן Login), ולכן הן מחוץ לפוליסת ה-RLS. הן לא מכילות PII של
// לקוחות קצה; הסינון לפי דייר נאכף בשכבת האפליקציה.
model User {
  id                   String    @id @db.Char(26)
  tenantId             String    @map("tenant_id") @db.Char(26)
  name                 String    @db.VarChar(120)
  email                String    @unique @db.VarChar(254)
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  phone                String?   @db.VarChar(20)
  role                 String    @db.VarChar(20)
  isActive             Boolean   @default(true) @map("is_active")
  /// גישה לסוכן האישי בוואטסאפ — **מקום מוקצה, ולא הרשאה שנגזרת מתפקיד.**
  ///
  /// בעל המשרד היה כלול אוטומטית לפי `role`, ולכן לא הייתה שום דרך
  /// להעביר את המקום לסוכן אחר: הדגל שלו לא נשמר בשום מקום. כאן הוא
  /// נשמר לכולם, כולל לבעל המשרד, וההקצאה היא החלטה מפורשת שרואים.
  whatsappAccess       Boolean   @default(false) @map("whatsapp_access")
  totpSecret           String?   @map("totp_secret") @db.VarChar(255)
  // סיסמה זמנית שחובה להחליף בכניסה ראשונה (ביקורת Codex, PR #5)
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  /**
   * חותמת שינוי הסיסמה האחרון — Sessions ישנים ממנה נפסלים (docs/04)
   */
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at")
  lastLoginAt          DateTime? @map("last_login_at")
  // מסך "מה חדש": העדכון האחרון שנצפה — הבאנר מוצג רק על חדשות מזה והלאה
  lastSeenAnnouncement String?   @map("last_seen_announcement") @db.VarChar(60)
  /// העדפות אישיות (נגישות ותצוגה) — נוסעות עם המשתמש בין מכשירים
  preferences          Json      @default("{}")
  /// קו ה-SIP האישי לסופטפון בדפדפן. של האדם ולא של המשרד: שיחה
  /// נכנסת צריכה לצלצל אצל מי שהיא מיועדת לו.
  sipUsername          String?   @map("sip_username") @db.VarChar(80)
  sipPasswordEncrypted String?   @map("sip_password_encrypted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  sessions            Session[]
  capabilityOverrides UserCapability[]
  agentEvents         AgentEvent[]
  whatsappLinks       WhatsAppLink[]

  @@index([tenantId, isActive])
  @@map("users")
}

/// חריג הרשאה למשתמש בודד — מעל מה שהתפקיד נותן (docs/04 §3).
/// הפירוט וההנמקה: packages/shared/src/logic/capability-overrides.ts
model UserCapability {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  userId     String    @map("user_id") @db.Char(26)
  capability String    @db.VarChar(40)
  /// "grant" = הוספה מעבר לתפקיד, "deny" = חסימה
  effect     String    @db.VarChar(10)
  /// null = לצמיתות. התפוגה נאכפת בקריאה, לא בעבודת ניקוי.
  expiresAt  DateTime? @map("expires_at")
  reason     String?   @db.VarChar(200)
  createdBy  String?   @map("created_by") @db.Char(26)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([tenantId, userId])
  @@map("user_capabilities")
}

/// חיבור של המשרד לשירות חיצוני (מרכזייה וכו').
/// ההנמקה והחלטות הזיהוי: packages/shared/src/logic/telephony.ts
model Integration {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  /// telephony
  kind             String    @db.VarChar(30)
  provider         String    @db.VarChar(30)
  /// active | disabled
  status           String    @default("active") @db.VarChar(20)
  /// הגדרות שאינן סוד — מוצגות במסך
  config           Json      @default("{}")
  /// אישורי הספק, מוצפנים; לעולם לא מוחזרים ללקוח
  secretsEncrypted String?   @map("secrets_encrypted")
  /// מזהה המשרד בכתובת ה-Webhook הציבורית
  webhookKey       String    @unique @map("webhook_key") @db.VarChar(64)
  lastEventAt      DateTime? @map("last_event_at")
  /// השדות באירוע האחרון (`diagnosticFields`) — שמות תמיד, וערכים
  /// לשדות הטכניים בלבד.
  ///
  /// מספיק כדי למפות ספק שמשתמש בשמות אחרים ולראות שדה שהגיע ריק,
  /// ואינו מכניס מספרי טלפון או שמות לקוחות לעמודה שנקראת בטקסט
  /// גלוי: שדה מזהה נשאר שם בלבד, ואם הוא ריק נאמר שהוא ריק.
  ///
  /// 1000 ולא 400 מאז שהערכים נכנסו. האורך כאן חייב להתאים למיגרציה
  /// שהרחיבה את העמודה — הצהרה צרה יותר גורמת למיגרציה הבאה
  /// שנוצרת ב-Prisma לנסות לצמצם עמודה שכבר מחזיקה מחרוזות ארוכות
  /// יותר (ביקורת Codex).
  lastEventKeys    String?   @map("last_event_keys") @db.VarChar(1000)
  /// האם ידענו לפרש את האירוע האחרון. `false` = הגיע ולא הובן,
  /// וזה מצב שונה לגמרי מ"לא הגיע כלום".
  lastEventOk      Boolean?  @map("last_event_ok")
  /// no_call_id | no_phone | invalid_phone — **למה** לא נקלט.
  /// מספר חסוי הוא מצב נורמלי ולא תקלת מיפוי, וההבחנה היא ההבדל
  /// בין הודעה שמכוונת נכון להודעה ששולחת לחפש בעיה שאינה קיימת.
  lastEventIssue   String?   @map("last_event_issue") @db.VarChar(40)
  createdBy        String?   @map("created_by") @db.Char(26)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@map("integrations")
}

/// הדומיין שהמשרד חיבר לשליחת אימייל מהכתובת שלו.
/// הכללים (אילו דומיינים, כתובת שולח, מתי "מאומת"):
/// packages/shared/src/logic/email-domain.ts
model EmailDomain {
  id                 String    @id @db.Char(26)
  /// דומיין אחד למשרד — המסך מציג חיבור יחיד, לא רשימה.
  tenantId           String    @unique @map("tenant_id") @db.Char(26)
  /// ייחודי גלובלית: משרד אינו יכול "לתפוס" דומיין שמשרד אחר כבר
  /// חיבר ולשלוח בשמו. ההתנגשות מוחזרת כשגיאה ידידותית בלי לגלות
  /// איזה משרד מחזיק בדומיין.
  domain             String    @unique @db.VarChar(253)
  /// postmark — הספק שמנהל את הרשומות והשליחה בפועל.
  provider           String    @default("postmark") @db.VarChar(30)
  /// מזהה הדומיין אצל הספק — נדרש לאימות ולמחיקה שם.
  providerDomainId   String    @map("provider_domain_id") @db.VarChar(60)
  /// רשומות ה-DNS שהמשרד מוסיף אצל ספק הדומיין שלו — מוצגות במסך.
  dkimHost           String    @map("dkim_host") @db.VarChar(253)
  dkimValue          String    @map("dkim_value") @db.VarChar(1000)
  returnPathHost     String    @map("return_path_host") @db.VarChar(253)
  returnPathValue    String    @map("return_path_value") @db.VarChar(253)
  dkimVerified       Boolean   @default(false) @map("dkim_verified")
  returnPathVerified Boolean   @default(false) @map("return_path_verified")
  /// מתי שתי הרשומות אומתו לראשונה — לתצוגה ולתמיכה.
  verifiedAt         DateTime? @map("verified_at")
  /// כתובת השולח ושם התצוגה — מה שהלקוח של המשרד רואה ב"מאת".
  fromEmail          String    @map("from_email") @db.VarChar(254)
  fromName           String    @map("from_name") @db.VarChar(80)
  /// מתי נבדק האימות לאחרונה — מבחין "טרם נבדק" מ"נבדק ונכשל".
  lastCheckedAt      DateTime? @map("last_checked_at")
  createdBy          String?   @map("created_by") @db.Char(26)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("email_domains")
}

model Session {
  id                String    @id @db.Char(26)
  userId            String    @map("user_id") @db.Char(26)
  // בעוגייה נשמר טוקן אקראי; כאן רק ה-SHA-256 שלו — גניבת DB לא מספיקה לחטיפת Session.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime  @map("expires_at")
  /**
   * חותמת שינוי-הסיסמה שכנגדה אומת ה-Session; ישנה ⇒ נפסל (docs/04)
   */
  passwordEpoch     DateTime? @map("password_epoch")
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(300)
  /// לא null = Session של תמיכה: חי רק בתוך חלון ההסכמה של המשרד,
  /// והביטול הורג אותו בבקשה הבאה. הערך הוא מי מהתמיכה נכנס.
  supportAdminEmail String?   @map("support_admin_email") @db.VarChar(254)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// אדם אמיתי אחד — קונה/מוכר/ליד מפנים לכאן; אין כפילויות אדם (docs/03 §3).
model Contact {
  id             String    @id @db.Char(26)
  tenantId       String    @map("tenant_id") @db.Char(26)
  // PII מוצפן (AES-GCM בשכבת האפליקציה) — לא נשמר בטקסט גלוי.
  nameEncrypted  String    @map("name_encrypted") @db.Text
  phoneEncrypted String    @map("phone_encrypted") @db.Text
  emailEncrypted String?   @map("email_encrypted") @db.Text
  // HMAC של הטלפון המנורמל — חיפוש ודה-דופליקציה בלי פענוח.
  phoneHash      String    @map("phone_hash") @db.Char(64)
  /**
   * HMAC של השם המנורמל — איתור כפילויות בלי לפענח. NULL עד ההשלמה.
   */
  nameHash       String?   @map("name_hash") @db.Char(64)
  /// חתימת האימייל (HMAC) — התאמת שולח נכנס מ-Gmail לכרטיס קיים.
  emailHash      String?   @map("email_hash") @db.Char(64)
  optedOutAt     DateTime? @map("opted_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  phones     ContactPhone[]
  links      ContactLink[]  @relation("primaryContact")
  linkedFrom ContactLink[]  @relation("relatedContact")

  @@unique([tenantId, phoneHash])
  @@map("contacts")
}

/**
 * טלפון נוסף לאותו אדם. הטלפון הראשי נשאר על `contacts` — כאן רק
 * המספרים הנוספים, עם אותו HMAC, כך שחיפוש נכנס מוצא את האדם דרך
 * כל אחד ממספריו באותו מנגנון בדיוק.
 */
model ContactPhone {
  id             String   @id @db.Char(26)
  tenantId       String   @map("tenant_id") @db.Char(26)
  contactId      String   @map("contact_id") @db.Char(26)
  phoneEncrypted String   @map("phone_encrypted") @db.Text
  phoneHash      String   @map("phone_hash") @db.Char(64)
  /**
   * mobile | home | work | other
   */
  label          String   @default("mobile") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneHash])
  @@index([tenantId, contactId])
  @@map("contact_phones")
}

/**
 * אדם נוסף על אותו כרטיס — בן/בת זוג, מיופה כוח, בן שמטפל בהורים.
 * הכרטיס ממשיך להצביע על איש קשר ראשי אחד; אלה תלויים בו.
 */
model ContactLink {
  id               String   @id @db.Char(26)
  tenantId         String   @map("tenant_id") @db.Char(26)
  contactId        String   @map("contact_id") @db.Char(26)
  relatedContactId String   @map("related_contact_id") @db.Char(26)
  /**
   * spouse | partner | parent | child | attorney | other
   */
  role             String   @default("other") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  contact Contact @relation("primaryContact", fields: [contactId], references: [id], onDelete: Cascade)
  related Contact @relation("relatedContact", fields: [relatedContactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, relatedContactId])
  @@index([tenantId, relatedContactId])
  @@map("contact_links")
}

model Property {
  id                   String    @id @db.Char(26)
  tenantId             String    @map("tenant_id") @db.Char(26)
  status               String    @default("draft") @db.VarChar(20)
  city                 String?   @db.VarChar(80)
  neighborhood         String?   @db.VarChar(80)
  street               String?   @db.VarChar(120)
  houseNumber          String?   @map("house_number") @db.VarChar(10)
  propertyType         String?   @map("property_type") @db.VarChar(30)
  dealType             String?   @map("deal_type") @db.VarChar(10)
  rooms                Decimal?  @db.Decimal(4, 1)
  areaSqm              Int?      @map("area_sqm")
  floor                Int?
  totalFloors          Int?      @map("total_floors")
  hasElevator          Boolean?  @map("has_elevator")
  hasParking           Boolean?  @map("has_parking")
  hasBalcony           Boolean?  @map("has_balcony")
  hasSafeRoom          Boolean?  @map("has_safe_room")
  hasStorage           Boolean?  @map("has_storage")
  condition            String?   @db.VarChar(20)
  priceAgorot          BigInt?   @map("price_agorot")
  priceFlexible        Boolean?  @map("price_flexible")
  /// מועד כניסה/מסירה — **המצב הוא השדה, התאריך נלווה אליו**.
  ///
  /// immediate | on_date | from_date | flexible. רוב הנכסים בשוק
  /// נמסרים "מיידי" או "בתיאום", ותאריך מלוח לבדו אילץ את הסוכן
  /// להמציא יום — שההתאמה אחר כך התייחסה אליו כאילו הוא אמיתי.
  entryType            String?   @map("entry_type") @db.VarChar(20)
  entryDate            DateTime? @map("entry_date") @db.Date
  /// הניואנס שאין לו שדה: "לאחר פינוי השוכר", "בכפוף לאישור משכנתה".
  entryNote            String?   @map("entry_note") @db.VarChar(160)
  exclusive            Boolean?
  exclusiveUntil       DateTime? @map("exclusive_until") @db.Date
  ownerContactId       String?   @map("owner_contact_id") @db.Char(26)
  /**
   * מי **גר** בנכס, כשזה אינו הבעלים — דירה שמושכרת בזמן שהיא מוצעת.
   * זה איש הקשר לתיאום ביקור: הבעלים מחליט על המכירה, אבל הדלת
   * נפתחת על ידי מי שגר שם. עד היום היה בכרטיס איש קשר אחד, ולכן
   * המתווך החזיק את מספר השוכר בטלפון שלו או בהערה חופשית — כלומר
   * מחוץ להרשאות, מחוץ להצפנה, ומחוץ למחיקת לקוח.
   * `occupant` ולא `tenant`: `tenantId` הוא המשרד בכל המערכת, ועמודה
   * בשם `tenant_contact_id` הייתה נקראת „איש הקשר של המשרד” בכל
   * שאילתה שמישהו יכתוב עליה בעתיד.
   * מועד הפינוי אינו נשמר כאן — `entryType`/`entryDate`/`entryNote`
   * כבר עונים על „מתי אפשר להיכנס”, וההערה שם אף נותנת „לאחר פינוי
   * השוכר” כדוגמה. שדה שני לאותה שאלה היה מתחיל לסתור את הראשון.
   */
  occupantContactId    String?   @map("occupant_contact_id") @db.Char(26)
  /// ‎**מי גר בנכס — שלוש אפשרויות, ו-`null` שהוא „טרם נשאל”.**
  ///
  /// ‎`owner | vacant | rented`. הערך אינו נגזר מקיומו של
  /// ‎`occupant_contact_id`: נכס בלי שוכר רשום **אינו** „הבעלים גר
  /// בו”, והוא גם אינו „ריק”. עד שמישהו סימן, המערכת אינה יודעת,
  /// והמסך אומר בדיוק את זה.
  ///
  /// ההבחנה אינה סמנטית: דירה ריקה מראים בכל שעה, דירה של הבעלים
  /// דורשת תיאום, ודירה מושכרת דורשת תיאום עם מי שאינו צד לעסקה.
  occupancy            String?   @db.VarChar(10)
  /// תום חוזה השכירות. רלוונטי רק כש-`occupancy = "rented"`.
  leaseEndsAt          DateTime? @map("lease_ends_at") @db.Date
  /// תקופת ההודעה על אי-חידוש, בימים.
  ///
  /// ממנה נגזר **המועד האחרון להודיע** (`leaseNotice` בחבילה
  /// המשותפת) — המספר שמתווך נשאל עליו כשהוא מבטיח מועד כניסה,
  /// ושחלף בשקט הופך את ההבטחה לשגויה בשנה שלמה.
  noticePeriodDays     Int?      @map("notice_period_days") @db.SmallInt
  /// מיקום הנכס — **תמיד WGS84**, גם כשהמקור עבד ברשת ישראל.
  ///
  /// פורמט אחד בכל המערכת, המרה בקצה: החלפת ספק פענוח אינה אמורה
  /// לגרור המרת מסד. `null` = הנכס עוד לא מוקם, וההתאמה נופלת
  /// להשוואת עיר כמו קודם.
  latitude             Float?
  longitude            Float?
  /// pin = הסוכן סימן ידנית · geocode = נגזר מהכתובת.
  /// ההבחנה חשובה ליום שבו נרצה לרענן מיקומים אוטומטיים בלי לדרוס
  /// סימון שאדם עשה במתכוון.
  locationSource       String?   @map("location_source") @db.VarChar(10)
  marketingTitle       String?   @map("marketing_title") @db.VarChar(160)
  marketingDescription String?   @map("marketing_description")
  internalNotes        String?   @map("internal_notes")
  attributes           Json      @default("{}")
  readinessScore       Int       @default(0) @map("readiness_score")
  // דף הנחיתה הציבורי של הנכס — הטוקן הוא ההרשאה (פוליסת RLS ייעודית)
  landingToken         String?   @unique @map("landing_token") @db.Char(43)
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  media  PropertyMedia[]

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, city, status])
  @@map("properties")
}

// „מלאו לי מה אתם מחפשים” — טופס שהלקוח ממלא בעצמו.
//
// הדרישות נאספות היום בשיחה, והמתווך מקליד תוך כדי. מה שנופל בין
// הכיסאות נופל שם לתמיד. הקישור מעביר את ההקלדה ללקוח — שגם יודע
// את התשובות טוב יותר, וגם ממלא כשנוח לו.
//
// **הטוקן הוא ההרשאה**, כמו בדף הנחיתה ובדף ההצעה: 43 תווי base64url
// (256 ביט), פוליסת RLS ציבורית שחושפת את השורה היחידה שהטוקן שלה
// הוצג, ותוקף שפג. אין כאן התחברות, ולכן אין מה לגנוב מלבד הקישור
// עצמו — ולכן גם אין בעמוד הציבורי שום פרט על לקוח אחר.
model IntakeRequest {
  id       String @id @db.Char(26)
  tenantId String @map("tenant_id") @db.Char(26)
  /// 43 תווי base64url. ייחודי גלובלית — הוא נפתר לפני שידוע הדייר.
  token    String @unique @db.Char(43)

  /// lead | buyer | open — שני הכרטיסים שיש בהם דרישות, ועוד אחד.
  ///
  /// `open` הוא קישור שנוצר **לפני שיש כרטיס**: המתווך שולח טופס
  /// ללקוח שאינו במאגר, והכרטיס נוצר מהפרטים שהלקוח ימלא. הערך
  /// נשאר `open` גם אחרי שהכרטיס נוצר — הוא התשובה לשאלה מאיפה
  /// הכרטיס הזה הגיע.
  subject   String  @db.VarChar(10)
  /// הכרטיס. `null` בקישור פתוח **עד השליחה**, ומלא אחריה.
  subjectId String? @map("subject_id") @db.Char(26)
  /// למי הטופס מיועד — לברכה בעמוד ולמספר שאליו נשלחת ההודעה.
  ///
  /// `null` באותו מצב בדיוק: בקישור פתוח אין עדיין איש קשר, והוא
  /// נוצר (או נמצא לפי הטלפון) כשהלקוח שולח.
  contactId String? @map("contact_id") @db.Char(26)

  /// buyer | seller — לאיזה צד של העסקה הטופס נענה.
  ///
  /// שמור על השורה ולא נגזר מהתשובות: הלקוח פותח את הקישור שוב כדי
  /// לתקן, והעמוד חייב לדעת לאיזה מסלול לחזור בלי לנחש לפי אילו
  /// שדות מלאים. `buyer` הוא הצד היחיד שהיה קיים עד כה, ולכן הוא
  /// ברירת המחדל וכל השורות הישנות נכונות בלעדיה.
  side       String  @default("buyer") @db.VarChar(10)
  /// טיוטת הנכס שהמוכר יצר — `null` בכל בקשה של קונה.
  ///
  /// בלעדיו שליחה שנייה מאותו קישור („שכחתי לציין שיש מעלית”) הייתה
  /// פותחת נכס שני, וכפילות כזו מתגלה רק כשמישהו שואל למה יש שתי
  /// מודעות לאותה דירה.
  propertyId String? @map("property_id") @db.Char(26)
  /// sent | opened | submitted | revoked
  status     String  @default("sent") @db.VarChar(12)
  /// manual = המתווך לחץ · missed_call = שיחה שלא נענתה.
  channel    String  @default("manual") @map("channel") @db.VarChar(20)
  /// מי יצר. `null` באוטומציה — אין אדם שלחץ.
  createdBy  String? @map("created_by") @db.Char(26)

  expiresAt     DateTime  @map("expires_at")
  openedAt      DateTime? @map("opened_at")
  submittedAt   DateTime? @map("submitted_at")
  /// מזהה השליחה האחרונה — **מספר גרסה**, לא חותמת.
  ///
  /// תפיסת הבקשה והכתיבה לכרטיס הן שתי טרנזקציות, ולכן השנייה
  /// חייבת לוודא מתחת לנעילת הקונה שהיא עדיין האחרונה. `submittedAt`
  /// שימש לכך תחילה והוא מדויק למילישנייה בלבד: שתי שליחות באותה
  /// מילישנייה מקבלות ערך זהה, והבדיקה מפסיקה להבחין ביניהן בדיוק
  /// במקרה שבשבילו היא נכתבה. ULID נוצר לכל תפיסה ואינו יכול
  /// להתנגש.
  submissionRev String?   @map("submission_rev") @db.Char(26)
  /// מה הלקוח שלח, כפי ששלח. נשמר גם אחרי המיזוג לכרטיס — זו
  /// הראיה למה השתנה ומי שינה, ובלעדיה „הכרטיס השתנה” הוא טענה
  /// בלי מקור.
  answers       Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, subject, subjectId])
  @@index([tenantId, status])
  @@map("intake_requests")
}

// נכסים תאומים — „עוד כמה כאלה יש לי”.
//
// לקוח מתעניין בדירה אחת, והמתווך יודע שיש לו עוד שתיים באותו
// סגנון. בזמן השיחה הוא צריך להיזכר בהן, ולעיתים קרובות לא נזכר.
// הקישור מוגדר מראש ומופיע בכרטיס כשהוא על הקו.
//
// **שורה אחת לזוג, בסדר קנוני.** הקשר סימטרי מעצם משמעותו: מי
// שהצהיר ששתי דירות מתאימות לאותו לקוח התכוון לשני הכיוונים, ולא
// היה מצפה להגדיר שוב מהכרטיס השני. הסדר (`property_a_id` <
// `property_b_id`) הוא מה שהופך את האינדקס הייחודי למחסום אמיתי —
// בלעדיו „א׳,ב׳” ו„ב׳,א׳” הן שתי שורות חוקיות לאותו קשר.
//
// הקשר **אינו** טרנזיטיבי: א׳↔ב׳ וא׳↔ג׳ אינם יוצרים ב׳↔ג׳. א׳
// יכולה לדמות לב׳ במחיר ולג׳ בשכונה בלי שב׳ וג׳ דומות כלל, וקבוצה
// הייתה מסיקה קשר שאיש לא הצהיר עליו.
model PropertyTwin {
  id String @id @db.Char(26)

  tenantId    String   @map("tenant_id") @db.Char(26)
  /// המזהה הקטן מבין השניים — ראו הסדר הקנוני למעלה.
  propertyAId String   @map("property_a_id") @db.Char(26)
  /// המזהה הגדול מבין השניים.
  propertyBId String   @map("property_b_id") @db.Char(26)
  /// „אותו בניין, קומה גבוהה יותר” — מה שהמתווך יאמר בשיחה.
  note        String?  @db.VarChar(200)
  createdBy   String?  @map("created_by") @db.Char(26)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, propertyAId, propertyBId])
  @@index([tenantId, propertyAId])
  @@index([tenantId, propertyBId])
  @@map("property_twins")
}

// „עדכנו אותי כשזה עולה” — רישום עניין בפיצ'ר שטרם הושק.
//
// מסך „בקרוב” עם כפתור שאינו רושם דבר מבטיח הודעה שאין למי לשלוח
// ביום ההשקה. הרישום נשמר, ולכן ההבטחה ניתנת לקיום.
//
// גנרי ולא טבלה לפיצ'ר: זה כבר הפיצ'ר השלישי שמוצג כ„בקרוב”, ולכל
// אחד תגיע אותה בקשה. שם הפיצ'ר נבדק מול רשימה סגורה בשרת.
model FeatureSignup {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  userId    String   @map("user_id") @db.Char(26)
  /// מזהה הפיצ'ר — ראו SIGNUP_FEATURES.
  feature   String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId, feature])
  @@index([tenantId, feature])
  @@map("feature_signups")
}

model PropertyMedia {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  propertyId String   @map("property_id") @db.Char(26)
  kind       String   @db.VarChar(20) // image | document | floorplan
  s3Key      String   @map("s3_key") @db.VarChar(512)
  altText    String?  @map("alt_text") @db.VarChar(300)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId, propertyId, sortOrder])
  @@map("property_media")
}

model Buyer {
  id                 String    @id @db.Char(26)
  tenantId           String    @map("tenant_id") @db.Char(26)
  contactId          String    @map("contact_id") @db.Char(26)
  // הסוכן שמטפל בקונה — הבסיס לאכיפת buyers.view_own (ביקורת Codex, PR #1)
  ownerUserId        String?   @map("owner_user_id") @db.Char(26)
  // דרישות מובנות (BuyerRequirements בסכמת Zod) — עמודות חמות + JSONB.
  cities             String[]
  dealType           String    @map("deal_type") @db.VarChar(10)
  budgetMinAgorot    BigInt?   @map("budget_min_agorot")
  /// `null` = הלקוח לא מסר תקציב.
  ///
  /// מצב נורמלי ולא חריג: שיחה נכנסת שבה נרשמו שם וטלפון היא לקוח
  /// לכל דבר, והתקציב מתברר מאוחר יותר. עד כה העמודה הייתה חובה,
  /// והמסכים הבריחו לתוכה 0 — כלומר "תקציב אפס", שמנוע ההתאמות
  /// קורא כ"לא יכול להרשות לעצמו כלום".
  ///
  /// קריטריון התקציב פשוט אינו נספר כשאין תקציב: הציון מנורמל לפי
  /// המשקלים שנבחנו בפועל (packages/shared/logic/matching.ts).
  budgetMaxAgorot    BigInt?   @map("budget_max_agorot")
  roomsMin           Decimal?  @map("rooms_min") @db.Decimal(4, 1)
  roomsMax           Decimal?  @map("rooms_max") @db.Decimal(4, 1)
  requirements       Json      @default("{}")
  /// האם הקונה סימן אזורי חיפוש על המפה. **נגזר מ-`requirements`**
  /// ונכתב יחד איתו — עמודה ולא שאילתת JSON, כדי שהסינון הגס
  /// יוכל לצרף אותו למועמדים בלי לפתוח את ה-JSON בכל שורה.
  /// אינדקס חלקי במיגרציה 20260815200000.
  hasSearchAreas     Boolean   @default(false) @map("has_search_areas")
  financing          String    @default("unknown") @db.VarChar(20)
  maturity           String    @default("interested") @db.VarChar(20)
  maturityOverridden Boolean   @default(false) @map("maturity_overridden")
  source             String    @db.VarChar(60)
  aiNotes            String?   @map("ai_notes")
  agentNotes         String?   @map("agent_notes")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, maturity, updatedAt])
  @@index([tenantId, dealType, budgetMaxAgorot])
  @@index([tenantId, ownerUserId])
  @@map("buyers")
}

// ציר הזמן של ליד: הערות, שיחות, הודעות, שינויי סטטוס (docs/03 §3).
// אינטראקציה על ליד או על קונה — בדיוק אחד מהם מוגדר (CHECK במיגרציה).
model Interaction {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  leadId    String?  @map("lead_id") @db.Char(26)
  buyerId   String?  @map("buyer_id") @db.Char(26)
  kind      String   @db.VarChar(20) // note | call | whatsapp | status_change | system
  direction String?  @db.VarChar(10) // in | out
  content   String
  createdBy String?  @map("created_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, buyerId, createdAt])
  @@map("interactions")
}

// קליטת נכס בקול: התמלול, השדות שחולצו והחוסרים — נשמר לשחזור ותיקון.
model VoiceIntake {
  id              String   @id @db.Char(26)
  tenantId        String   @map("tenant_id") @db.Char(26)
  transcript      String
  extractedFields Json     @default("{}") @map("extracted_fields")
  missingFields   String[] @map("missing_fields")
  propertyId      String?  @map("property_id") @db.Char(26)
  createdBy       String?  @map("created_by") @db.Char(26)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("voice_intakes")
}

model Lead {
  id                  String    @id @db.Char(26)
  tenantId            String    @map("tenant_id") @db.Char(26)
  contactId           String    @map("contact_id") @db.Char(26)
  source              String    @db.VarChar(20)
  intent              String    @default("unknown") @db.VarChar(20)
  status              String    @default("new") @db.VarChar(20)
  assignedToUserId    String?   @map("assigned_to_user_id") @db.Char(26)
  requiresHuman       Boolean   @default(false) @map("requires_human")
  requiresHumanReason String?   @map("requires_human_reason") @db.VarChar(500)
  propertyId          String?   @map("property_id") @db.Char(26)
  summary             String?
  firstResponseAt     DateTime? @map("first_response_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, assignedToUserId, status, createdAt])
  @@index([tenantId, status, requiresHuman])
  @@map("leads")
}

/// תיבת הדואר הפנימית — תשובות של לקוחות למיילים שהמערכת שלחה,
/// ותשובות הסוכן מתוך המערכת. הטוקן שבכתובת ה-Reply-To (טבלת
/// email_reply_tokens) הוא מה שמקשר תשובה נכנסת ללקוח הנכון.
model EmailMessage {
  id                String    @id @db.Char(26)
  tenantId          String    @map("tenant_id") @db.Char(26)
  contactId         String    @map("contact_id") @db.Char(26)
  /// in = מהלקוח אלינו; out = תשובת הסוכן מתוך המערכת
  direction         String    @db.VarChar(3)
  subject           String    @db.VarChar(200)
  body              String    @db.VarChar(5100)
  /// כתובת השולח כפי שהגיעה — לזיהוי "ענה מכתובת אחרת" במסך
  fromEmail         String?   @map("from_email") @db.VarChar(320)
  /// MessageID של הספק — דה-דופליקציה מול Webhook שנשלח פעמיים
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  readAt            DateTime? @map("read_at")
  readBy            String?   @map("read_by") @db.Char(26)
  /// pending | sent | failed | unknown — על הודעות **יוצאות** בלבד; NULL בנכנסות.
  ///
  /// `failed` נאמר רק כשהספק ענה ודחה. פסק זמן או 5xx הם `unknown`:
  /// ייתכן שההודעה כן יצאה, ו„לא נשלחה” שם מזמין שליחה כפולה.
  ///
  /// הרשומה נכתבת `pending` **לפני** השליחה ומאושרת אחריה: שליחה היא
  /// פעולה בלתי הפיכה, וכתיבה אחריה משמעה שכשל בכתיבה מוחק כל זכר
  /// להודעה שהלקוח כבר קיבל.
  sendState         String?   @map("send_state") @db.VarChar(10)
  createdBy         String?   @map("created_by") @db.Char(26)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@map("email_messages")
}

/// קובץ מצורף להודעת מייל — התוכן באחסון האובייקטים, כאן המפתח
/// והמטא-נתונים. הסוג מוגבל לרשימה סגורה בקליטה (shared).
model EmailAttachment {
  id          String    @id @db.Char(26)
  tenantId    String    @map("tenant_id") @db.Char(26)
  messageId   String    @map("message_id") @db.Char(26)
  name        String    @db.VarChar(200)
  contentType String    @map("content_type") @db.VarChar(100)
  /// image | video | file — מוכרע פעם אחת בקליטה; המסך בוחר תצוגה לפיו
  kind        String    @db.VarChar(10)
  sizeBytes   Int       @map("size_bytes")
  s3Key       String    @map("s3_key") @db.VarChar(500)
  /// מקומו של הקובץ בהודעה — זהות יציבה שאינה תלויה בניסיון.
  ///
  /// המפתח באחסון נגזר ממנה, ולכן שתי מסירות של אותו מייל מחשבות את
  /// אותו מפתח בדיוק ו-`ON CONFLICT DO NOTHING` מכריע ביניהן. NULL על
  /// שורות שנכתבו לפני העמודה — Postgres מתייחס ל-NULL כערכים שונים,
  /// ולכן הן אינן מתנגשות באינדקס הייחודי.
  ordinal     Int?
  /// ‏"נתבע" אינו "הועלה". השורה נכתבת לפני ההעלאה, ולכן קיומה אינו
  /// מעיד שהאובייקט קיים: NULL = נתבע וטרם הועלה, ערך = הושלם.
  /// מסירה חוזרת משלימה תביעה נטושה, והשיחה מציגה רק מה שהושלם.
  uploadedAt  DateTime? @map("uploaded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, messageId, ordinal])
  @@index([tenantId, messageId])
  @@map("email_attachments")
}

/// טוקן ה-Reply-To של לקוח — `local+<token>@inbound` על כל מייל
/// יוצא אליו. בלי RLS בכוונה (כמו lead_webhooks): ה-Webhook הנכנס
/// מזהה את הדייר דרך הטוקן, לפני שיש הקשר דייר. אין כאן PII.
model EmailReplyToken {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  contactId String   @map("contact_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  /// אינדקס ולא ייחודיות: מיזוג כרטיסים מעביר טוקנים לשורד, וכתובת
  /// Reply-To ישנה שבתיבת הלקוח חייבת להמשיך להגיע. נפתר לפי id.
  @@index([tenantId, contactId])
  @@map("email_reply_tokens")
}

/// חיבור Gmail — אימיילים נכנסים הופכים ללידים או מצטרפים לכרטיס
/// קיים. מבנה זהה ל-GoogleCalendarLink: חיבור אישי (userId ייחודי),
/// refresh token מוצפן, ושגיאת הסבב האחרון מוצגת למשתמש.
model GmailLink {
  id                    String    @id @db.Char(26)
  tenantId              String    @map("tenant_id") @db.Char(26)
  userId                String    @unique @map("user_id") @db.Char(26)
  googleEmail           String    @map("google_email") @db.VarChar(254)
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  /// סמן ההתקדמות: internalDate (מילישניות) של ההודעה האחרונה שעובדה.
  lastInternalMs        BigInt    @default(0) @map("last_internal_ms")
  lastSyncAt            DateTime? @map("last_sync_at")
  lastError             String?   @map("last_error") @db.VarChar(300)
  /// אימיילים שדולגו כי לא זוהה בהם שולח מוכר או טלפון — שקיפות במסך.
  skippedCount          Int       @default(0) @map("skipped_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("gmail_links")
}

/// דחיית הצעת מיזוג כרטיסים: "אלה לא אותו אדם". נשמרת לפי חתימת
/// השם של הקבוצה (name_hash) יחד עם גודל הקבוצה בזמן הדחייה —
/// כרטיס נוסף שנוצר אחר-כך עם אותו שם מגדיל את הקבוצה ומחזיר את
/// ההצעה, כי זו כבר שאלה חדשה.
model DuplicateDismissal {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  nameHash     String   @map("name_hash") @db.Char(64)
  contactCount Int      @map("contact_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, nameHash])
  @@map("duplicate_dismissals")
}

/// מפתחות קליטת לידים מהאתר — כמה לכל משרד, עם שם מקור לכל מפתח
/// ("אתר", "פייסבוק"...). מחוץ ל-RLS בכוונה: הנתיב הציבורי
/// ‎/public/leads/:key מזהה את המשרד *לפי* המפתח, לפני שיש הקשר
/// דייר — אותו דגם כמו subscriptions מול ה-webhook של קארדקום.
model LeadWebhook {
  id          String   @id @db.Char(26)
  tenantId    String   @map("tenant_id") @db.Char(26)
  key         String   @unique @db.VarChar(64)
  /// נכנס כ-source של הליד — ולכן מוגבל לאורך העמודה שם (20)
  sourceLabel String   @map("source_label") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("lead_webhooks")
}

model Match {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  propertyId    String    @map("property_id") @db.Char(26)
  buyerId       String    @map("buyer_id") @db.Char(26)
  score         Int
  breakdown     Json
  explanation   String    @db.VarChar(1000)
  status        String    @default("suggested") @db.VarChar(20)
  /// למה הסוכן דחה — רשימה סגורה (packages/shared — match-feedback.ts).
  /// ריק בהתאמות שלא נדחו, ובדחיות שקדמו לשדה.
  dismissReason String?   @map("dismiss_reason") @db.VarChar(20)
  dismissNote   String?   @map("dismiss_note") @db.VarChar(200)
  dismissedAt   DateTime? @map("dismissed_at")
  dismissedBy   String?   @map("dismissed_by") @db.Char(26)
  computedAt    DateTime  @map("computed_at")
  /// מתי ההתאמה **נוצרה**, להבדיל ממתי חושבה לאחרונה.
  ///
  /// גבול ההפעלה של ההצעות האוטומטיות („מכאן והלאה”) נשען על חותמת
  /// שאינה זזה. `computed_at` נדרס בכל חישוב מחדש, ולכן התאמה ישנה
  /// שהנכס שלה עודכן נראתה חדשה וחצתה את הגבול. השדה הזה נכתב פעם
  /// אחת ואינו מתעדכן — לא ב-`upsertMatch` ולא בשום מקום אחר.
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, propertyId, buyerId])
  @@index([tenantId, propertyId, score(sort: Desc)])
  @@index([tenantId, buyerId, score(sort: Desc)])
  @@index([tenantId, status, createdAt])
  @@map("matches")
}

model Offer {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  // הצעה אחת פר התאמה — מונע כפילויות במרוץ בין בקשות (ביקורת Codex, PR #3)
  matchId       String    @unique @map("match_id") @db.Char(26)
  channel       String    @db.VarChar(20)
  sentText      String?   @map("sent_text") @db.VarChar(2000)
  // Snapshot תצוגת הנכס לקונה — בלי PII; הדף הציבורי קורא רק מכאן.
  presentation  Json      @default("{}")
  // טוקן דף ההצעה הציבורי — אקראי, חד-ערכי, עם תפוגה (docs/06 §6).
  publicToken   String    @unique @map("public_token") @db.Char(43)
  tokenExpires  DateTime  @map("token_expires")
  status        String    @default("pending_approval") @db.VarChar(20)
  openCount     Int       @default(0) @map("open_count")
  sentAt        DateTime? @map("sent_at")
  firstOpenedAt DateTime? @map("first_opened_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status, createdAt])
  @@map("offers")
}

// ביקוש אנונימי משותף ברשת (docs/04 §7): ללא PII, תקציב מעוגל, אזור
// ברמת עיר. הטבלה היחידה עם קריאת רשת חוצת-דיירים (RLS ייעודי).
// origin_buyer_id הוא ULID חסר-משמעות בלי גישה לטבלת buyers (מבודדת RLS).
model SharedDemand {
  id              String    @id @db.Char(26)
  tenantId        String    @map("tenant_id") @db.Char(26)
  originBuyerId   String?   @map("origin_buyer_id") @db.Char(26)
  source          String    @default("network") @db.VarChar(20) // network | kanko
  externalId      String?   @unique @map("external_id") @db.VarChar(120)
  cities          String[]
  /// שכונות מבוקשות — מועתקות מדרישות הקונה בשיתוף; אנונימיות כמו ערים
  neighborhoods   String[]  @default([])
  dealType        String    @map("deal_type") @db.VarChar(10)
  /// סוגי הנכס שהקונה מוכן לשקול. ריק = לא הגביל.
  propertyTypes   String[]  @default([]) @map("property_types")
  /// שטח מינימלי במ״ר. אינו מזהה איש, ופוסל חצי מההצעות עוד לפניהן.
  areaSqmMin      Int?      @map("area_sqm_min")
  // טווח מעוגל ל-100 אלף ₪ — אנונימיזציה אמיתית, לא הסתרה.
  // המקסימום כלפי מעלה והמינימום כלפי מטה, כדי שהעיגול תמיד ירחיב
  // את הטווח ולא יצמצם אותו: הצעה שנפסלת בגלל עיגול היא עסקה שאבדה.
  budgetMinAgorot BigInt?   @map("budget_min_agorot")
  /// `null` = הביקוש פורסם בלי תקציב — ראו `Buyer.budgetMaxAgorot`.
  /// הלוח מציג "תקציב לא צוין" ולא "עד 0 ₪".
  budgetMaxAgorot BigInt?   @map("budget_max_agorot")
  roomsMin        Decimal?  @map("rooms_min") @db.Decimal(4, 1)
  roomsMax        Decimal?  @map("rooms_max") @db.Decimal(4, 1)
  /// מתי הקונה צריך להיכנס — `immediate | by_date | flexible`.
  entryType       String?   @map("entry_type") @db.VarChar(20)
  entryBy         DateTime? @map("entry_by") @db.Date
  /// מצב המימון והבשלות. לא מזהים איש, ומספרים לצד השני אם שווה
  /// להשקיע נכס ולחכות לתשובה — בדיוק מה שחסר בהצעות באוויר.
  financing       String?   @db.VarChar(20)
  maturity        String?   @db.VarChar(20)
  /// אזורי החיפוש שסומנו על המפה — נקודה, רדיוס ותווית.
  /// מתאר איפה הלקוח מחפש לקנות, לא איפה הוא גר.
  searchAreas     Json      @default("[]") @map("search_areas")
  mustFeatures    String[]  @map("must_features")
  /// מאפייני עדיפות — לא פוסלים, אבל מבדילים בין שתי הצעות דומות.
  niceFeatures    String[]  @default([]) @map("nice_features")
  notes           String?   @db.VarChar(300)
  status          String    @default("active") @db.VarChar(20) // active | closed
  /// אחוז העמלה שהמשרד **המשתף** לוקח; לצד השני נשאר המשלים.
  /// נקבע ברגע השיתוף ולא בסופו — מו"מ אחרי שהקונה התעניין הוא
  /// המקום שבו שיתופי פעולה נשברים. מינימום 33% לכל צד.
  ///
  /// זו ה**כותרת**: המספר שהצעה, הצעה נגדית וחדר עסקה נושאים. הוא
  /// נגזר מהצד שהמשרד המפרסם מחזיק (כאן — צד הקונה), והתנאים
  /// המלאים חיים בארבעת השדות שאחריו.
  commissionSplit Int       @default(50) @map("commission_split") @db.SmallInt
  /// חלוקת דמי התיווך שהקונה משלם, ובנפרד אלה שהמוכר משלם.
  ///
  /// בעסקת תיווך יש שני תשלומים ולא אחד, ומספר יחיד לא ידע לבטא את
  /// ההסדר הנפוץ ביותר — „כל צד גובה מהלקוח שלו”. אחוז, או `null`
  /// עם ניסוח ב-`...Note` כשהחלוקה אינה אחוז בכלל.
  ///
  /// שניהם `null` = פרסום שקדם להפרדה, ואז `commissionSplit` הוא
  /// החלוקה בשני הצדדים — לא השלמה אלא בדיוק מה שהוא אמר.
  buyerSplit      Int?      @map("buyer_split") @db.SmallInt
  buyerSplitNote  String?   @map("buyer_split_note") @db.VarChar(200)
  sellerSplit     Int?      @map("seller_split") @db.SmallInt
  sellerSplitNote String?   @map("seller_split_note") @db.VarChar(200)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, dealType, budgetMaxAgorot])
  @@index([tenantId, status])
  @@map("shared_demands")
}

// נכס שפורסם לרשת — **הכיוון השני של אותה רשת.**
//
// עד כה רק קונים התפרסמו: משרד יכול היה לומר "יש לי קונה, למי יש
// נכס", ולא "יש לי נכס, למי יש קונה". התוצאה היא שחצי מהשוק לא
// נפגש — משרד עם נכס תקוע ומשרד עם קונה מתאים לא ידעו זה על זה
// אלא אם הראשון במקרה גלל את הפיד.
//
// אותה חשיפה מדורגת כמו בביקוש: אזור, סוג, חדרים, שטח, קומה, מצב,
// מחיר ומועד כניסה — **בלי רחוב, בלי מספר בית ובלי בעלים.** המחיר
// כאן מדויק ולא מעוגל, בשונה מתקציב הקונה: תקציב הוא מידע פרטי של
// אדם, ומחיר מבוקש הוא מה שהמוכר מפרסם ממילא.
model SharedListing {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  originPropertyId String    @map("origin_property_id") @db.Char(26)
  city             String?   @db.VarChar(80)
  neighborhood     String?   @db.VarChar(80)
  propertyType     String?   @map("property_type") @db.VarChar(30)
  dealType         String?   @map("deal_type") @db.VarChar(10)
  rooms            Decimal?  @db.Decimal(4, 1)
  areaSqm          Int?      @map("area_sqm")
  floor            Int?
  totalFloors      Int?      @map("total_floors")
  condition        String?   @db.VarChar(20)
  priceAgorot      BigInt?   @map("price_agorot")
  entryType        String?   @map("entry_type") @db.VarChar(20)
  entryDate        DateTime? @map("entry_date") @db.Date
  /// מאפיינים שיש בנכס, כולל המותאמים שהמשרד הוסיף (`custom:`).
  features         String[]  @default([])
  /// הכותרת השיווקית והתיאור החופשי שהמשרד המפרסם כותב.
  title            String?   @db.VarChar(160)
  notes            String?   @db.VarChar(300)
  /// תמונות הנכס — מפתחות S3, נחתמים בזמן הצפייה.
  /// אינן מרחיבות את מה שנחשף: הכתובת המדויקת והבעלים אינם כאן.
  photoKeys        String[]  @default([]) @map("photo_keys")
  /// מיקום מקורב — לחישוב מרחק מול אזורי החיפוש של הקונה.
  /// מעוגל בשמירה, כדי שלא יהיה אפשר לגזור ממנו כתובת מדויקת.
  latitude         Float?
  longitude        Float?
  status           String    @default("active") @db.VarChar(20) // active | closed
  /// אחוז העמלה שהמשרד **המפרסם** לוקח; לצד השני נשאר המשלים.
  ///
  /// זו ה**כותרת**, כמו בביקוש: המספר שההצעה וחדר העסקה נושאים.
  /// כאן הוא נגזר מצד המוכר — זה הצד שהמשרד המפרסם מחזיק.
  commissionSplit  Int       @default(50) @map("commission_split") @db.SmallInt
  /// חלוקה נפרדת לכל צד — ראו `SharedDemand`, אותה סמנטיקה בדיוק.
  buyerSplit       Int?      @map("buyer_split") @db.SmallInt
  buyerSplitNote   String?   @map("buyer_split_note") @db.VarChar(200)
  sellerSplit      Int?      @map("seller_split") @db.SmallInt
  sellerSplitNote  String?   @map("seller_split_note") @db.VarChar(200)
  /// הסוכן שפרסם — הבעלים של **תנאי הפרסום**.
  ///
  /// חלוקת העמלה היא התחייבות כלפי משרדים אחרים, ולכן היא אינה
  /// אמורה להיות ניתנת לשינוי בידי כל סוכן במשרד. אצל הקונה הכלל
  /// נגזר מ-`Buyer.ownerUserId`; לנכס אין בעלים ברמת הסוכן — נכסים
  /// גלויים לכל המשרד בכוונה — ולכן הבעלות היא של מי שקבע את
  /// התנאים. `null` = פרסום שקדם לעמודה, ניתן לעריכה בידי מנהל.
  createdBy        String?   @map("created_by") @db.Char(26)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, dealType, priceAgorot])
  @@index([tenantId, status])
  @@map("shared_listings")
}

// "יש לי קונה לנכס שלך" — התמונה המשלימה ל-CoopOffer.
//
// אותו דגם בדיוק: גלוי לשתי הסוכנויות בלבד, צילום מדורג של הקונה
// בלי שם ובלי טלפון, וחיבור שנפתח רק כששני הצדדים מאשרים.
model CoopInterest {
  id              String   @id @db.Char(26)
  listingId       String   @map("listing_id") @db.Char(26)
  fromTenantId    String   @map("from_tenant_id") @db.Char(26)
  toTenantId      String   @map("to_tenant_id") @db.Char(26)
  buyerId         String   @map("buyer_id") @db.Char(26)
  /// Snapshot מדורג של הקונה — בלי שם, טלפון או אימייל
  presentation    Json     @default("{}")
  status          String   @default("sent") @db.VarChar(20) // sent | interested | declined
  creditsCost     Int      @default(0) @map("credits_cost")
  /// אחוז העמלה שהמשרד **המפרסם** לוקח. נגזר מהפרסום כברירת מחדל,
  /// וניתן להצעה נגדית — כמו בכיוון השני.
  commissionSplit Int      @default(50) @map("commission_split") @db.SmallInt
  /// הסוכן שהציע — מי לדבר איתו בחדר העסקה שייפתח.
  /// `null` = פנייה שקדמה לעמודה; החדר נופל לבעל המשרד.
  createdBy       String?  @map("created_by") @db.Char(26)
  /// מה שהמשרד הדוחה כתב למציע — מדוע הקונה אינו מתאים.
  declineNote     String?  @map("decline_note") @db.VarChar(300)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([listingId, buyerId])
  @@index([toTenantId, status, createdAt])
  @@index([fromTenantId, createdAt])
  @@map("coop_interests")
}

// הצעת נכס לביקוש רשת: גלויה לשתי הסוכנויות בלבד (RLS דו-צדדי).
// חשיפה מדורגת — אזור ומאפיינים בלבד; כתובת מלאה רק אחרי אישור חיבור.
model CoopOffer {
  id              String   @id @db.Char(26)
  demandId        String   @map("demand_id") @db.Char(26)
  fromTenantId    String   @map("from_tenant_id") @db.Char(26)
  toTenantId      String   @map("to_tenant_id") @db.Char(26)
  propertyId      String   @map("property_id") @db.Char(26)
  // Snapshot מדורג של הנכס — בלי כתובת מדויקת ובלי פרטי בעלים
  presentation    Json     @default("{}")
  status          String   @default("sent") @db.VarChar(20) // sent | interested | declined
  creditsCost     Int      @default(1) @map("credits_cost")
  /// אחוז העמלה שהמשרד **המציע** לוקח. נגזר מהביקוש כברירת מחדל,
  /// וניתן להצעה נגדית — החלוקה היא הצעה עד שהצד השני מסכים.
  commissionSplit Int      @default(50) @map("commission_split") @db.SmallInt
  /// הסוכן שהציע — מי לדבר איתו בחדר העסקה שייפתח.
  /// `null` = הצעה שקדמה לעמודה; החדר נופל לבעל המשרד.
  createdBy       String?  @map("created_by") @db.Char(26)
  /// מה שהמשרד הדוחה כתב למציע — מדוע הנכס אינו מתאים לקונה.
  declineNote     String?  @map("decline_note") @db.VarChar(300)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([demandId, propertyId])
  @@index([toTenantId, status, createdAt])
  @@index([fromTenantId, createdAt])
  @@map("coop_offers")
}

// חדר העסקה — סביבת העבודה המשותפת שנפתחת כששני המשרדים הסכימו.
//
// עד כאן החיבור נגמר בסטטוס `interested` ושני המשרדים נשארו בלי דרך
// לעבוד יחד: לא ידעו מי הסוכן שמולם, לא היה איפה לתאם סיור, ומי
// שהמשיך עשה זאת בוואטסאפ — מחוץ למערכת ובלי שהמשרד יודע מה קרה עם
// הנכס שלו. החדר הוא מה שהמייל על הצעת נכס כבר הבטיח במפורש
// ("אישור החיבור במסך פותח את הקשר בין שני המשרדים").
//
// **מה נחשף כאן ומה לא:** הסוכנים משני הצדדים — שם, טלפון ואימייל —
// והכתובת המדויקת של הנכס לצד שמביא את הקונה. פרטי הלקוחות נשארים
// אצל המשרד שהביא אותם, גם אחרי החיבור: זה בדיוק מה ששיתוף פעולה
// בין מתווכים הוא, ומשרד שמקבל את הקונה של עמיתו כבר אינו שותף אלא
// מחליף.
//
// RLS דו-צדדי כמו coop_offers/coop_interests, ומאותה סיבה.
model CoopDeal {
  id              String    @id @db.Char(26)
  /// מאיזה חיבור נולד החדר — `offer` (הצעת נכס לביקוש) או
  /// `interest` (הצעת קונה לנכס). המזהה ייחודי: לחיצה שנייה על
  /// "מעניין" מחזירה את החדר הקיים ולא פותחת שני חדרים לאותה עסקה.
  originType      String    @map("origin_type") @db.VarChar(10)
  originId        String    @unique @map("origin_id") @db.Char(26)
  /// המשרד שהנכס שלו. `propertyId` חי אצלו ולא אצל הצד השני.
  listingTenantId String    @map("listing_tenant_id") @db.Char(26)
  /// המשרד שהקונה שלו. `buyerId` חי אצלו.
  buyerTenantId   String    @map("buyer_tenant_id") @db.Char(26)
  propertyId      String    @map("property_id") @db.Char(26)
  buyerId         String    @map("buyer_id") @db.Char(26)
  /// הסוכנים בפועל — מי לדבר איתו. `null` כשהכרטיס בצד ההוא אינו
  /// משויך לסוכן; אז המסך נופל לבעל המשרד, כמו במיילים של הרשת.
  listingUserId   String?   @map("listing_user_id") @db.Char(26)
  buyerUserId     String?   @map("buyer_user_id") @db.Char(26)
  /// אחוז העמלה של **צד הנכס**, מצולם ברגע ההסכמה. אותו כיוון כמו
  /// בפרסום ובהצעה, ולא נגזר מחדש: תנאים שהשתנו בפרסום אחרי
  /// שהעסקה כבר רצה אינם משנים עסקה שרצה.
  commissionSplit Int       @map("commission_split") @db.SmallInt
  /// שלב העסקה — ראו COOP_DEAL_STAGES ב-packages/shared.
  stage           String    @default("contact") @db.VarChar(20)
  /// למה נסגרה, כשנסגרה. חופשי, ונכתב בידי הצד שסגר.
  closedNote      String?   @map("closed_note") @db.VarChar(200)
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([listingTenantId, stage, updatedAt])
  @@index([buyerTenantId, stage, updatedAt])
  @@map("coop_deals")
}

// שרשור החדר: מה שנכתב ומה שקרה, ברצף אחד.
//
// טבלה אחת לשני הסוגים ולא שתיים — הסיפור של העסקה כרונולוגי, ושתי
// רשימות שצריך למזג בעין הן בדיוק מה שמייצר את השאלה "מתי עברנו
// למו"מ?". Append-only: אין פוליסת UPDATE, ומשרד אינו יכול לשכתב
// למפרע מה נאמר בחדר שהצד השני קרא.
model CoopDealMessage {
  id             String   @id @db.Char(26)
  dealId         String   @map("deal_id") @db.Char(26)
  /// **המשרד שכתב — לא מפתח בידוד.**
  ///
  /// העמודה נקראת `author_tenant_id` ולא `tenant_id` בכוונה: בכל
  /// שאר המערכת `tenant_id` פירושו "השורה שייכת לדייר הזה בלבד",
  /// וכאן ההפך הוא הנכון — שני המשרדים אמורים לראות את מה שהשני
  /// כתב. השם הישן היה גורר את הטבלה לסוויטת ה-Cross-Tenant
  /// כטבלה מבודדת, ושם היא הייתה נראית כדליפה בעודה מתפקדת נכון.
  ///
  /// הבידוד עצמו נגזר מהחדר (`EXISTS` על `coop_deals`), ולא מכאן.
  authorTenantId String   @map("author_tenant_id") @db.Char(26)
  userId         String?  @map("user_id") @db.Char(26)
  /// `message` = מישהו כתב; `event` = משהו קרה (מעבר שלב, פתיחה).
  kind           String   @default("message") @db.VarChar(20)
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([dealId, createdAt])
  @@map("coop_deal_messages")
}

// הפניית לקוח בין משרדים: בלוח רק מידע אנונימי (כוונה, מקור, עיר,
// סיבה, הערה); פרטי הקשר הם צילום מוצפן שמועתק למשרד הקולט רק אחרי
// הקליטה. אותו דגם RLS כמו shared_demands — בעלות מלאה למשרד המפנה,
// קריאת רשת להפניות פעילות, וקריאה למשרד שקלט את ההפניה.
model SharedLead {
  id                    String    @id @db.Char(26)
  tenantId              String    @map("tenant_id") @db.Char(26)
  originLeadId          String    @map("origin_lead_id") @db.Char(26)
  source                String    @db.VarChar(20)
  intent                String    @db.VarChar(20)
  /// ללידים אין עמודת עיר — המשרד המפנה מזין ידנית כדי שהלוח יהיה שמיש
  city                  String?   @db.VarChar(120)
  note                  String?   @db.VarChar(300)
  /// למה הלקוח מופנה. חובה בפרסום; הפניות שקדמו לשדה נושאות
  /// unspecified ומוצגות ככאלה, ולא כאילו נבחרה סיבה.
  reason                String    @default("unspecified") @db.VarChar(30)
  /// פירוט חופשי לצד הסיבה — חובה כשהסיבה היא "אחר"
  reasonDetail          String?   @map("reason_detail") @db.VarChar(200)
  /// **הצהרת המשרד המפנה על איכות הלקוח**, ברגע הפרסום:
  /// `{ "seriousness": 4, "budget": 5, ... }` לפי
  /// `CLIENT_RATING_DIMENSIONS`.
  ///
  /// יושבת על ההפניה ולא בטבלת הדירוגים משום שהיא **חלק מהמודעה**:
  /// היא מוצגת בלוח לפני התשלום, וזה כל תפקידה. אחרי הקליטה המשרד
  /// הקולט מאשר את אותם ממדים, והפער בין השניים הוא המוניטין
  /// (packages/shared/logic/lead-referral.ts — declarationAccuracy).
  ///
  /// הפניות שקדמו לשדה נושאות `{}` ומוצגות כ"ללא הצהרה" — ולא
  /// כהצהרה שכל ממדיה אפס.
  clientScores          Json      @default("{}") @map("client_scores")
  /// צילום איש הקשר במפתח ההצפנה האפליקטיבי (אחיד לכל הדיירים) —
  /// לכן המשרד הקולט מקבל עותק בלי פענוח ביניים. לעולם לא מוחזר בלוח.
  contactNameEncrypted  String    @map("contact_name_encrypted") @db.Text
  contactPhoneEncrypted String    @map("contact_phone_encrypted") @db.Text
  contactPhoneHash      String    @map("contact_phone_hash") @db.Char(64)
  /// התמורה שהמשרד המפנה ביקש. נקבעת ברגע הפרסום ולא ברגע הקליטה —
  /// המשרד הקולט משלם את מה שראה בלוח.
  priceCredits          Int       @map("price_credits")
  /// עמלת הפלטפורמה בקרדיטים, מצולמת אף היא ברגע הפרסום: שינוי
  /// שיעור העמלה לא משנה הפניה שכבר פורסמה. הזיכוי למפנה הוא
  /// priceCredits פחות העמודה הזו (packages/shared/logic/lead-referral.ts).
  /// 0 בהפניות שקדמו לעמלה — היסטורית זה נכון.
  platformFeeCredits    Int       @default(0) @map("platform_fee_credits")
  /// credits | cash — מה המשרד המפנה בחר לקבל, ברגע הפרסום.
  /// הקונה משלם אותו דבר בשני המסלולים; ההפרש הוא בין מה שהמוכר
  /// מקבל לבין מה שהפלטפורמה שומרת (packages/shared — credit-economy).
  payoutMode            String    @default("credits") @map("payout_mode") @db.VarChar(10)
  /// **התמורה עצמה**, מצולמת ברגע הפרסום — ולא נגזרת מחדש בקליטה.
  /// עד כה הקליטה חישבה priceCredits פחות העמלה, ולכן הבונוס על
  /// בחירת קרדיטים חושב בפרסום ומעולם לא שולם. 0 במסלול הכסף.
  payoutCredits         Int       @default(0) @map("payout_credits")
  /// אותו דבר במסלול הכסף, באגורות. 0 במסלול הקרדיטים.
  payoutAgorot          Int       @default(0) @map("payout_agorot")
  status                String    @default("active") @db.VarChar(20) // active | sold | withdrawn
  buyerTenantId         String?   @map("buyer_tenant_id") @db.Char(26)
  soldAt                DateTime? @map("sold_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([buyerTenantId, soldAt])
  @@map("shared_leads")
}

// **אישור המשרד הקולט** על הצהרת המפנה.
//
// שורה אחת בלבד לכל הפניה, ושייכת תמיד לקולט: המפנה כבר אמר את
// שלו ב-`shared_leads.client_scores` ברגע הפרסום, וזה חלק מהמודעה
// ולא דירוג. כאן נשמר מה שהתברר בפועל, ומהפער בין השניים נגזר
// המוניטין (packages/shared/logic/lead-referral.ts).
//
// עד לגרסה הזו הטבלה החזיקה גם דירוג של המפנה על הקולט. הוא לא
// נמדד מול דבר ולא הוצג לאיש מחוץ לשני הצדדים — כלומר עמודה
// שנכתבה ולא נקראה.
model LeadReferralRating {
  id             String   @id @db.Char(26)
  sharedLeadId   String   @map("shared_lead_id") @db.Char(26)
  /// שני הצדדים נשמרים על השורה — הם המפתח של ה-RLS: אישור נראה
  /// לשני הצדדים להפניה בלבד, לעולם לא לרשת.
  sellerTenantId String   @map("seller_tenant_id") @db.Char(26)
  buyerTenantId  String   @map("buyer_tenant_id") @db.Char(26)
  raterTenantId  String   @map("rater_tenant_id") @db.Char(26)
  /// מה שהקולט מצא בפועל, באותם ממדים שהמפנה הצהיר עליהם:
  /// `{ "seriousness": 3, "budget": 4 }`.
  scores         Json     @default("{}")
  /// **דיוק ההצהרה** בעשיריות (45 = 4.5) — לא איכות הלקוח.
  ///
  /// נגזר בשרת מהפער בין ההצהרה לאישור ואינו מתקבל מהמסך. שלם ולא
  /// עשרוני כי הוא נצבר ב-`referral_reputation.rating_sum` בדלתאות,
  /// וצבירה של מספרים עשרוניים אינה מדויקת.
  scoreTenths    Int      @map("score_tenths") @db.SmallInt
  comment        String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([sharedLeadId, raterTenantId])
  @@index([sellerTenantId, createdAt])
  @@map("lead_referral_ratings")
}

// מוניטין ההפניות של משרד — סכום ומונה בלבד.
// טבלה נפרדת ולא צבירה מעל lead_referral_ratings: הלוח מציג את
// המוניטין של כל משרד מפנה לכל הרשת, וטבלת האישורים מכילה הערות
// חופשיות שמשרד כתב על משרד. מספרים אפשר לחשוף לרשת; טקסט לא.
model ReferralReputation {
  tenantId    String   @id @map("tenant_id") @db.Char(26)
  /// כמה משרדים קולטים אישרו הפניות של המשרד הזה
  ratingCount Int      @default(0) @map("rating_count")
  /// סכום **ציוני הדיוק** בעשיריות — ראו `LeadReferralRating.scoreTenths`
  ratingSum   Int      @default(0) @map("rating_sum")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("referral_reputation")
}

/// אותו מוניטין, **מפורק לממדים** — רצינות, תקציב, דחיפות, זמינות.
///
/// ממוצע אחד מסתיר את ההבדל בין משרד שסוטה מעט בכל ממד לבין משרד
/// שמדייק לחלוטין ברוב הממדים ומנפח בשיטתיות את התקציב. לקורא
/// שעומד לשלם עמלת הפניה זו אינה אותה עסקה.
///
/// טבלה נפרדת ולא JSONB על `referral_reputation`: הצבירה היא
/// בדלתאות (`+= delta`), וזה `INSERT ... ON CONFLICT DO UPDATE`
/// פשוט על שורה, לעומת בנייה מחדש של אובייקט JSON בכל אישור.
///
/// שורה נוצרת רק לממד ש**שני הצדדים** דירגו — ראו
/// `dimensionAccuracies`. ממד שאיש לא נגע בו פשוט אינו קיים כאן,
/// ולכן היעדר שורה אינו "ציון אפס".
model ReferralReputationDimension {
  tenantId    String   @map("tenant_id") @db.Char(26)
  /// מפתח מ-`CLIENT_RATING_DIMENSIONS` — seriousness, budget…
  dimension   String   @db.VarChar(20)
  ratingCount Int      @default(0) @map("rating_count")
  /// סכום ציוני הדיוק בעשיריות, כמו ב-`referral_reputation`
  ratingSum   Int      @default(0) @map("rating_sum")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([tenantId, dimension])
  @@map("referral_reputation_dimensions")
}

// ספר קרדיטים Append-Only (docs/03 §3): היתרה נגזרת, לא מאוחסנת.
//
// תפוגה נכתבת כתנועה רגילה: kind='expiry', amount שלילי, ו-ref_id
// שמצביע על התנועה החיובית (המנה) שפגה. המנות עצמן משוחזרות מהספר
// בזמן ריצה — ראו packages/shared/logic/credit-expiry.ts.
//
// למיגרציה 20260815100000 יש אינדקס ייחודי **חלקי** על ref_id עבור
// kind='expiry', שאינו ניתן לביטוי בסכמה של Prisma. הוא מונע הפקעה
// כפולה של אותה מנה בשני עותקי API במקביל, ואסור למחוק אותו.
/// חשבון הקרדיטים של הפלטפורמה — Append-Only, כמו שני הספרים האחרים.
///
/// עמלת ההפניה חושבה ונשמרה על שורת ההפניה, אבל לא נזקפה לשום ספר —
/// היא הייתה ההפרש בין מה שהקולט חויב למה שהמפנה זוכה. לא היה מקום
/// להסתכל בו כדי לדעת כמה הפלטפורמה הרוויחה מהפניות.
///
/// **בלי tenant_id ובלי RLS** — כמו plans, coupons ו-platform_settings.
/// לפלטפורמה אין דייר, ו-`source_tenant_id` הוא לדוח בלבד.
model PlatformCreditLedger {
  id               String   @id @db.Char(26)
  /// referral_fee | burn | adjustment
  kind             String   @db.VarChar(30)
  /// חיובי = נזקף לפלטפורמה, שלילי = נמחק ממנה
  amount           Int
  /// ההכנסה שהוכרה בשורה. אפס בכל שורה שאינה מחיקה.
  recognizedAgorot Int      @default(0) @map("recognized_agorot")
  /// מחיר הקרדיט ברגע המחיקה, מצולם — המחיר משתנה מהמסך, ובלי צילום
  /// כל שינוי תמחור היה משכתב את הדוח למפרע.
  unitPriceAgorot  Int      @default(0) @map("unit_price_agorot")
  /// הצד היקר של אותה הפניה, מצולם על אותה שורה.
  ///
  /// הבונוס הוא קרדיטים חדשים שנוצרו יש מאין, והמזומן הוא כסף שיצא.
  /// שניהם יושבים על `shared_leads` — טבלה תחת RLS שאין לפלטפורמה
  /// דרך חוקית לקרוא ממנה חוצה-דיירים. ניסיון כזה מחזיר אפס שורות
  /// **בשקט**, כלומר דוח שמראה 0 בכל שורה ונראה תקין לגמרי.
  bonusCredits     Int      @default(0) @map("bonus_credits")
  cashPaidAgorot   Int      @default(0) @map("cash_paid_agorot")
  /// מאיזה משרד הגיעה העמלה — לדוח, לא לבידוד
  sourceTenantId   String?  @map("source_tenant_id") @db.Char(26)
  refId            String?  @map("ref_id") @db.Char(26)
  note             String?  @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("platform_credit_ledger")
}

model CreditLedger {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  kind      String   @db.VarChar(30) // initial_grant | coop_offer | purchase | refund | lead_purchase | lead_sale | expiry
  amount    Int // חיובי = זיכוי, שלילי = חיוב
  refId     String?  @map("ref_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("credit_ledger")
}

/// הספר הכספי — Append-Only, אגורות. היתרה נגזרת מהסכום.
///
/// ספר נפרד מ-credit_ledger: קרדיט הוא אמצעי תשלום פנימי, ושקל הוא
/// התחייבות של הפלטפורמה כלפי המשרד. ערבובם באותו מספר היה הופך כל
/// בונוס בקרדיטים לחוב כספי.
model PayoutLedger {
  id           String   @id @db.Char(26)
  tenantId     String   @map("tenant_id") @db.Char(26)
  /// lead_sale | withdrawal | withdrawal_reversed
  kind         String   @db.VarChar(30)
  /// חיובי = זיכוי למשרד, שלילי = משיכה
  amountAgorot Int      @map("amount_agorot")
  refId        String?  @map("ref_id") @db.Char(26)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("payout_ledger")
}

/// בקשת משיכה של יתרה כספית.
///
/// פרטי הבנק מוצפנים באותו מפתח אפליקטיבי כמו PII של לקוחות, ויושבים
/// על **הבקשה** ולא על המשרד: חשבון שמשתנה בין בקשות הוא מידע
/// היסטורי שחייב להישמר — אחרי העברה שיצאה לחשבון הלא נכון, השאלה
/// היחידה שחשובה היא לאן בדיוק שלחנו אז.
model PayoutRequest {
  id                     String    @id @db.Char(26)
  tenantId               String    @map("tenant_id") @db.Char(26)
  amountAgorot           Int       @map("amount_agorot")
  /// pending | approved | paid | rejected
  status                 String    @default("pending") @db.VarChar(20)
  holderNameEncrypted    String    @map("holder_name_encrypted")
  bankCodeEncrypted      String    @map("bank_code_encrypted")
  branchEncrypted        String    @map("branch_encrypted")
  accountNumberEncrypted String    @map("account_number_encrypted")
  businessIdEncrypted    String    @map("business_id_encrypted")
  note                   String?   @db.VarChar(300)
  requestedBy            String    @map("requested_by") @db.Char(26)
  decidedAt              DateTime? @map("decided_at")
  decidedBy              String?   @map("decided_by") @db.Char(26)
  decisionNote           String?   @map("decision_note") @db.VarChar(300)
  /// אסמכתת ההעברה בבנק. בלעדיה "שולם" הוא אמירה בלי גיבוי.
  reference              String?   @db.VarChar(120)
  paidAt                 DateTime? @map("paid_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("payout_requests")
}

// כל הודעה יוצאת/נכנסת בכל ערוץ — הבסיס ל-Messaging Hub (docs/03 §3).
model Message {
  id                String   @id @db.Char(26)
  tenantId          String   @map("tenant_id") @db.Char(26)
  contactId         String?  @map("contact_id") @db.Char(26)
  offerId           String?  @map("offer_id") @db.Char(26)
  direction         String   @db.VarChar(5) // in | out
  channel           String   @db.VarChar(20) // whatsapp | sms | email
  provider          String   @db.VarChar(30) // walink | cloud_api | ...
  body              String   @db.VarChar(4000)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(120)
  status            String   @default("sent") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, offerId])
  @@map("messages")
}

/// שיחת הסוכן האישי בוואטסאפ — שורה אחת למתווך (docs/05 §1).
/// מחזיקה את ההצעה שממתינה ל"אשר", את התורות האחרונים (זיכרון
/// השיחה) ואת מזהי ההודעות שכבר טופלו (Meta שולח כפולים). יושבת
/// תחת RLS כי ההצעה וההיסטוריה מכילות שמות ופרטים של לקוחות קצה.
model WhatsAppChat {
  id                String    @id @db.Char(26)
  tenantId          String    @map("tenant_id") @db.Char(26)
  userId            String    @map("user_id") @db.Char(26)
  /// ההצעה שממתינה לאישור + התמלול שהוליד אותה. null = אין ממתינה
  pending           Json?
  /// תורות שבוצעו בפועל (AgentHistoryTurn), עד 4 — למשפטי המשך
  history           Json      @default("[]")
  /// מזהי ההודעות האחרונות שטופלו — Idempotency מול משלוח כפול
  handledIds        Json      @default("[]") @map("handled_ids")
  /**
   * מתי המתווך כתב לסוכן לאחרונה — פתיחת חלון 24 השעות של Meta.
   * הודעה יזומה (התראה) מותרת בטקסט חופשי רק בתוך החלון; מחוצה לו
   * נדרשת תבנית מאושרת. בלי החותמת הזו כל דחיפה הייתה יוצאת אל
   * דחייה של Meta, ואנחנו היינו לומדים על הכלל מהשגיאה.
   */
  lastInboundAt     DateTime? @map("last_inbound_at")
  /**
   * עד מתי המשתמש הזה כבר קיבל התראות בוואטסאפ.
   * הסימון על ההתראה עצמה (`notifications.whatsapp_at`) אינו מספיק:
   * התראה משרדית הולכת לכמה סוכנים, וכשאחד קיבל והשני נכשל היא
   * נשארת בלי סימון — ואז מי שכבר קיבל אותה מקבל אותה שוב בכל
   * סריקה (ביקורת Codex). החותמת פר-משתמש היא מה שהופך את הניסיון
   * החוזר לאישי.
   */
  notifiedThrough   DateTime? @map("notified_through")
  /**
   * „שקט לשעתיים” — הכפתור שמשתיק עדכונים יזומים לזמן קצוב.
   * הוא נפרד משעות השקט הקבועות: אלה הרגל, וזה רגע — פגישה, נהיגה,
   * ארוחת ערב. בלעדיו הבחירה היחידה של מי שמוצף היא לכבות הכול
   * בפרופיל, ומי שכיבה בדרך כלל אינו חוזר להדליק.
   */
  notifySnoozeUntil DateTime? @map("notify_snooze_until")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@map("whatsapp_chats")
}

/// קישור מפורש בין מספר וואטסאפ לחשבון — **הזהות בערוץ.**
///
/// הזהות נגזרה עד כה מהשוואת ספרות מול שדה `phone`, כלומר מהנחה ולא
/// מהצהרה: מספר שהוחזר לשוק פותח לבעליו החדש את המאגר, ואותו מספר
/// אצל שני משתמשים הוכרע בשקט לפי „מי התחבר לאחרונה”.
///
/// **אינו תחת RLS למרות ה-tenant_id** — כמו `users`: הוא נקרא בנתיב
/// הציבורי של ה-Webhook, ברגע שבו הדייר עדיין אינו ידוע, והוא עצמו
/// מה שמגלה אותו. הפוליסה הייתה חוסמת את השאילתה שנועדה להכריע.
model WhatsAppLink {
  id            String    @id @db.Char(26)
  /// המספר מוצפן כמו כל PII במנוחה; ה-HMAC לחיפוש
  waIdEncrypted String    @map("wa_id_encrypted") @db.Text
  waIdHash      String    @map("wa_id_hash") @db.Char(64)
  tenantId      String    @map("tenant_id") @db.Char(26)
  userId        String    @map("user_id") @db.Char(26)
  /// `code` = הוכח בקוד; `phone` = נוצר מהשוואה לחשבון יחיד
  source        String    @db.VarChar(10)
  linkedAt      DateTime  @default(now()) @map("linked_at")
  /// מתי מישהו **הוכיח** שהמספר שלו — לא מתי השתמש בו
  verifiedAt    DateTime  @default(now()) @map("verified_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  /// מנותק ולא נמחק: „היה ונותק” הוא מידע שהמתווך צריך לראות
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(20)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_links")
}

/// מספר שכתב לסוכן ואינו מזוהה כמשתמש — מתעניין, לא לקוח.
///
/// **אינו נתון דייר ולכן אין כאן tenant_id**: מי שכותב עדיין אינו
/// שייך לאף משרד, וזו בדיוק הסיבה שהוא כאן. השורה קיימת כדי שהמענה
/// השיווקי יישלח פעם אחת ולא בכל הודעה — שליחה חוזרת היא ספאם,
/// ומספר עסקי שמדווח כספאם מאבד את דירוג האיכות שלו אצל Meta.
model WhatsAppProspect {
  id             String    @id @db.Char(26)
  /// המספר מוצפן, כמו כל PII במנוחה (docs/04 §PII); ה-hash לחיפוש
  phoneEncrypted String    @map("phone_encrypted") @db.Text
  phoneHash      String    @unique @map("phone_hash") @db.Char(64)
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @updatedAt @map("last_seen_at")
  /// מתי נשלח המענה האחרון. null = טרם נענה.
  repliedAt      DateTime? @map("replied_at")
  /// כמה הודעות הגיעו ממנו — עוצמת העניין, לצוות המכירות
  messages       Int       @default(0)

  @@map("whatsapp_prospects")
}

/// יומן משימות הסוכן — כל פירוש (משפט ⟵ פעולה ושדות) וכל ביצוע,
/// משני הערוצים (דפדפן ווואטסאפ). שתי מטרות: מדידת עלות אמיתית
/// לכל פקודה (אסימונים כפי ש-Google דיווחה), ודאטה לאימון מודל
/// ייעודי בהמשך. תחת RLS מלא — התמלולים הם נתוני דייר לכל דבר.
model AgentEvent {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  userId     String   @map("user_id") @db.Char(26)
  channel    String   @db.VarChar(20) // web | whatsapp
  kind       String   @db.VarChar(20) // interpret | execute
  transcript String?  @db.VarChar(4000)
  actionId   String?  @map("action_id") @db.VarChar(40)
  /// interpret: הפירוש המלא (שדות, ראיות, צעדים); execute: פרמטרים ותקציר תוצאה
  payload    Json
  /// llm | rules | blocked — מי הכריע בפועל (interpret בלבד)
  source     String?  @db.VarChar(10)
  model      String?  @db.VarChar(60)
  latencyMs  Int?     @map("latency_ms")
  /// צריכת אסימונים כפי ש-Google דיווחה — קלט/פלט/חשיבה/מטמון
  usage      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  /// FK עם Cascade — לא רק סדר: הרישום הוא fire-and-forget, ולכן
  /// כתיבה מאוחרת יכולה לנחות **אחרי** שמחיקת החשבון כבר רצה. בלי
  /// האילוץ היא הייתה משאירה תמלול עם PII אחרי שהמחיקה דיווחה
  /// הצלחה; איתו — הכתיבה נדחית במסד ונבלעת (ביקורת Codex).
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("agent_events")
}

// פגישה/סיור/שיחה ביומן (docs/01 §3 Calendar). google_event_id — לסנכרון עתידי.
model Appointment {
  id              String    @id @db.Char(26)
  tenantId        String    @map("tenant_id") @db.Char(26)
  kind            String    @db.VarChar(20) // viewing | meeting | call
  title           String?   @db.VarChar(200)
  leadId          String?   @map("lead_id") @db.Char(26)
  propertyId      String?   @map("property_id") @db.Char(26)
  buyerId         String?   @map("buyer_id") @db.Char(26)
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  status          String    @default("scheduled") @db.VarChar(20) // scheduled | completed | cancelled | no_show
  // תוצאת פולו-אפ אחרי סיור: liked | not_fit | negotiating | needs_other (אפיון §13)
  outcome         String?   @db.VarChar(20)
  notes           String?   @db.VarChar(2000)
  googleEventId   String?   @map("google_event_id") @db.VarChar(120)
  googleSyncedAt  DateTime? @map("google_synced_at")
  /// system = נקבעה כאן | google = נמשכה מהיומן.
  /// בלי ההבחנה הדחיפה החוצה הייתה מחזירה ל-Google אירוע שזה עתה
  /// הגיע ממנו — לולאה שבה כל צד "מעדכן" את השני לנצח.
  syncSource      String    @default("system") @map("sync_source") @db.VarChar(10)
  /// יומן של מי. `createdBy` הוא "מי הקליד" ואינו אותו דבר: פגישה
  /// שמנהל קובע לסוכן צריכה להופיע ביומן של הסוכן.
  ownerUserId     String?   @map("owner_user_id") @db.Char(26)
  /// המועד הקודם, כשהפגישה נדחתה. בלעדיו "נדחתה" אובד ברגע שהשדה
  /// נדרס — והמתווך אינו יודע שהפגישה כבר נדחתה פעמיים, שזה בדיוק
  /// הסימן שהעסקה מתקררת.
  rescheduledFrom DateTime? @map("rescheduled_from")
  rescheduleCount Int       @default(0) @map("reschedule_count") @db.SmallInt
  /// מתי נשלחה התזכורת שלפני הסיור. NULL = טרם נשלחה, ולכן דחיית
  /// הסיור מנקה אותה — המועד החדש מקבל תזכורת משלו.
  reminderSentAt  DateTime? @map("reminder_sent_at")
  createdBy       String?   @map("created_by") @db.Char(26)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, googleEventId])
  @@map("appointments")
}

// משימות ותזכורות (docs/01 — מודול 7): רשימת ה"לעשות" האישית של הסוכן,
// עם תזכורת במועד היעד דרך צינור ההתראות הקיים.
model Task {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  /**
   * הסוכן האחראי. הוא רואה ומנהל אותה; מנהל עם `tasks.view_all`
   * רואה גם את של האחרים.
   */
  assignedToUserId String    @map("assigned_to_user_id") @db.Char(26)
  /**
   * מי הטיל. הפך למידע ברגע שאפשר להטיל על אחר — עד כה הוא היה
   * תמיד זהה ל-assignedToUserId, ולכן לא נשמר.
   */
  createdByUserId  String?   @map("created_by_user_id") @db.Char(26)
  /// low | normal | high
  priority         String    @default("normal") @db.VarChar(10)
  title            String    @db.VarChar(200)
  notes            String?   @db.VarChar(2000)
  dueAt            DateTime? @map("due_at")
  /**
   * דחיפה ליומן Google — מקביל לשדות שעל appointments; null
   * ב-googleSyncedAt פירושו "ממתין לדחיפה" (ראו CalendarSyncService).
   */
  googleEventId    String?   @map("google_event_id") @db.VarChar(255)
  googleSyncedAt   DateTime? @map("google_synced_at")
  /**
   * מחיקה שממתינה לניקוי האירוע ב-Google — ראו TasksService.remove
   */
  deletedAfterSync Boolean   @default(false) @map("deleted_after_sync")
  status           String    @default("open") @db.VarChar(10) // open | done
  /**
   * מתי הושלמה בפועל — ולא `dueAt`, שהוא המועד שנקבע לה.
   * כרטיס „משימות שהושלמו” מבטיח תאריך ושעה של השלמה. `dueAt` היה
   * מציג תאריך **עתידי** על משימה שהושלמה מוקדם, ולא כלום על
   * משימה בלי מועד. `updatedAt` אינו תחליף: עריכה מאוחרת דורסת
   * אותו, ואז הוא מדווח מתי נגעו ולא מתי נגמר.
   * NULL על שורות שקדמו לשדה — לא נרשם, ואינו ניתן לשחזור.
   */
  completedAt      DateTime? @map("completed_at")
  // קישור אופציונלי לישות — "להתקשר לקונה X", "להשלים פרטי נכס Y"
  entityType       String?   @map("entity_type") @db.VarChar(20) // lead | buyer | property
  entityId         String?   @map("entity_id") @db.Char(26)
  // מפתח אידמפוטנטיות למשימות מאירועים — מבחין בין מקורות (נכסים) שונים
  sourceKey        String?   @map("source_key") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, assignedToUserId, status, dueAt])
  @@index([tenantId, entityId, sourceKey])
  /// לוח המשרד: "מה פתוח, לפי מועד" בלי סינון לפי סוכן — האינדקס
  /// הראשון מתחיל ב-assignedToUserId ולכן אינו משמש אותו
  @@index([tenantId, status, dueAt])
  @@map("tasks")
}

/// כלל למשימה אוטומטית קבועה — ברמת המשרד.
///
/// הכלל שייך למשרד; המשימות שנוצרות ממנו שייכות לסוכן. `lastRunAt`
/// הוא המופע האחרון שנוצר בפועל, ו-null פירושו שהכלל טרם רץ — המופע
/// הראשון שלו נמדד מרגע היצירה ולא רטרואקטיבית.
model TaskRecurrence {
  id               String    @id @db.Char(26)
  tenantId         String    @map("tenant_id") @db.Char(26)
  title            String    @db.VarChar(200)
  notes            String?   @db.VarChar(2000)
  /// daily | weekly | monthly
  frequency        String    @db.VarChar(10)
  /// 0 (ראשון) עד 6; ריק = פעם בשבוע ביום שבו נוצר הכלל
  weekdays         Int[]     @db.SmallInt
  /// 31 נופל ליום האחרון בחודש קצר ולא מדלג על החודש
  dayOfMonth       Int?      @map("day_of_month") @db.SmallInt
  hour             Int       @default(9) @db.SmallInt
  minute           Int       @default(0) @db.SmallInt
  /// null = לכל סוכן פעיל במשרד, כל אחד מקבל משימה משלו
  assignedToUserId String?   @map("assigned_to_user_id") @db.Char(26)
  isActive         Boolean   @default(true) @map("is_active")
  lastRunAt        DateTime? @map("last_run_at")
  createdBy        String?   @map("created_by") @db.Char(26)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, lastRunAt])
  @@index([tenantId])
  @@map("task_recurrences")
}

// התראה למתווך: נוצרת ע"י ה-Worker מאירועי דומיין (docs/02 §4 Notifications).
/// שרשור בתיבת התמיכה של הפלטפורמה — פונה אחד ונושא אחד.
///
/// **מחוץ ל-RLS ובלי `tenant_id` חובה**: פנייה לתמיכה יכולה להגיע
/// ממי שאינו לקוח כלל. השיוך למשרד נעשה כשאפשר לזהות לפי כתובת
/// השולח, ונשאר ריק כשלא.
model SupportThread {
  id            String    @id @db.Char(26)
  /// מספר הפנייה כפי שאדם קורא אותו — **רצף משותף עם פניות הכפתור**,
  /// כי מבחינת מי שמטפל זה תור אחד. הוא נדבק לנושא של המייל, ולכן
  /// תשובה שנפתחה כמייל חדש (בלי הטוקן) עדיין מוצאת את דרכה.
  reference     Int       @unique @default(dbgenerated("nextval('support_reference_seq')"))
  /// הטוקן שנשתל בכתובת התשובה — מה שמחזיר את תשובת הפונה לשרשור
  replyToken    String    @unique @map("reply_token") @db.Char(26)
  tenantId      String?   @map("tenant_id") @db.Char(26)
  contactEmail  String?   @map("contact_email") @db.VarChar(254)
  contactName   String    @map("contact_name") @db.VarChar(120)
  subject       String    @db.VarChar(200)
  /// open | in_progress | closed — אותו אוצר מילים כמו פניות הכפתור
  status        String    @default("open") @db.VarChar(20)
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  messages SupportMessage[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([contactEmail, status])
  @@map("support_threads")
}

/// הודעה בשרשור תמיכה — נכנסת מהפונה או יוצאת מהתמיכה.
model SupportMessage {
  id                String   @id @db.Char(26)
  threadId          String   @map("thread_id") @db.Char(26)
  /// in | out
  direction         String   @db.VarChar(3)
  body              String   @db.VarChar(20000)
  fromEmail         String?  @map("from_email") @db.VarChar(254)
  /// דה-דופליקציה מול Webhook שנשלח פעמיים
  providerMessageId String?  @unique @map("provider_message_id") @db.VarChar(200)
  /// pending | sent | failed | unknown — בתשובה יוצאת בלבד
  sendState         String?  @map("send_state") @db.VarChar(10)
  createdBy         String?  @map("created_by") @db.Char(26)
  createdAt         DateTime @default(now()) @map("created_at")

  thread      SupportThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([threadId, createdAt])
  @@map("support_messages")
}

/// קובץ מצורף בפניית תמיכה — צילום מסך הוא הדבר השימושי ביותר שפונה שולח.
model SupportAttachment {
  id          String    @id @db.Char(26)
  messageId   String    @map("message_id") @db.Char(26)
  /// מקומו של הקובץ בהודעה — זהות יציבה שאינה תלויה בניסיון.
  /// שני כותבים מקבילים מחשבים ממנו את אותו מפתח אחסון בדיוק.
  ordinal     Int?
  /// image | video | file
  kind        String    @db.VarChar(10)
  name        String    @db.VarChar(200)
  contentType String    @map("content_type") @db.VarChar(100)
  sizeBytes   Int       @map("size_bytes")
  s3Key       String    @map("s3_key") @db.VarChar(300)
  /// null = השורה נתבעה וטרם הועלתה. השורה נכתבת לפני ההעלאה, ולכן
  /// קיומה אינו מעיד שהאובייקט קיים — וצירוף שטרם הועלה אינו מוצג.
  uploadedAt  DateTime? @map("uploaded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, ordinal])
  @@index([messageId])
  @@map("support_attachments")
}

/// חשבונית מס קבלה על תשלום שנגבה — מסמך אחד לכל תשלום.
///
/// **מחוץ ל-RLS, כמו `payments`**: זו רשומה של הפלטפורמה מול המשרד
/// ולא נתון של המשרד, והיא נשמרת גם אחרי שהמשרד נמחק (מסמך מס
/// בחובת שמירה). אין בה פרט אישי של לקוח קצה.
model Invoice {
  id             String    @id @db.Char(26)
  tenantId       String    @map("tenant_id") @db.Char(26)
  /// ייחודי — מה שהופך את ההפקה לאידמפוטנטית מול וובהוק שחוזר
  paymentId      String    @unique @map("payment_id") @db.Char(26)
  /// הקשר מוצהר כדי שאפשר יהיה לשאול "תשלום ששולם ואין לו מסמך" —
  /// התקלה השקטה שבלי השאילתה הזו אין דרך לראות.
  payment        Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider       String    @default("linet") @db.VarChar(20)
  /// pending | issued | failed
  status         String    @default("pending") @db.VarChar(20)
  /// המזהה אצל הספק — הוא שפותח את המסמך (`/print/doc/{id}`)
  documentId     String?   @map("document_id") @db.VarChar(60)
  /// מספר ההקצאה שמופיע בספרים ובעיני הלקוח
  documentNumber String?   @map("document_number") @db.VarChar(40)
  documentUrl    String?   @map("document_url") @db.VarChar(500)
  /// הסכום שנגבה ופירוקו — נשמרים ולא מחושבים מחדש: שיעור המע"מ
  /// משתנה בחקיקה, ומסמך משנה שעברה חייב להישאר קריא לפי מה שהיה.
  grossAgorot    Int       @map("gross_agorot")
  netAgorot      Int       @map("net_agorot")
  vatAgorot      Int       @map("vat_agorot")
  vatPercent     Int       @map("vat_percent")
  description    String    @db.VarChar(200)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastError      String?   @map("last_error") @db.VarChar(300)
  issuedAt       DateTime? @map("issued_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

model Notification {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  /**
   * נמען ספציפי (התראות אישיות, כמו תזכורת משימה); NULL = כל המשרד.
   */
  userId     String?   @map("user_id") @db.Char(26)
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String?   @db.VarChar(500)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.Char(26)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /**
   * מתי נדחפה כהתראת דפדפן; NULL = טרם נשלחה (הסורק מחפש בדיוק את אלה).
   */
  pushedAt   DateTime? @map("pushed_at")
  /**
   * מתי נשלחה לוואטסאפ — עמודה נפרדת מ-`pushed_at` בכוונה.
   * שני הערוצים עצמאיים: פוש הדפדפן מושבת כשאין מפתחות VAPID,
   * והוואטסאפ מושבת כשאין טוקן. סימון משותף היה גורם לערוץ אחד
   * לבלוע התראות שהשני מעולם לא ראה.
   */
  whatsappAt DateTime? @map("whatsapp_at")
  /**
   * מפתח ייחודיות לאירוע שההתראה מדווחת עליו. NULL = בלי הגנה.
   * ההגנה מפני התראה כפולה אינה יכולה להישען על הרשומה שהאירוע
   * *עתיד* לייצר. מרכזיית 015 שולחת `Calling` פעמיים לאותה שיחה,
   * וההתראה על צלצול נכתבת **לפני** ששורת השיחה נוצרת (היא נוצרת
   * רק בניתוק) — כלומר הבדיקה „האם כבר יש שיחה כזו” חיפשה שורה
   * שבשלב הזה לעולם אינה קיימת, והמתווך קיבל שתי התראות.
   * המפתח מתאר את **האירוע** ולא את הרשומה: `incoming_call:<callid>`.
   * הכתיבה עצמה היא `INSERT ... ON CONFLICT DO NOTHING`, ולכן שתי
   * הפניות אינן צריכות לקרוא זו את זו — האילוץ מכריע, גם כששתיהן
   * מגיעות בו-זמנית.
   * NULL נשאר מותר וחוזר: ב-Postgres שורות עם NULL אינן מתנגשות
   * באילוץ ייחודיות, ולכן התראות שאין להן אירוע חיצוני (תזכורת
   * משימה, סיום תמלול) נכתבות כרגיל בלי לשאת מפתח מלאכותי.
   */
  dedupeKey  String?   @map("dedupe_key") @db.VarChar(120)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}

/**
 * מנוי לפוש בדפדפן — צמד (משתמש, דפדפן). אותו סוכן במחשב ובנייד
 * מייצר שתי שורות בכוונה: הוא רוצה את ההתראה בשניהם.
 */
model PushSubscription {
  id            String    @id @db.Char(26)
  tenantId      String    @map("tenant_id") @db.Char(26)
  userId        String    @map("user_id") @db.Char(26)
  /**
   * המפתח היציב שהדפדפן מנפיק — ייחודי גלובלית.
   */
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")
  /**
   * כישלונות רצופים; מתאפס בהצלחה. חציית התקרה מוחקת את המנוי.
   */
  failureCount  Int       @default(0) @map("failure_count")

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// דפוס Outbox — אירוע נכתב באותה טרנזקציה עם השינוי; Worker מפיץ (docs/02 §5).
model OutboxEvent {
  id          String    @id @db.Char(26)
  tenantId    String    @map("tenant_id") @db.Char(26)
  name        String    @db.VarChar(60)
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

// Append-only. הרשאות ה-DB של האפליקציה: INSERT+SELECT בלבד (ראו enable_rls.sql).
model AuditLog {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  userId     String?  @map("user_id") @db.Char(26)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Char(26)
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("audit_log")
}

/// הגדרות פלטפורמה (מפתחות ספקים) — מנוהלות ממסך /platform, מוצפנות.
/// מחוץ ל-RLS: רמת פלטפורמה, לא רמת דייר (כמו users/sessions).
/// הגדרת מסלול מנוי — מה כלול בו, כמה הוא עולה ומה המגבלות.
///
/// טבלה ברמת הפלטפורמה (כמו platform_settings): אין בה נתוני לקוחות,
/// והיא נקראת גם מתוך הקשר דייר כדי לדעת מה מותר למשרד. אין שורה
/// לקוד מסוים ⇒ ברירת המחדל שבקוד (packages/shared — plans.ts), כך
/// שמערכת שעלתה זה עתה עובדת לפני שנגעו במסך.
/// קוד קופון להצטרפות. מחוץ ל-RLS, כמו plans ו-platform_settings.
///
/// הוא נקרא בנתיב ההרשמה **הציבורי**, לפני שקיים דייר שאפשר לסנן
/// לפיו — טבלה תחת FORCE RLS הייתה מחזירה שם אפס שורות בשקט, וכל
/// קוד היה נראה כלא קיים. אין בה מידע על לקוחות קצה.
model Coupon {
  code           String    @id @db.VarChar(40)
  description    String    @default("") @db.VarChar(200)
  /// percent | free_days
  kind           String    @db.VarChar(20)
  percentOff     Int?      @map("percent_off")
  freeDays       Int?      @map("free_days")
  /// null = חל על כל המסלולים
  planCode       String?   @map("plan_code") @db.VarChar(20)
  /// null = בלי הגבלת כמות
  maxRedemptions Int?      @map("max_redemptions")
  redemptions    Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Char(26)

  @@index([isActive])
  @@map("coupons")
}

model Plan {
  code               String    @id @db.VarChar(20)
  name               String    @db.VarChar(60)
  description        String    @default("") @db.VarChar(500)
  monthlyPriceAgorot Int       @default(0) @map("monthly_price_agorot")
  /// null = נמכר חודשי בלבד
  yearlyPriceAgorot  Int?      @map("yearly_price_agorot")
  /// null = ללא הגבלה — ערך תקין ומכוון, לא "לא הוגדר"
  maxUsers           Int?      @map("max_users")
  maxProperties      Int?      @map("max_properties")
  /// מכסות פרסום ברשת השיתופים — נפרדות ממכסת השמירה במאגר.
  /// null = ללא הגבלה, וזה מה שכל המסלולים בתשלום מקבלים; המסלול
  /// החינמי מוגבל כאן ולא ב-`maxProperties`.
  /// מכסת האוטומציות — כללים שנבנו + משימות קבועות. null = ללא הגבלה.
  maxAutomations     Int?      @map("max_automations")
  /// מחיר חודשי לכל סוכן וואטסאפ נוסף, באגורות. null = לא נמכר
  /// במסלול הזה, והמסך אומר „פנו אלינו” במקום להציג כפתור קנייה.
  whatsappSeatMonthlyAgorot Int? @map("whatsapp_seat_monthly_agorot")
  maxNetworkListings Int?      @map("max_network_listings")
  maxNetworkDemands  Int?      @map("max_network_demands")
  features           String[]  @default([])
  trialDays          Int       @default(14) @map("trial_days")
  /// המחיר נסגר בשיחה ואינו מוצג כמספר.
  ///
  /// זה מה שמבדיל בין "חינם" ל"בהתאמה" — שני המצבים נראים זהה
  /// ב-`monthly_price_agorot = 0`, ובלי הדגל מסלול חינמי הוצג
  /// כ"בהתאמה", כלומר הבטיח ללקוח את ההפך ממה שהוא.
  priceOnRequest     Boolean   @default(false) @map("price_on_request")
  isPublic           Boolean   @default(true) @map("is_public")
  sortOrder          Int       @default(0) @map("sort_order")
  /// מסלול שנמחק. **דגל ולא מחיקת שורה**: קטלוג המסלולים ממזג
  /// ברירות מחדל מובנות עם השורות שנשמרו, ולכן מחיקת שורה של מסלול
  /// מובנה הייתה מחזירה אותו לחיים בהגדרות המקוריות שלו. שורה
  /// פרושה מוסתרת מהקטלוג; יצירה מחדש של אותו קוד מחזירה אותה.
  retiredAt          DateTime? @map("retired_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy          String?   @map("updated_by") @db.Char(26)

  @@index([sortOrder])
  @@map("plans")
}

/// מחוץ ל-RLS: רמת פלטפורמה, כמו plans ו-platform_settings.
///
/// ההחלטה הזו אינה נוחות. הוובהוק של קארדקום מגיע לנתיב **ציבורי**,
/// בלי Session ובלי הקשר דייר — טבלה תחת FORCE RLS הייתה מחזירה לו
/// אפס שורות בשקט, התשלום היה נרשם כאילו לא נמצא, והמנוי לא היה
/// מופעל. אין כאן מידע על לקוחות הקצה של המשרד, רק מזהה דייר, סכום
/// ומזהי עסקה; הסינון לפי דייר נאכף בשכבת האפליקציה, כמו ב-users.
model Subscription {
  id                   String    @id @db.Char(26)
  /// דייר אחד, מנוי אחד. מסלול נוסף הוא שינוי של השורה הזו.
  tenantId             String    @unique @map("tenant_id") @db.Char(26)
  planCode             String    @map("plan_code") @db.VarChar(20)
  /// monthly | yearly
  billingCycle         String    @default("monthly") @map("billing_cycle") @db.VarChar(10)
  /// trial | active | past_due | cancelled
  status               String    @default("trial") @db.VarChar(20)
  /// עד מתי שולם. null במצב ניסיון — שם התפוגה היא tenants.trial_ends_at.
  currentPeriodEnd     DateTime? @map("current_period_end")
  /// יום החיוב בחודש (1–31), כפי שנקבע בתשלום הראשון.
  ///
  /// בלעדיו מנוי שנפתח ב-31 בינואר היה נגמר ב-28 בפברואר ומשם ממשיך
  /// ב-28 לתמיד — הקיצור החד-פעמי של חודש קצר הופך לקבוע.
  billingAnchorDay     Int?      @map("billing_anchor_day") @db.SmallInt
  /// טוקן קארדקום לחיוב חוזר, מוצפן באותו מנגנון של platform_settings.
  /// null = אין כרטיס שמור, והחידוש יהיה ידני.
  cardTokenEncrypted   String?   @map("card_token_encrypted")
  /// ארבע ספרות — לתצוגה בלבד, כדי שהמשרד יזהה איזה כרטיס שמור.
  cardLast4            String?   @map("card_last4") @db.VarChar(4)
  /// תוקף הכרטיס. שני שדות ולא מחרוזת אחת: החיוב החוזר דורש MMYY
  /// מרופד באפסים, ופיצול מחרוזת בכל חיוב הוא מקום להיווצרות באג.
  cardMonth            Int?      @map("card_month") @db.SmallInt
  cardYear             Int?      @map("card_year") @db.SmallInt
  /// ת"ז של בעל הכרטיס, מוצפנת — קארדקום דורש אותה בחיוב בטוקן.
  cardOwnerIdEncrypted String?   @map("card_owner_id_encrypted")
  /// התקופה שעבורה כבר נשלחה תזכורת לפני חיוב.
  ///
  /// לא דגל בוליאני: הסורק רץ כל שעה, ו"נשלח" סתם היה שולח תזכורת
  /// בכל סבב עד החיוב. ההשוואה ל-currentPeriodEnd מאפסת את עצמה
  /// בכל חידוש.
  renewalReminderFor   DateTime? @map("renewal_reminder_for")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// תשלום יחיד. מחוץ ל-RLS מאותה סיבה בדיוק כמו subscriptions.
model Payment {
  id                  String    @id @db.Char(26)
  tenantId            String    @map("tenant_id") @db.Char(26)
  /// subscription | credits — **מה נקנה כאן.**
  ///
  /// טבלת תשלומים אחת ולא שתיים: זה המקום היחיד לראות את כל הכסף
  /// שנכנס, וגם מסלול הזיכוי והחשבוניות משותף. ההבחנה היא בשדה,
  /// והשדות שאינם רלוונטיים לסוג מסוים ריקים ולא מלאים בערך מדומה.
  purpose             String    @default("subscription") @db.VarChar(20)
  /// ריקים ברכישת קרדיטים — שם אין מסלול ואין מחזור חיוב.
  planCode            String?   @map("plan_code") @db.VarChar(20)
  billingCycle        String?   @map("billing_cycle") @db.VarChar(10)
  /// כמה קרדיטים נרכשו. ריק בתשלום מנוי.
  creditsPurchased    Int?      @map("credits_purchased")
  amountAgorot        Int       @map("amount_agorot")
  /// pending | paid | failed
  status              String    @default("pending") @db.VarChar(20)
  /// מזהה דף התשלום אצל קארדקום. **ייחודי, וזה מה שהופך את הוובהוק
  /// לאידמפוטנטי**: קארדקום שולח הודעה יותר מפעם אחת, ובלי המפתח הזה
  /// אותו תשלום היה מאריך את התקופה פעמיים.
  lowProfileId        String    @unique @map("low_profile_id") @db.VarChar(64)
  transactionId       String?   @map("transaction_id") @db.VarChar(40)
  /// מסמך שקארדקום הפיק, אם המסוף מוגדר להפקה. אצלנו הוא אינו מוגדר
  /// כך (החשבוניות מופקות במערכת אחרת), ולכן השדות נשארים ריקים.
  /// הם קיימים ליום שבו יוחלט להפיק חשבוניות שם — הזיכוי עצמו אינו
  /// זקוק להם, הוא עובד מול מזהה העסקה.
  documentType        String?   @map("document_type") @db.VarChar(40)
  documentNumber      Int?      @map("document_number")
  /// כמה זוכה בפועל. סכום ולא דגל: זיכוי חלקי (החזר יחסי על חודש
  /// שלא נוצל) הוא המקרה הנפוץ, ו"זוכה כן/לא" לא היה יודע לתארו.
  refundedAgorot      Int?      @map("refunded_agorot")
  refundedAt          DateTime? @map("refunded_at")
  refundTransactionId String?   @map("refund_transaction_id") @db.VarChar(40)
  refundReason        String?   @map("refund_reason") @db.VarChar(300)
  /// מה קארדקום אמר כשזה נכשל — לתמיכה, לא למשתמש
  failureReason       String?   @map("failure_reason") @db.VarChar(300)
  /// ההצעה שהתשלום הזה מממש. ריק בתשלום רגיל — ומלא, הוא מה שמפעיל
  /// בהצלחה גם את המחיר המוסכם ואת התכונות שההצעה הבטיחה.
  offerId             String?   @map("offer_id") @db.Char(26)
  /// ההשכרה שהתשלום הזה משלם — ריק בתשלום שאינו השכרת מספר. זה מה
  /// שמפעיל בהצלחה את תפיסת המספר אצל 015 ואת תקופת ההשכרה.
  rentalId            String?   @map("rental_id") @db.Char(26)
  /// שיעור המע"מ שלפיו נבנה **הסכום הזה**, באחוזים.
  ///
  /// המחירון נקוב נטו, והסכום שנגבה הוא נטו ועוד מע"מ. המסמך נבנה
  /// אחר כך מהברוטו שנגבה — ולכן הוא חייב לפרק אותו **באותו שיעור
  /// שבו הוא הורכב**. קריאה של השיעור העדכני בעת ההפקה נכונה כל עוד
  /// הוא לא השתנה בין השניים, ובדיוק ביום שהוא משתנה בחקיקה כל
  /// המסמכים הפתוחים יוצאים עם נטו שאינו המחיר שהובטח (ביקורת
  /// Codex): 100 ₪ נטו שנגבו כ-118 ומפורקים ב-19% נרשמים כ-99.16.
  ///
  /// ריק בשורות שנוצרו לפני השדה — שם ההפקה נופלת לשיעור הנוכחי,
  /// כלומר בדיוק ההתנהגות שהייתה להן ממילא.
  vatPercent          Int?      @map("vat_percent")
  paidAt              DateTime? @map("paid_at")
  createdBy           String?   @map("created_by") @db.Char(26)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  invoice Invoice?

  @@index([tenantId, createdAt])
  @@map("payments")
}

/// השכרת מספר וירטואלי מחשבון 015 של הפלטפורמה — מחוץ ל-RLS, כמו
/// payments ומאותה סיבה: ההפעלה מגיעה מהוובהוק של קארדקום, נתיב
/// ציבורי בלי הקשר דייר, וסורק החידושים עובר על כל המשרדים יחד.
/// אין כאן מידע על לקוחות קצה; הסינון לפי דייר נאכף בשכבת האפליקציה.
model RentedNumber {
  id                  String    @id @db.Char(26)
  tenantId            String    @map("tenant_id") @db.Char(26)
  /// הספרות כפי ש-015 מכיר אותן — זה המפתח מול הספק.
  number              String    @db.VarChar(20)
  /// המחיר החודשי שסוכם ברגע ההשכרה, באגורות. צילום ולא הפניה
  /// להגדרה: שינוי מחיר במסך הפלטפורמה חל על השכרות חדשות בלבד.
  monthlyAgorot       Int       @map("monthly_agorot")
  /// pending | active | past_due | cancelled | released
  status              String    @default("pending") @db.VarChar(20)
  /// יום החיוב בחודש — אותו עוגן ומאותה סיבה כמו במנוי: בלעדיו
  /// השכרה מ-31 בחודש הייתה מתקצרת לצמיתות אחרי פברואר.
  billingAnchorDay    Int?      @map("billing_anchor_day") @db.SmallInt
  /// עד מתי שולם. חלק מחודש מחויב כחודש מלא — אין חישוב יחסי.
  currentPeriodEnd    DateTime? @map("current_period_end")
  cancelledAt         DateTime? @map("cancelled_at")
  /// מתי המספר נתפס בפועל אצל 015. ריק אחרי תשלום = התפיסה נכשלה
  /// והטיפול עבר לידיים של מנהל הפלטפורמה (שקיבל מייל).
  providerPurchasedAt DateTime? @map("provider_purchased_at")
  providerReleasedAt  DateTime? @map("provider_released_at")
  /// השגיאה האחרונה מול הספק — לתמיכה, לא למשתמש.
  providerError       String?   @map("provider_error") @db.VarChar(300)
  createdBy           String?   @map("created_by") @db.Char(26)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  /// סורק החידושים והשחרורים עובר על הצירוף הזה
  @@index([status, currentPeriodEnd])
  /// בנוסף, במיגרציה בלבד (Prisma אינו יודע לבטא אינדקס חלקי):
  /// UNIQUE (number) WHERE status <> 'released' — שורה חיה אחת לכל
  /// מספר בכל המשרדים, כולל pending; הפרה נתפסת כ-P2002 בפתיחת השכרה.
  @@map("rented_numbers")
}

/// הצעת מנוי בלינק — מחוץ ל-RLS: רמת פלטפורמה, כמו plans ו-coupons.
///
/// שני שימושים, טבלה אחת: הצעה אישית שמנהל הפלטפורמה תפר למשרד
/// (מסלול + תוספות + מחיר סופי + תכונות), ולינק מכירה שפותח דף
/// תשלום על מסלול קיים לכל משרד מחובר. ההבחנה בשדה `kind`, והשדות
/// שאינם רלוונטיים ריקים — לא מלאים בערך מדומה.
model SubscriptionOffer {
  id             String    @id @db.Char(26)
  /// הסוד שבלינק. אקראי וארוך מכדי לנחש — הוא ההרשאה לראות את ההצעה.
  token          String    @unique @db.VarChar(64)
  /// custom | plan_link
  kind           String    @db.VarChar(20)
  /// ההצעה נעולה למשרד הזה; null = כל משרד מחובר (לינק מכירה).
  tenantId       String?   @map("tenant_id") @db.Char(26)
  planCode       String    @map("plan_code") @db.VarChar(20)
  /// monthly | yearly
  billingCycle   String    @default("monthly") @map("billing_cycle") @db.VarChar(10)
  /// המחיר הסופי למחזור, באגורות. null = מחיר המסלול (או המחיר
  /// המוסכם של המשרד, אם יש) — אותו סדר עדיפויות כמו בחידוש.
  priceAgorot    Int?      @map("price_agorot")
  /// שורות התוספת [{label, amountAgorot}] — "2 מספרי טלפון" וכד'.
  /// לתצוגה ולתיעוד; המחיר הסופי הוא שנגבה, לא סכימה מחדש.
  lineItems      Json      @default("[]") @map("line_items")
  /// תכונות שנפתחות למשרד עם התשלום, מעבר למסלול.
  featureGrants  String[]  @default([]) @map("feature_grants")
  /// הערה חופשית שמוצגת ללקוח בדף ההצעה.
  note           String    @default("") @db.VarChar(500)
  /// null = בלי הגבלת מימושים (לינק מכירה); הצעה אישית נוצרת עם 1.
  maxRedemptions Int?      @map("max_redemptions")
  redemptions    Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  /// ביטול ולא מחיקה — משרד ששילם דרך הלינק ממשיך לשאת את המזהה
  /// בתשלומים שלו, ובלי השורה אי אפשר לענות "מה הובטח לו".
  revokedAt      DateTime? @map("revoked_at")
  createdBy      String?   @map("created_by") @db.Char(26)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([createdAt])
  @@map("subscription_offers")
}

/// מחיר ליד לפי מקור. מחוץ ל-RLS: רמת פלטפורמה, כמו plans.
///
/// טבלה ולא קבוע בקוד, כי המחיר שמשלמים לספק שונה בין ספק לספק
/// ומשתנה בזמן — מחיר אחד לכולם היה מחייב שינוי קוד בכל משא ומתן.
/// אין שורה למקור ⇒ ברירת המחדל שבקוד (packages/shared —
/// collaboration-cost.ts), כך שמערכת שעלתה זה עתה עובדת.
model LeadSourcePrice {
  /// המזהה כפי שהוא נשמר על הביקוש (shared_demands.source)
  source      String   @id @db.VarChar(20)
  label       String   @db.VarChar(60)
  creditsCost Int      @default(1) @map("credits_cost")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Char(26)

  @@map("lead_source_prices")
}

/// כל פנייה שהגיעה לנתיב הוובהוק של המרכזייה — **כולל שנדחתה**.
///
/// בלי הטבלה הזו בקשה עם מפתח שאינו מוכר, מפתח מנוטרל או מסלול בלי
/// מרכזייה מקבלת 404 ואינה מותירה שום עקבה: מסך האבחון של המשרד
/// מציג "לא התקבל אף אירוע" בדיוק כמו מרכזייה שמעולם לא פנתה. שני
/// המצבים דורשים פעולה הפוכה — כתובת שגויה אצל הספק מול מפתח ישן
/// או מסלול חסר אצלנו — ובלי ההבחנה אין מאיפה להתחיל.
///
/// **בלי `tenantId` ובלי RLS במכוון.** פנייה שנדחתה היא בדיוק זו
/// שלא הצלחנו לשייך למשרד, וטבלה תחת RLS הייתה מסתירה בדיוק את
/// השורות שבגללן היא נבנתה. הצפייה שמורה לבעל הפלטפורמה.
model TelephonyWebhookHit {
  id         String   @id @db.Char(26)
  receivedAt DateTime @default(now()) @map("received_at")
  /// accepted | unparsed | unknown_key | disabled | no_feature
  ///
  /// `accepted` = הפנייה הגיעה **והפכה לאירוע שיחה**.
  /// `unparsed` = הגיעה, המפתח והמסלול תקינים, ולא היה בה די כדי
  /// לזהות שיחה. `issue` אומר מה חסר.
  outcome    String   @db.VarChar(20)
  /// למה לא נותח — `no_fields | no_call_id | no_phone | invalid_phone`.
  ///
  /// עמודה נפרדת מ-`outcome`: „לא נותחה” היא התוצאה, והסיבה היא מה
  /// שקובע לאן ללכת — כותרת Content-Type שגויה אצלנו, מול תבנית
  /// שמחסירה את מספר המתקשר אצל הספק.
  issue      String?  @db.VarChar(20)
  /// המשרד — רק כשהמפתח נפתר. `null` בדיוק במקרים המעניינים.
  tenantId   String?  @map("tenant_id") @db.Char(26)
  /// שש התווים הראשונים של המפתח בלבד.
  ///
  /// מספיק כדי להשוות למפתח שבמסך ההגדרות ולראות אם הספק מחזיק
  /// מפתח ישן — וקצר מכדי לשמש למישהו שקורא את הטבלה כדי לזייף
  /// אירועים. מפתח מלא ביומן הוא סוד שנשמר בטקסט גלוי.
  keyPrefix  String   @map("key_prefix") @db.VarChar(12)
  /// GET או POST — ספק ששולח בשיטה שלא ציפינו לה נראה מיד
  method     String   @db.VarChar(6)
  /// השדות שהגיעו — שמות תמיד, וערכים לשדות הטכניים בלבד
  /// (`diagnosticFields`). מספרי טלפון ושמות לקוחות לעולם לא.
  fieldKeys  String?  @map("field_keys") @db.VarChar(1000)
  /// השדות שהספק שלח **ואיננו צורכים** (`unmappedFields`).
  ///
  /// עמודה נפרדת ולא חלק מ-`fieldKeys`: זו השאלה המעניינת —
  /// איפה יושב מידע שאנחנו מפספסים — והמסך מדגיש אותה. מיזוגה
  /// לרשימה הכללית היה מטשטש בדיוק את מה שצריך לקפוץ לעין.
  unmapped   String?  @map("unmapped_fields") @db.VarChar(500)

  @@index([receivedAt])
  @@map("telephony_webhook_hits")
}

model PlatformSetting {
  key            String   @id @db.VarChar(60)
  valueEncrypted String   @map("value_encrypted")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by") @db.Char(26)

  @@map("platform_settings")
}

/// נוסחי ההסכמים של המשרד. אין שורה ⇒ נוסח ברירת המחדל שבקוד
/// (packages/shared — agreement-template.ts), כך שמשרד חדש עובד מיד.
model AgreementTemplate {
  id        String   @id @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  /// brokerage | exclusivity
  kind      String   @db.VarChar(20)
  body      String
  updatedBy String?  @map("updated_by") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@map("agreement_templates")
}

/// הסכם שנשלח ללקוח לחתימה. rendered_body הוא צילום הנוסח שהלקוח
/// ראה, ו-bodyHash מאפשר להוכיח שהטקסט לא שונה אחרי החתימה.
model Agreement {
  id              String    @id @db.Char(26)
  tenantId        String    @map("tenant_id") @db.Char(26)
  /// brokerage | exclusivity
  kind            String    @db.VarChar(20)
  /// null = הלקוח נמחק מהמערכת וההסכם **החתום** נשמר.
  ///
  /// מסמך חתום אינו נמחק בשום מקרה — הוא ראיה משפטית ובסיס הזכאות
  /// לדמי התיווך. לכן מחיקת לקוח מנתקת את ההסכם מהכרטיס במקום למחוק
  /// אותו; זהות החותם נשארת במסמך עצמו (signerName/signerIdNumber
  /// והנוסח החתום), כי בלעדיה המסמך חסר ערך.
  contactId       String?   @map("contact_id") @db.Char(26)
  propertyId      String?   @map("property_id") @db.Char(26)
  /// pending | viewed | signed | declined | expired
  /// expired נקבע כשקישור שפג מפנה את מקומו להסכם חדש — האינדקס
  /// הייחודי על הסכם פעיל לא יכול לבדוק תאריך בעצמו.
  status          String    @default("pending") @db.VarChar(20)
  renderedBody    String    @map("rendered_body")
  /// גיבוב הנוסח החתום. עד החתימה זהה ל-presentedHash; ברגע החתימה
  /// נכנס מספר הזהות לגוף המסמך והגיבוב מחושב מחדש.
  bodyHash        String    @map("body_hash") @db.Char(64)
  /// הגיבוב שהוצג ללקוח לפני החתימה — מוכיח מה הוצג, לצד מה שנחתם
  presentedHash   String?   @map("presented_hash") @db.Char(64)
  publicToken     String    @unique @map("public_token") @db.VarChar(64)
  tokenExpires    DateTime  @map("token_expires")
  signerName      String?   @map("signer_name") @db.VarChar(120)
  signerIdNumber  String?   @map("signer_id_number") @db.VarChar(20)
  /// חתימת היד כפי שצוירה, כתמונת PNG (data URL).
  ///
  /// תיבת סימון מוכיחה שמישהו לחץ; חתימה מצוירת היא מה שנראה כמו
  /// חתימה למי שקורא את המסמך אחר כך, וזה מה שמבקשים במסמך חתום.
  /// היא **אינה** מחליפה את הגיבוב — ההוכחה שהטקסט לא שונה נשארת
  /// bodyHash/presentedHash.
  signatureImage  String?   @map("signature_image")
  signedAt        DateTime? @map("signed_at")
  signedIp        String?   @map("signed_ip") @db.VarChar(45)
  signedUserAgent String?   @map("signed_user_agent") @db.VarChar(300)
  viewedAt        DateTime? @map("viewed_at")
  declinedAt      DateTime? @map("declined_at")
  /// מתי נשלח ללקוח בפעם האחרונה — לא זהה ל-createdAt: מזכירים שוב
  /// ושוב ללקוח שלא חתם
  sentAt          DateTime? @map("sent_at")
  createdBy       String?   @map("created_by") @db.Char(26)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, contactId, kind])
  @@map("agreements")
}

/// מסמך שנחתם על נייר ונסרק לתוך המערכת.
///
/// טבלה נפרדת מ-`Agreement` **כי אין לנו את הנוסח.** `renderedBody`
/// ו-`bodyHash` שם מוכיחים שהטקסט שהלקוח חתם עליו לא שונה; על
/// סריקה אי אפשר לטעון את זה, ו-`fileHash` כאן טוען רק שהבתים
/// שהועלו הם הבתים שנשמרו.
///
/// ‎**התוצאה המשפטית זהה**: `kind` של `brokerage`/`exclusivity` הוא
/// הצהרת המתווך על הסכם חתום, והוא פותח את שער ההצעות כמו חתימה
/// במערכת (`AgreementsService.hasSigned`). ההיגיון —
/// packages/shared — signed-documents.ts.
model SignedDocument {
  id         String    @id @db.Char(26)
  tenantId   String    @map("tenant_id") @db.Char(26)
  /// brokerage | exclusivity | other
  kind       String    @db.VarChar(20)
  /// null = הלקוח נמחק. מסמך חתום אינו נמחק — ראו `Agreement.contactId`
  contactId  String?   @map("contact_id") @db.Char(26)
  propertyId String?   @map("property_id") @db.Char(26)
  fileName   String    @map("file_name") @db.VarChar(200)
  mimeType   String    @map("mime_type") @db.VarChar(80)
  byteSize   Int       @map("byte_size")
  s3Key      String    @map("s3_key") @db.VarChar(300)
  /// SHA-256 של הקובץ כפי שהועלה
  fileHash   String    @map("file_hash") @db.Char(64)
  /// מתי נחתם על הנייר, כפי שהמתווך מסר
  signedOn   DateTime? @map("signed_on") @db.Date
  signerName String?   @map("signer_name") @db.VarChar(120)
  note       String?   @db.VarChar(500)
  uploadedBy String?   @map("uploaded_by") @db.Char(26)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId, propertyId])
  @@index([tenantId, contactId, kind])
  @@map("signed_documents")
}

/// תקופת בלעדיות על נכס — **מה שההסכם הבטיח, כמצב שאפשר לבדוק.**
///
/// עד כה התקופה חיה כטקסט חופשי בתוך גוף ההסכם החתום, ו-
/// `properties.exclusive_until` נכתב ולא נקרא. כאן היא ישות: יש לה
/// התחלה, סוף, מועד שליש (סעיף 9(ב2) לחוק המתווכים), ופעולות שיווק
/// שנתלות בה. ההיגיון עצמו — packages/shared — exclusivity.ts.
///
/// טבלה ולא עמודות: לנכס יש היסטוריה של בלעדיויות, ופעולת שיווק
/// משנה שעברה אינה מקיימת את הדרישה של התקופה הנוכחית.
model PropertyExclusivity {
  id                 String    @id @db.Char(26)
  tenantId           String    @map("tenant_id") @db.Char(26)
  propertyId         String    @map("property_id") @db.Char(26)
  /// ההסכם החתום שממנו נולדה. NULL = בלעדיות שנחתמה על נייר.
  agreementId        String?   @map("agreement_id") @db.Char(26)
  /// apartment | other — שתי המדרגות של סעיף 9, ולא סוג הנכס שלנו
  subject            String    @db.VarChar(10)
  startsAt           DateTime  @map("starts_at") @db.Date
  endsAt             DateTime  @map("ends_at") @db.Date
  /// האם סוכם על "פעולת שיווק אחרת" (פריט 7 בתקנות פעולות שיווק).
  agreedCustomAction Boolean   @default(false) @map("agreed_custom_action")
  /// מתי חדלה להיות התקופה הנוכחית. NULL = הפתוחה, ויש רק אחת כזו
  /// לכל נכס — אינדקס ייחודי חלקי אוכף זאת.
  endedAt            DateTime? @map("ended_at")
  /// expired | cancelled | sold | replaced
  endReason          String?   @map("end_reason") @db.VarChar(20)
  createdBy          String?   @map("created_by") @db.Char(26)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, endsAt])
  @@map("property_exclusivities")
}

/// פעולת שיווק שבוצעה בתקופת בלעדיות.
///
/// `sourceKey` הוא מפתח האירוע שיצר אותה בזיהוי אוטומטי — האינדקס
/// הייחודי החלקי עליו מונע כפילות כשאותו אירוע מעובד פעמיים. רישום
/// ידני אינו נושא מפתח: מתווך שתלה שני שלטים רשאי לרשום שניים.
model MarketingAction {
  id            String   @id @db.Char(26)
  tenantId      String   @map("tenant_id") @db.Char(26)
  exclusivityId String   @map("exclusivity_id") @db.Char(26)
  propertyId    String   @map("property_id") @db.Char(26)
  kind          String   @db.VarChar(30)
  /// auto | manual
  source        String   @db.VarChar(10)
  sourceKey     String?  @map("source_key") @db.VarChar(120)
  detail        String?  @db.VarChar(300)
  /// אסמכתה — צילום השלט, קישור למודעה. ראיה, לא קישוט.
  evidenceUrl   String?  @map("evidence_url") @db.VarChar(500)
  /// לשיתוף מתווכים בלבד. פחות מחמישה אינו נספר.
  brokerCount   Int?     @map("broker_count")
  performedAt   DateTime @map("performed_at")
  createdBy     String?  @map("created_by") @db.Char(26)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([exclusivityId, performedAt])
  @@map("marketing_actions")
}

/// יומן שיחות. כרגע מתועד ידנית; שיחות מספק טלפוניה ייכנסו לאותה
/// טבלה עם source="provider" כשייכנס חיבור כזה.
model Call {
  id                         String    @id @db.Char(26)
  tenantId                   String    @map("tenant_id") @db.Char(26)
  /// inbound | outbound
  direction                  String    @db.VarChar(10)
  /// manual | provider | meeting
  ///
  /// `meeting` = הקלטה של פגישה מהיומן. הטבלה הזו היא בפועל "שיחה
  /// מוקלטת עם סיכום", וצינור התמלול שלה כבר עובד; מסלול מקביל
  /// לפגישות היה משכפל אחסון, תמלול, סיכום וסטטוס.
  source                     String    @default("manual") @db.VarChar(20)
  /// מזהה השיחה אצל ספק המרכזייה — מפתח אידמפוטנטיות מול שליחות חוזרות
  providerCallId             String?   @map("provider_call_id") @db.VarChar(80)
  contactId                  String?   @map("contact_id") @db.Char(26)
  leadId                     String?   @map("lead_id") @db.Char(26)
  /// הפגישה שההקלטה הזו מתעדת, כשהמקור הוא `meeting`.
  appointmentId              String?   @map("appointment_id") @db.Char(26)
  /// הנכס שהשיחה נוגעת לו — **צילום ברגע השיחה, לא הפניה חיה.**
  ///
  /// עמודה משלה ולא שליפה דרך `leads.property_id`, וזו אינה כפילות:
  /// שיוך הליד לנכס **משתנה בדיעבד**. ליד כללי שנפתח בלי נכס מקבל
  /// אותו מאוחר יותר, כשאותו אדם ממלא טופס של נכס מסוים
  /// (`WebLeadService.upsertLead` ממלא `propertyId` ריק). מרגע זה כל
  /// השיחות הישנות של אותו ליד היו נספרות כפעילות בנכס החדש — עד
  /// לתוך דוח שנמסר לבעל הנכס, שמראה לו פעילות שלא נעשתה עבורו
  /// (ביקורת Codex, P1).
  ///
  /// NULL = לא ידוע, והדוח אינו טוען דבר. שורות שנוצרו לפני העמודה
  /// נשארות NULL בכוונה: ניחוש בדיעבד הוא בדיוק מה שהעמודה מונעת.
  ///
  /// **גבול הצילום, במדויק:** בשיחה ממרכזייה הוא נלקח כשנכתבת שורת
  /// השיחה — באירוע המסיים — ולא כשהשיחה החלה. מספר וירטואלי
  /// שהועבר לנכס אחר בין תחילת השיחה לסיומה, או לפני `Hangup`
  /// שנשלח שוב באיחור, ייתן צילום מהתצורה החדשה. סגירה מלאה דורשת
  /// לשמור את הניתוב שנצפה באירוע הראשון, וזו תוספת תכן ולא תיקון
  /// (ביקורת Codex; רשום כמשימה נפרדת). מה שנאמר כאן הוא מה שהעמודה
  /// באמת מבטיחה — לא יותר.
  propertyId                 String?   @map("property_id") @db.Char(26)
  phoneEncrypted             String?   @map("phone_encrypted")
  phoneHash                  String?   @map("phone_hash") @db.Char(64)
  /// המספר שאליו הלקוח התקשר — **הצד שלנו**, ולכן אינו מוצפן.
  ///
  /// זה מספר המשרד ולא של הלקוח: אין בו פרט מזהה של אדם, והוא
  /// חייב להישאר קריא כדי שאפשר יהיה לקבץ לפיו ולמדוד קמפיינים.
  /// הצפנתו הייתה הופכת את דוח "כמה שיחות מכל מספר" לבלתי אפשרי.
  dialedNumber               String?   @map("dialed_number") @db.VarChar(20)
  /// שם המספר הווירטואלי **כפי שהיה ברגע השיחה** — צילום, לא הפניה.
  ///
  /// ההגדרה יכולה להימחק או להשתנות, וההיסטוריה לא אמורה להשתנות
  /// איתה: "התקשר אל קמפיין פייסבוק ינואר" הוא מה שקרה, גם אם
  /// הקמפיין נמחק מאז. הפניה חיה הייתה הופכת שיחות ישנות ל"מספר
  /// לא מוגדר" ומאבדת בדיוק את המידע שבשבילו התכונה קיימת.
  dialedLabel                String?   @map("dialed_label") @db.VarChar(60)
  occurredAt                 DateTime  @map("occurred_at")
  durationMinutes            Int?      @map("duration_minutes")
  /// answered | missed | no_answer | voicemail
  outcome                    String    @default("answered") @db.VarChar(20)
  summary                    String?   @db.VarChar(4000)
  /**
   * מפתח ההקלטה ב-S3; ההקלטה עצמה לא יושבת בטבלה שנשלפת בכל רשימה.
   */
  recordingKey               String?   @map("recording_key") @db.VarChar(300)
  /// נתיב ההקלטה **אצל ספק המרכזייה** — לא מפתח באחסון שלנו.
  ///
  /// עמודה נפרדת מ-`recordingKey` בכוונה. מסלולי מחיקת המידע (מחיקת
  /// לקוח, מחיקת חשבון) סורקים את `recordingKey` ומוחקים את
  /// האובייקטים מה-S3; נתיב של ספק חיצוני שם היה גורם למחיקה
  /// „להצליח” על אובייקט שאינו קיים — כלומר המערכת מדווחת שההקלטה
  /// נמחקה בזמן שהאודיו עדיין יושב אצל הספק.
  ///
  /// הוא ה**קלט** של סבב המשיכה: `RecordingFetchService` מושך את
  /// האודיו מ-015, שומר אותו אצלנו וכותב `recordingKey`. התנאי
  /// „יש נתיב ואין מפתח” הוא מה שמסמן שיחה שממתינה למשיכה, ולכן
  /// הוא נשאר גם אחריה — שתי העמודות מתארות שני מקומות שונים.
  providerRecordingPath      String?   @map("provider_recording_path") @db.VarChar(300)
  /// מתי נוסתה המשיכה בפעם האחרונה — על **כל** ניסיון, גם כושל.
  ///
  /// זה מה שהופך את הסבב להוגן. בלי החותמת כישלון אינו משנה דבר
  /// בשורה, ולכן שיחה עם נתיב פגום או אישורים שפגו נבחרת שוב ושוב
  /// ותופסת את מכסת הסבב — עד שתזדקן שבוע, ובינתיים שאר ההקלטות
  /// של אותו משרד אינן נמשכות כלל (ביקורת Codex).
  providerRecordingAttemptAt DateTime? @map("provider_recording_attempt_at")
  /// למה המשיכה האחרונה נכשלה — **קוד קצר, לא הודעה ולא גוף תשובה.**
  ///
  /// בלי העמודה הזו כישלון משיכה הוא שקט מוחלט: המסך מציג „לא
  /// צורפה הקלטה” בדיוק כמו שיחה שמעולם לא הייתה לה הקלטה, והמתווך
  /// אינו יכול לדעת אם הבעיה אצלו, אצל הספק, או שההקלטה פשוט טרם
  /// נמשכה. שלושה מצבים שנראים זהים.
  ///
  /// קוד ולא טקסט חופשי, כי הערך הזה מגיע למסך ולתמיכה: הודעת
  /// שגיאה של הספק עלולה לשאת נתיבים או מזהים, וכתובת ה-URL של
  /// המשיכה נושאת שם משתמש וסיסמה. הקוד נבחר מרשימה סגורה.
  providerRecordingError     String?   @map("provider_recording_error") @db.VarChar(60)
  /**
   * מה בעצם ענתה המרכזייה — **בצורה שנבנתה מצונזרת.**
   * הקוד לבדו לא הספיק: `response_unreadable` מכסה גם מעטפת שגיאה
   * של הספק וגם שם מפתח שאיננו מכירים, ושני אלה דורשים תיקון הפוך
   * (דיווח מהשטח). הפירוט כאן הוא שמות מפתחות, ערכים של שדות
   * טכניים בלבד, בלי כתובות ובלי הסודות — ראו `describeProviderResponse`.
   */
  providerRecordingDetail    String?   @map("provider_recording_detail") @db.VarChar(200)
  transcript                 String?
  /// budget | rooms | city | callback — מה שחולץ מהתמלול, כפי שחולץ.
  highlights                 Json      @default("{}")
  transcribedAt              DateTime? @map("transcribed_at")
  /**
   * pending | running | done | failed | unavailable
   */
  transcriptionStatus        String?   @map("transcription_status") @db.VarChar(20)
  createdBy                  String?   @map("created_by") @db.Char(26)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, propertyId, occurredAt(sort: Desc)])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
  @@index([tenantId, appointmentId])
  /// דוח "כמה שיחות מכל מספר וירטואלי" רץ על הצירוף הזה
  @@index([tenantId, dialedNumber])
  @@map("calls")
}

/// מספר וירטואלי — מספר נפרד לכל פרסום, סוכן או נכס.
///
/// שיחה נכנסת אומרת **מי** התקשר; היא אינה אומרת **מה גרם לו**.
/// משרד שמפרסם בארבעה ערוצים אינו יודע איזה מהם עובד ומשלם על
/// כולם. המספר שאליו התקשרו הוא בעצמו הנתון.
///
/// שלושה שימושים ומנגנון אחד: מדידת קמפיין, ניתוב לסוכן, וזיהוי
/// הנכס שהמספר מפרסם. שלושתם "מספר, ומה לעשות כשמתקשרים אליו",
/// ולכן טבלה אחת — משרד שרוצה גם וגם ממלא שני שדות באותה שורה.
model VirtualNumber {
  id               String   @id @db.Char(26)
  tenantId         String   @map("tenant_id") @db.Char(26)
  /// מנורמל בכתיבה (‎+9723…‎) כדי שההשוואה מול המרכזייה תמיד תתפוס
  phone            String   @db.VarChar(20)
  /// שם לאדם: "קמפיין פייסבוק ינואר", "שלט ברבי עקיבא 12"
  label            String   @db.VarChar(60)
  /// מקור הליד שייכתב על כל ליד מהמספר. ריק ⇒ התווית משמשת כמקור.
  leadSource       String   @default("") @map("lead_source") @db.VarChar(20)
  /// הסוכן שיקבל את הליד. null ⇒ לערימה המשותפת.
  assignedToUserId String?  @map("assigned_to_user_id") @db.Char(26)
  /// הנכס שהמספר מפרסם. null ⇒ לא ידוע.
  propertyId       String?  @map("property_id") @db.Char(26)
  /// כיבוי ולא מחיקה: קמפיין שהסתיים מפסיק לנתב, וההיסטוריה
  /// שלפיה מודדים אותו בדיעבד נשארת.
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String?  @map("created_by") @db.Char(26)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// אותו מספר פעמיים באותו משרד הוא ניתוב דו-משמעי
  @@unique([tenantId, phone])
  @@map("virtual_numbers")
}

/**
 * הניתוב שנצפה כשהשיחה **הגיעה** — לא כשהיא הסתיימה.
 * 015 שולחת שלושה אירועים לשיחה אחת, ורק האחרון כותב שורת שיחה.
 * עד כה המספר הווירטואלי נפתר באירוע האחרון בלבד, ולכן הגדרה
 * שהשתנתה באמצע השיחה — או לפני `Hangup` שנשלח שוב באיחור — קבעה
 * למפרע לאיזה נכס השיחה שייכת. דוח שיוצא לבעל נכס אינו יכול
 * להישען על תצורה שאולי כבר לא זו שהלקוח חייג אליה.
 * השורה נכתבת פעם אחת, באירוע הראשון, ונמחקת ברגע ששורת השיחה
 * נכתבה מתוכה. כלומר הטבלה מחזיקה שיחות **באוויר** בלבד. שיחה
 * שה-`Hangup` שלה לא הגיע מעולם משאירה שורה יתומה, ולכן יש ניקוי
 * לפי גיל — ראו `ROUTING_RETENTION_MS`.
 * קיום השורה הוא עצמו הנתון: `virtualNumberId = NULL` פירושו
 * „נצפה, ולא התאים אף מספר”, ולא „לא נצפה”. בלי ההבחנה הזו מספר
 * שהוגדר **אחרי** תחילת השיחה היה נתפס בסוף שלה.
 */
model CallRouting {
  tenantId         String   @map("tenant_id") @db.Char(26)
  providerCallId   String   @map("provider_call_id") @db.VarChar(80)
  /// ההגדרה שהותאמה, או NULL כשנצפה שאין התאמה
  virtualNumberId  String?  @map("virtual_number_id") @db.Char(26)
  /// שדות ההגדרה כצילום — היא יכולה להשתנות או להימחק בזמן השיחה
  label            String   @default("") @db.VarChar(60)
  leadSource       String   @default("") @map("lead_source") @db.VarChar(20)
  assignedToUserId String?  @map("assigned_to_user_id") @db.Char(26)
  propertyId       String?  @map("property_id") @db.Char(26)
  /// האם הניתוב כבר נפתר. `virtual_number_id IS NULL` לבדו אינו מבחין
  /// בין „נצפה מספר ולא התאים” לבין „השורה נוצרה רק כדי לזכור מענה”,
  /// ובלי ההבחנה הזו אירוע `Answer` היה מוחק את הניתוב של כל שיחה.
  routeResolved    Boolean  @default(false) @map("route_resolved")
  /// האם נצפה אירוע מענה (`Answer`) לשיחה הזו — ראיית מענה שאינה
  /// תלויה ב-`talktime` שיגיע (או לא יגיע) ב-`Hangup`.
  answerObserved   Boolean  @default(false) @map("answer_observed")
  createdAt        DateTime @default(now()) @map("created_at")

  @@id([tenantId, providerCallId])
  /// לניקוי היתומות לפי גיל
  @@index([tenantId, createdAt])
  @@map("call_routings")
}

/**
 * חיבור יומן Google של משתמש.
 * למשתמש ולא למשרד: ליומן יש בעלים אחד, וחיבור ברמת המשרד היה מחייב
 * חשבון Google משותף — מה שאף משרד לא עושה.
 */
model GoogleCalendarLink {
  id                    String    @id @db.Char(26)
  tenantId              String    @map("tenant_id") @db.Char(26)
  userId                String    @unique @map("user_id") @db.Char(26)
  googleEmail           String    @map("google_email") @db.VarChar(254)
  calendarId            String    @default("primary") @map("calendar_id") @db.VarChar(200)
  /// refresh token ארוך-טווח, מוצפן. לעולם אינו מוחזר ללקוח — מי
  /// שמחזיק בו קורא וכותב ביומן הפרטי של הסוכן.
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  /// טוקן הסנכרון המצטבר של Google — הבקשה הבאה מקבלת רק מה שהשתנה.
  syncToken             String?   @map("sync_token")
  lastSyncAt            DateTime? @map("last_sync_at")
  /// מה קרה בסבב האחרון. מוצג למשתמש: חיבור שנשבר בשקט הוא חיבור
  /// שסומכים עליו ואינו עובד.
  lastError             String?   @map("last_error") @db.VarChar(300)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("google_calendar_links")
}

/**
 * פנייה לתמיכה — מהכפתור שבכל מסך או מהלשונית בניהול המשרד.
 * נשמרת ולא נשלחת במייל בלבד: משרד שפנה רוצה לראות מה עלה בגורל
 * הפנייה, והתמיכה רוצה היסטוריה לפי משרד. המייל הוא התראה על שורה
 * שכבר קיימת, לא הערוץ עצמו.
 * צילום המסך יושב ב-S3 ולא בטבלה: הוא נשלף רק כשפותחים פנייה
 * מסוימת, ובלעדיו כל רשימת פניות הייתה גוררת מגה-בייטים.
 */
model SupportTicket {
  id            String    @id @db.Char(26)
  /// אותו רצף בדיוק כמו `SupportThread.reference` — ראו שם.
  reference     Int       @unique @default(dbgenerated("nextval('support_reference_seq')"))
  tenantId      String    @map("tenant_id") @db.Char(26)
  /**
   * מי פנה. נשמר גם אחרי שהמשתמש הוסר — התמיכה צריכה לדעת עם מי דיברה.
   */
  userId        String    @map("user_id") @db.Char(26)
  userName      String    @map("user_name") @db.VarChar(120)
  userEmail     String    @map("user_email") @db.VarChar(254)
  /// bug | idea | question | billing
  kind          String    @db.VarChar(20)
  message       String    @db.VarChar(2000)
  /// open | in_progress | closed
  status        String    @default("open") @db.VarChar(20)
  /**
   * מיון אוטומטי — נגזר מההקשר ברגע הפתיחה, ראו logic/support.ts
   */
  area          String    @db.VarChar(40)
  /// blocking | error | normal
  severity      String    @db.VarChar(10)
  /**
   * ההקשר הטכני המנוקה: מסך, שגיאות, בקשות שנכשלו, מסלול הניווט.
   */
  context       Json      @default("{}")
  screenshotKey String?   @map("screenshot_key") @db.VarChar(300)
  /**
   * תשובת התמיכה — גלויה למשרד, זו הסיבה שהפנייה נשמרת ולא רק נשלחת.
   */
  reply         String?   @db.VarChar(2000)
  repliedAt     DateTime? @map("replied_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_tickets")
}

/// אוטומציה שהמשרד בנה בעצמו: טריגר, תנאים, פעולה.
///
/// שמונה האוטומציות המובנות הן קוד ייעודי וההגדרה שלהן ב-`settings`.
/// המודל הזה עונה על השאלה השנייה — מה **המשרד הזה** צריך, שאיש לא
/// כתב עבורו קוד. `conditions` ו-`action` הם JSON משום שהמבנה שלהם
/// משתנה לפי הטריגר ולפי סוג הפעולה; האימות ב-Zod לפני הכתיבה.
model AutomationRule {
  id         String   @id @db.Char(26)
  tenantId   String   @map("tenant_id") @db.Char(26)
  name       String   @db.VarChar(120)
  enabled    Boolean  @default(true)
  /// שם האירוע ב-outbox. אינו FK — האירועים חיים בקוד ולא בטבלה.
  trigger    String   @db.VarChar(60)
  conditions Json     @default("[]")
  action     Json
  createdBy  String?  @map("created_by") @db.Char(26)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, trigger])
  @@map("automation_rules")
}

/// ספר הריצות של האוטומציות המותאמות — מונע ריצה כפולה.
///
/// `jobId` ב-BullMQ מונע הכנסה כפולה לתור אך לא עיבוד כפול: Job
/// שנתקע נמסר שוב. השורה נכתבת לפני הפעולה ובאותה טרנזקציה, וכך
/// התנגשות על המפתח הראשי היא "כבר רץ" והריצה מדולגת.
model AutomationRun {
  ruleId    String   @map("rule_id") @db.Char(26)
  /// מזהה האירוע ב-outbox. אינו FK — אירועים ישנים נמחקים בתחזוקה.
  eventId   String   @map("event_id") @db.Char(26)
  tenantId  String   @map("tenant_id") @db.Char(26)
  createdAt DateTime @default(now()) @map("created_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, eventId])
  @@index([createdAt])
  @@map("automation_runs")
}
