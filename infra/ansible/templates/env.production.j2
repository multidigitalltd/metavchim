{#
  קובץ הסביבה של הייצור — נוצר מכאן, לא נערך בשרת.
  עריכה ידנית ב-`/srv/metavchim/.env.production` תידרס בהרצה הבאה,
  וזו הנקודה: מה שאינו כאן אינו חלק מהתצורה.

  מפתח חדש ב-`.env.production.example` חייב להופיע גם כאן —
  `scripts/verify-iac.mjs` מפיל את הבנייה אחרת.
#}
NODE_ENV=production

COMPOSE_PROFILES={{ compose_profiles }}

DOMAIN={{ domain }}

# ===== API =====
API_PORT=3001
WEB_ORIGIN=https://{{ domain }}
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

{#
  `urlencode` על הסיסמאות — **לא קישוט.**
  ה-README מנחה לייצר אותן ב-`openssl rand -base64 32`, שמפיק `/`
  ו-`+` בשכיחות גבוהה. סיסמה עם `/` בתוך כתובת חיבור נקראת כתחילת
  הנתיב, ו-Prisma דוחה את הכתובת — כלומר התקנה ראשונה שנראתה
  תקינה נופלת על "invalid connection string" (ביקורת Codex).
#}
DATABASE_URL=postgresql://metavchim_app:{{ app_db_password | urlencode }}@postgres:5432/metavchim?schema=public
DIRECT_DATABASE_URL=postgresql://metavchim:{{ db_owner_password | urlencode }}@postgres:5432/metavchim?schema=public
REDIS_URL=redis://redis:6379

# ===== Object Storage (MinIO פנימי) =====
S3_ENDPOINT=http://minio:9000
S3_BUCKET=metavchim
S3_ACCESS_KEY=metavchim
S3_SECRET_KEY={{ s3_secret_key }}

DB_OWNER_PASSWORD={{ db_owner_password }}
APP_DB_PASSWORD={{ app_db_password }}
DATA_ENCRYPTION_KEY={{ data_encryption_key }}
PHONE_HASH_KEY={{ phone_hash_key }}
UPDATE_SECRET={{ update_secret }}

{#
  איזו תמונה נפרסת. בלי שתי השורות האלה `docker-compose.prod.yml`
  נופל לברירות המחדל שלו — כלומר מי שביקש לקבע גרסה ל-SHA קיבל
  בכל זאת `latest`, וקיבע compose ומיגרציות מול קוד אחר לגמרי.
#}
IMAGE_PREFIX={{ image_prefix }}
IMAGE_TAG={{ image_tag }}

# נתיב הריפו על המארח — סוכן העדכון מריץ compose מולו
REPO_DIR={{ app_dir }}

# ===== ניהול הפלטפורמה =====
# מי רשאי להיכנס ל-/platform. ריק = המסך כבוי לחלוטין, ולכן שרת
# טרי אינו ניתן לניהול עד שממלאים כאן — ראו group_vars.
PLATFORM_ADMIN_EMAILS={{ platform_admin_emails | default("") }}
{% if "stt" in compose_profiles %}

# ===== תמלול מקומי =====
STT_URL=http://stt:9000
STT_SECRET={{ stt_secret }}
{% endif %}
{% if "diarize" in compose_profiles %}

# ===== זיהוי דוברים =====
DIARIZE_URL=http://diarize:9001
HF_TOKEN={{ hf_token }}
{% endif %}
{% if "offsite" in compose_profiles %}

# ===== גיבוי מחוץ לשרת =====
OFFSITE_S3_ENDPOINT={{ offsite_s3_endpoint }}
OFFSITE_S3_BUCKET={{ offsite_s3_bucket }}
OFFSITE_S3_ACCESS_KEY={{ offsite_s3_access_key }}
OFFSITE_S3_SECRET_KEY={{ offsite_s3_secret_key }}
{% endif %}
